---
import BaseLayout from '../layouts/BaseLayout.astro';
import { imageAsset } from '../data/imageAssets';
import { jobs } from '../data/jobs';
import { companies } from '../data/companies';

// The company registry is the source of truth for names and brand colours.
const divisions = [{ name: 'WeAB', accent: '#00BCD4' }, ...companies.map(({ name, accent }) => ({ name, accent }))];
const colorByDivision = Object.fromEntries(divisions.map(({ name, accent }) => [name, accent]));
---
<BaseLayout title="Karriär hos WeAB | Din framtid är vår tillgång" description="Platsannonser hos WeAB. Din framtid är vår tillgång.">
  <section class="careers-hero" style={`--careers-hero-image: url('${imageAsset('/images/section-1-overview-dusk.webp').src}')`}>
    <div class="shell careers-intro">
      <h1>Din framtid.<br/><em>Vår tillgång.</em></h1>
      <p class="lead">WeAB söker personal till produktion, lager, transporter, handel och förvaltning. Här finns tjänstebeskrivningar och villkor. Ansökningar tas inte emot på webbplatsen.</p>
      <a class="btn" href="#lediga-tjanster">Se platsannonserna <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><h2>Arbetsvillkor i koncernen</h2></div>
      </div>
      <div class="benefits">
        <article><h3>Arbetsuppgifter</h3><p>Tjänsterna omfattar bland annat farmdrift, varusortering och villagertransporter. Uppgifterna finns specificerade i varje annons.</p></article>
        <article><h3>Placering</h3><p>Arbetsplatsen anges per tjänst. Vissa roller är knutna till Sektion 1; andra kräver arbete vid koncernens vägar eller fastigheter.</p></article>
        <article><h3>Ersättning</h3><p>Villkor och personalförmåner anges i annonserna. Koncernen förbehåller sig rätten att ompröva förmåner när personalbehovet förändras.</p></article>
      </div>
    </div>
  </section>

  <section class="section careers-culture"><div class="shell split-layout">
    <div><h2>Arbete över bolagsgränserna</h2><p class="lead">En anställd kan komma att arbeta i flera av koncernens verksamheter. Det gäller framför allt när varor, invånare eller beslut måste flyttas mellan anläggningar.</p><p>Schemaläggning och bemanning samordnas efter verksamheternas behov. Frågor om individuell tillgänglighet behandlas i efterhand.</p><a class="link-arrow" href="/bolagsstyrning/">Vår uppförandekod och styrning ↗</a></div>
    <div class="culture-quote"><blockquote>Hos oss är nästa karriärsteg aldrig långt bort. Framför allt eftersom vi ansvarar för nästan alla arbetsplatser i närheten.</blockquote><small>PERSONALAVDELNINGENS ARBETSGIVARLÖFTE</small></div>
  </div></section>
  <section class="section section--dark" id="lediga-tjanster">
    <div class="shell">
      <div class="section-heading vacancies-heading">
        <div><h2>Du. På pappret.</h2></div>
      </div>
      <p class="jobs-disclaimer">Ansökningar tas inte emot via webbplatsen.</p>
      <div class="job-tools" role="search" aria-label="Filtrera platsannonser" hidden data-js-control>
        <label class="job-field" for="job-search"><span>SÖK TJÄNST</span><input id="job-search" type="search" placeholder="Titel, kompetens eller ort" autocomplete="off" /></label>
        <label class="job-field" for="job-division"><span>AFFÄRSOMRÅDE</span><select id="job-division"><option value="all">Alla verksamheter</option>{divisions.map(division => <option value={division.name}>{division.name}</option>)}</select></label>
        <output id="job-count" class="job-count" aria-live="polite">{jobs.length} annonser</output>
      </div>
      <div class="job-list" id="job-list">
        {jobs.map(job => (
          <details class="job" data-division={job.division} data-search={[job.title, job.division, job.location, job.pitch, ...job.responsibilities, ...job.requirements].join(' ').toLocaleLowerCase('sv')} style={'--division-color:' + (colorByDivision[job.division] ?? '#00BCD4')}>
            <summary>
              <span class="job-main"><span class="job-title">{job.title}</span><span class="job-division">{job.division} <span aria-hidden="true">/</span> {job.id}</span><span class="job-pitch">{job.pitch}</span></span>
              <span class="job-side"><span>{job.location}</span><span>{job.type}</span><strong>Visa tjänst <span class="toggle-mark" aria-hidden="true"></span></strong></span>
            </summary>
            <div class="job-detail">
              <div><h3>Din arbetsdag</h3><ul>{job.responsibilities.map(item => <li>{item}</li>)}</ul></div>
              <div><h3>Våra anspråkslösa krav</h3><ul>{job.requirements.map(item => <li>{item}</li>)}</ul></div>
              <div class="job-terms"><div><span>ERSÄTTNING</span><p>{job.compensation}</p></div><div><span>PERSONALFÖRMÅN</span><p>{job.perk}</p></div><a class="btn btn-sm" href="#rekrytering">Se rekryteringsprocessen <span aria-hidden="true">↓</span></a></div>
            </div>
          </details>
        ))}
      </div>
      <p class="no-results" id="jobs-empty" hidden>Inga tjänster matchar. HR avråder från att dra egna slutsatser.</p>
    </div>
  </section>

  <section class="section" id="rekrytering">
    <div class="shell recruitment">
      <div><h2>Tre enkla steg.<br/>Ett livslångt åtagande.</h2><p>Vi har effektiviserat rekryteringen så att du kan fokusera mindre på val och mer på resultat.</p></div>
      <ol class="recruitment-steps">
        <li><span>01</span><div><h3>Visa intresse</h3><p>Hitta en koncernrepresentant i Huvudstaden. Ange önskad tjänst och antalet diamanter du redan kontrollerar.</p></div></li>
        <li><span>02</span><div><h3>Bli granskad</h3><p>Vi kontrollerar din erfarenhet, lojalitet och eventuella kopplingar till fri konkurrens.</p></div></li>
        <li><span>03</span><div><h3>Bli en del av något större</h3><p>Grattis. Du är nu en tillgång. Uppsägning prövas vid nästa styrelsesammanträde.</p></div></li>
      </ol>
    </div>
  </section>
  <section class="careers-closing"><div class="shell"><h2>Vi ser fram emot<br/>att äga din potential.</h2><a class="btn btn-outline" href="/kontakt/">Koncernens kontaktpolicy <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#job-search');
  const division = document.querySelector<HTMLSelectElement>('#job-division');
  const count = document.querySelector<HTMLOutputElement>('#job-count');
  const empty = document.querySelector<HTMLElement>('#jobs-empty');
  const listings = [...document.querySelectorAll<HTMLElement>('.job')];

  function filterJobs() {
    const query = (search?.value ?? '').trim().toLocaleLowerCase('sv');
    const currentDivision = division?.value ?? 'all';
    let visible = 0;
    for (const listing of listings) {
      const matches = (currentDivision === 'all' || listing.dataset.division === currentDivision)
        && (listing.dataset.search ?? '').includes(query);
      listing.hidden = !matches;
      if (matches) visible++;
    }
    if (count) count.textContent = visible + ' ' + (visible === 1 ? 'annons' : 'annonser');
    if (empty) empty.hidden = visible !== 0;
  }

  document.querySelectorAll<HTMLElement>('[data-js-control]').forEach(control => { control.hidden = false; });
  search?.addEventListener('input', filterJobs);
  division?.addEventListener('change', filterJobs);
</script>
<style>
  .careers-culture{background:#101d26}.culture-quote{padding:2.5rem;background:#1c3440;border-top:2px solid #67cce0}.culture-quote blockquote{font-size:clamp(1.4rem,2.5vw,2.1rem);line-height:1.35;letter-spacing:-.03em;font-weight:700;margin:1.2rem 0}.culture-quote small{font-size:.68rem;color:#aec5d0;letter-spacing:.1em}
  .careers-hero{min-height:620px;display:flex;align-items:center;background:linear-gradient(90deg,#08141bf5 0%,#08141bd9 42%,#08141b59 100%),var(--careers-hero-image) center/cover;border-bottom:1px solid #2b3e48}
  .careers-intro{padding:6.5rem 0}.careers-hero h1{margin:0;max-width:980px}.careers-hero h1 em{font-style:normal;color:#70dbeb}.careers-hero p{max-width:650px;margin:1.6rem 0 2rem}
  .benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.benefits article{border:1px solid #334851;padding:1.6rem;background:#182832}.benefits article>span,.job-field>span,.job-terms span{font-size:.62rem;font-weight:800;letter-spacing:.15em;color:#89a8b6}.benefits h3{margin:1.1rem 0 .65rem}.benefits p{font-size:.86rem;margin:0}
  .jobs-disclaimer{margin:0 0 1.5rem;color:#aebfc8;font-size:.8rem}.vacancies-heading{align-items:end}.job-tools{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.6fr) auto;align-items:end;gap:1rem;padding:1.4rem;background:#172832;border:1px solid #344651;margin:2rem 0 1.2rem}.job-field{display:grid;gap:.55rem}.job-field input,.job-field select{background:#0b1720;border:1px solid #425662;color:var(--text);font:inherit;font-size:.92rem;min-height:48px;padding:.8rem .9rem;width:100%;border-radius:0}.job-field input:focus-visible,.job-field select:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}.job-count{white-space:nowrap;font-size:.8rem;color:#c4d6dd;padding:0 .2rem .95rem}
  .job-list{border-top:1px solid #35454f}.job{border-bottom:1px solid #35454f;border-top:1px solid var(--division-color);background:#10202a}.job[hidden],.no-results[hidden]{display:none}.job[open]{background:#152832}.job summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:2rem;padding:1.8rem 1.6rem;align-items:center}.job summary::-webkit-details-marker{display:none}.job summary:hover{background:#ffffff06}.job summary:focus-visible{outline:2px solid var(--cyan);outline-offset:-2px}.job-main{display:grid;gap:.6rem;min-width:0}.job-division{font-size:.65rem;text-transform:uppercase;color:var(--division-color);font-weight:850;letter-spacing:.15em}.job-division span{color:#92a6b1;margin:0 .35rem}.job-title{font-size:clamp(1.15rem,2.3vw,1.65rem);font-weight:800;letter-spacing:-.035em}.job-pitch{font-size:.89rem;color:#aabcc6;line-height:1.5;max-width:740px}.job-side{flex:none;display:grid;justify-items:end;gap:.35rem;font-size:.75rem;color:#95abb6}.job-side strong{color:#85dfeb;margin-top:.55rem;white-space:nowrap}.toggle-mark::after{content:'+';display:inline-block;font-size:1.15rem;margin-left:.45rem;vertical-align:middle}.job[open] .toggle-mark::after{content:'−'}
  .job-detail{display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:1.7rem 1.7rem 2rem;border-top:1px solid #304651}.job-detail h3{font-size:1rem;color:#f0f7fa;margin:0 0 .8rem}.job-detail ul{margin:0;padding-left:1.15rem;color:#afc0c9;font-size:.85rem;line-height:1.75}.job-detail li+li{margin-top:.35rem}.job-terms{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:1.3rem;border-top:1px solid #334752;padding-top:1.5rem}.job-terms p{font-size:.83rem;margin:.4rem 0 0}.job-terms .btn{white-space:nowrap}.no-results{padding:2rem 1.2rem;border:1px solid #38505c}
  .recruitment{display:grid;grid-template-columns:.85fr 1.15fr;gap:4rem}.recruitment>div>p{max-width:480px}.recruitment-steps{margin:0;padding:0;list-style:none}.recruitment-steps li{border-top:1px solid #354650;display:flex;gap:1.2rem;padding:1.45rem 0}.recruitment-steps li:last-child{border-bottom:1px solid #354650}.recruitment-steps li>span{color:var(--cyan);font-size:.78rem;font-weight:800;padding-top:.15rem}.recruitment-steps h3{font-size:1.1rem;margin:0 0 .45rem}.recruitment-steps p{font-size:.87rem;margin:0}.careers-closing{padding:5.7rem 0;background:radial-gradient(circle at 86% 10%,#174756,#0c1a23 62%);border-top:1px solid #35505b}.careers-closing h2{max-width:840px}.careers-closing .btn{margin-top:1rem}
  @media(max-width:900px){.benefits{grid-template-columns:1fr}.recruitment{grid-template-columns:1fr;gap:2rem}.job-terms{grid-template-columns:1fr 1fr}.job-terms .btn{justify-self:start}}
  @media(max-width:650px){.careers-hero{min-height:520px;background-position:55% center}.careers-intro{padding:5rem 0}.job-tools{grid-template-columns:1fr}.job-count{padding:0}.job summary{padding:1.25rem 1rem;display:block}.job-side{margin-top:1rem;display:flex;align-items:center;justify-content:space-between;gap:.8rem;flex-wrap:wrap}.job-side strong{margin-top:0}.job-detail{grid-template-columns:1fr;padding:1.3rem 1rem;gap:1.4rem}.job-terms{grid-template-columns:1fr;gap:.9rem}}
.benefits{display:block;border-top:1px solid #435862}.benefits article{display:grid;grid-template-columns:180px 1fr;align-items:baseline;gap:2rem;padding:1.3rem 0;border:0;border-bottom:1px solid #435862;background:transparent}.benefits h3{font-size:1.14rem;margin:0}.benefits p{font-size:.92rem}.culture-quote{background:transparent;border:0;border-top:1px solid #4d6571;padding:1.5rem 0}.careers-closing{padding:3.5rem 0;background:#101f28}.job{border-top:0}.job-main{gap:.4rem}.job-title{order:0}.job-division{order:1}.job-pitch{order:2}@media(max-width:650px){.benefits article{grid-template-columns:1fr;gap:.5rem}}</style>
