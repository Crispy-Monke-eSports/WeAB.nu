---
import BaseLayout from '../layouts/BaseLayout.astro';
import {projects} from '../data/projects';
import {companies} from '../data/companies';
import {locations} from '../data/locations';
const farmCount = locations.filter(place => place.operator === 'WeKill').length;
const companySlugByName = Object.fromEntries(companies.map(company => [company.name, company.slug]));
---
<BaseLayout title="Projekt & anläggningar | WeAB Group" description="Dokumenterade byggnader, farmer och transportsystem från WeAB:s Minecraft-verksamhet.">
<section class="page-hero"><div class="shell"><div class="eyebrow">ANLÄGGNINGAR & INFRASTRUKTUR</div><h1>Vår värld.<br/>Våra investeringar.</h1><p class="lead">I varje kvarter ser vi nya möjligheter att bygga, expandera och slutligen äga horisonten.</p></div></section>
<section class="section"><div class="shell">
  <p class="lead">Vi visar fotograferade anläggningar här. Vill du även hitta farmerna som saknar egna projektbilder? <a href="/verksamheter/wekill/#platser-pa-servern">WeKill driver {farmCount} registrerade farmer</a>, med blockkoordinater i tre dimensioner.</p>
  <div class="projects-filter-header"><div class="eyebrow">VÄLJ VERKSAMHET</div><output id="project-count" aria-live="polite">{projects.length} anläggningar</output></div>
  <div class="projects-filters" role="group" aria-label="Filtrera anläggningar">
    <button type="button" data-filter="all" aria-pressed="true">Alla</button>
    <button type="button" data-filter="WeAB" aria-pressed="false">WeAB</button>
    {companies.map(company => <button type="button" data-filter={company.name} aria-pressed="false">{company.name}</button>)}
  </div>
  <div class="projects-grid">{projects.map(project => <article class="project-card" data-company={project.division} id={project.id}>
    <div class="image-frame"><img src={project.image} alt={project.alt} loading="lazy" /></div>
    <div class="project-inner"><div class="project-label"><span>{project.division} / {project.category}</span><span>{project.stage}</span></div><h2>{project.name}</h2><p>{project.description}</p>
      {project.detailUrl ? <a class="project-company-link" href={project.detailUrl}>Se arenans bildgalleri ↗</a> : companySlugByName[project.division] && <a class="project-company-link" href={`/verksamheter/${companySlugByName[project.division]}/`}>Utforska {project.division} ↗</a>}
    </div>
  </article>)}</div>
</div></section>
</BaseLayout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.projects-filters button');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const count = document.querySelector<HTMLOutputElement>('#project-count');
  for (const button of filters) {
    button.addEventListener('click', () => {
      const selected = button.dataset.filter ?? 'all';
      for (const item of filters) item.setAttribute('aria-pressed', String(item === button));
      let visible = 0;
      for (const card of cards) {
        const matches = selected === 'all' || card.dataset.company === selected;
        card.hidden = !matches;
        if (matches) visible++;
      }
      if (count) count.textContent = visible + ' ' + (visible === 1 ? 'anläggning' : 'anläggningar');
    });
  }
</script>
<style>.projects-filter-header{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}.projects-filter-header output{color:#8eaeba;font-size:.78rem}.projects-filters{display:flex;flex-wrap:wrap;gap:.6rem;margin:.4rem 0 2rem}.projects-filters button{background:transparent;border:1px solid #3b525e;color:#bdd0d8;padding:.65rem .9rem;cursor:pointer;font:inherit;font-size:.8rem}.projects-filters button:hover,.projects-filters button:focus-visible{border-color:var(--cyan);color:#fff}.projects-filters button[aria-pressed="true"]{border-color:var(--cyan);background:#123944;color:#a2eff7}.project-card[hidden]{display:none}.project-company-link{display:inline-block;color:#7fdded;font-size:.82rem;font-weight:800;text-decoration:none;margin-top:1.2rem}.project-company-link:hover{text-decoration:underline}.projects-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem}.project-card{background:#14232d;border:1px solid #2d404b;scroll-margin-top:110px}.project-card .image-frame{height:295px;border:0;border-radius:0}.project-card .image-frame img{height:100%}.project-inner{padding:1.5rem}.project-inner h2{font-size:1.5rem;margin:1rem 0 .6rem}.project-inner p{margin:0;font-size:.85rem}.project-label{display:flex;justify-content:space-between;gap:1rem;color:#85d9e6;letter-spacing:.1em;font-size:.58rem;font-weight:800;text-transform:uppercase}.project-label span:last-child{color:#93a7b3}@media(max-width:700px){.projects-grid{grid-template-columns:1fr}.project-card .image-frame{height:245px}}</style>
