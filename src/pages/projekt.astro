---
import BaseLayout from '../layouts/BaseLayout.astro';
import {projects} from '../data/projects';
---
<BaseLayout title="Projekt & anläggningar | WeAB Group" description="Dokumenterade byggnader, farmer och transportsystem från WeAB:s Minecraft-verksamhet.">
<section class="page-hero"><div class="shell"><div class="eyebrow">ANLÄGGNINGAR & INFRASTRUKTUR</div><h1>Vår värld.<br/>Våra investeringar.</h1><p class="lead">I varje kvarter ser vi nya möjligheter att bygga, expandera och slutligen äga horisonten.</p></div></section>
<section class="section"><div class="shell"><div class="projects-grid">{projects.map(project=><article class="project-card" id={project.id}><div class="image-frame"><img src={project.image} alt={project.alt} loading="lazy"/></div><div class="project-inner"><div class="project-label"><span>{project.division} / {project.category}</span><span>{project.stage}</span></div><h2>{project.name}</h2><p>{project.description}</p></div></article>)}</div></div></section>
</BaseLayout>
<style>.projects-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem}.project-card{background:#14232d;border:1px solid #2d404b;scroll-margin-top:110px}.project-card .image-frame{height:295px;border:0;border-radius:0}.project-card .image-frame img{height:100%}.project-inner{padding:1.5rem}.project-inner h2{font-size:1.5rem;margin:1rem 0 .6rem}.project-inner p{margin:0;font-size:.85rem}.project-label{display:flex;justify-content:space-between;gap:1rem;color:#85d9e6;letter-spacing:.1em;font-size:.58rem;font-weight:800;text-transform:uppercase}.project-label span:last-child{color:#93a7b3}@media(max-width:700px){.projects-grid{grid-template-columns:1fr}.project-card .image-frame{height:245px}}</style>
