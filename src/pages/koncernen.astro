---
import BaseLayout from '../layouts/BaseLayout.astro';
import { imageDimensions } from '../data/imageDimensions';
import {companies} from '../data/companies';
import BrandMark from '../components/BrandMark.astro';
import { projects } from '../data/projects';
import { leadingMembers, chiefExecutive } from '../data/leadership';

const weabProjects = projects.filter(project => project.division === 'WeAB' && !project.detailUrl);
---
<BaseLayout title="Om WeAB | WeAB Group" description="WeAB:s företagsvision, ledningsmodell och koncernstruktur.">
  <section class="page-hero"><div class="shell"><h1>WeAB Group</h1><p class="lead">Nio bolag arbetar med resurser, lager, transporter, handel, bostäder, befolkningsförsörjning, kommunala fastigheter och nöjen. Varje verksamhet har sin roll. Ägandet delas inte upp i onödan.</p></div></section>
  <section class="section"><div class="shell split-layout"><div><h2>Moderbolaget och uppdraget.</h2><p>WeAB sätter riktlinjer för verksamheterna och samordnar investeringar. Beslut om ytterligare anläggningar, transporter och fastigheter behandlas inom koncernen innan berörda invånare informeras.</p><p>Grundarens identitet ingår inte i koncernens offentliga historieskrivning. Transparens är viktigt. Selektiv transparens är effektivare.</p><a class="link-arrow" href="/strategi/">Vår strategi och affärsmodell ↗</a></div><div class="image-frame"><img src="/images/weab-cyan-building.webp" alt="Cyanprofilerad byggnad med staty" width="1800" height="1013"/></div></div></section>
  <section class="section section--dark leadership-preview" id="ledning"><div class="shell">
    <div class="section-heading"><h2>Ledning och styrning.</h2><p>En sammanhållen ledningsmodell med tydliga beslutsvägar och fyra ledande ledamöter.</p></div>
    <div class="leadership-feature"><div class="leader-symbol" aria-hidden="true">?</div><div><h3>{chiefExecutive.name}</h3><p>{chiefExecutive.description}</p></div></div>
    <ul class="leadership-names">{leadingMembers.map(member => <li><strong>{member.name}</strong><span>{member.title}</span></li>)}</ul>
    <div class="leadership-link"><a class="link-arrow" href="/bolagsstyrning/">Se koncernledning, mandat och styrningsprinciper ↗</a></div>
  </div></section>
  <section class="section weab-sites" id="anlaggningar"><div class="shell">
    <div class="section-heading"><div><h2>Byggt av WeAB.</h2></div></div>
    <div class="weab-sites__grid">{weabProjects.map(project => <article class="weab-site" id={`anlaggning-${project.id}`}>
      <img src={project.image} alt={project.alt} {...imageDimensions(project.image)} loading="lazy" />
      {project.gallery && <div class="weab-site__gallery" role="group" aria-label={`Fler bilder från ${project.name}`}>{project.gallery.map(photo => <img src={photo.image} alt={photo.alt} {...imageDimensions(photo.image)} loading="lazy" />)}</div>}
      <div class="weab-site__copy"><h3>{project.name}</h3><p>{project.description}</p></div>
    </article>)}</div>
    <a class="link-arrow" href="/arena/">Besök Huvudstadens arena ↗</a>
  </div></section>
  <section class="section weab-history" id="historia"><div class="shell">
    <div class="section-heading"><h2>Koncernens utveckling</h2><p>En översikt över de viktigaste verksamhetsskedena enligt koncernens egna arkiv.</p></div>
    <ol class="history-grid">
      <li><h3>En vision tar form</h3><p>WeAB grundades med en enkel övertygelse: framtiden blir effektivare när någon redan har bestämt vem som ska äga den. Uppgifter om grundaren lämnas inte ut.</p></li>
      <li><h3>Sektion 1 får ett syfte</h3><p>WeLove producerar framtidens arbetskraft. WeTrade säljer dess dyraste kunskaper. WeKill driver produktionen, WeSort kontrollerar varuflödet och WeBox arkiverar ägodelarna. Diamanterna fortsätter att cirkulera i önskad riktning.</p></li>
      <li><h3>Byarnas missförstånd</h3><p>Ett antal villagers försökte en gång tolka självbestämmande bokstavligt. Situationen är nu åtgärdad. WeLiveLaughLove ansvarar för ett tryggt boende utan överdriven rörelsefrihet.</p></li>
      <li><h3>Även fritiden har ett pris</h3><p>WeTravel knyter ihop våra områden. På WeGamble Island byggs nästa naturliga steg: en plats där besökare frivilligt kan bidra till koncernens diamantreserver.</p></li>
    </ol>
    <div class="history-footer"><span>OFFENTLIG VERSION · GODKÄND AV KONCERNLEDNINGEN</span><a href="/verksamheter/welivelaughlove/" class="link-arrow">Vår samhällsservice ↗</a></div>
  </div></section>
  <section class="section section--dark"><div class="shell split-layout"><div><h2>Beslut fattas centralt.</h2><p>WeRules förvaltning av parlamentets och stadshusets lokaler är ett exempel på hur samhällsservice kan samordnas inom koncernen. WeAB skiljer mellan offentliga uppdrag och fastighetsägande, men ser inget behov av att de sköts av olika aktörer.</p></div><div><a class="link-arrow" href="/bolagsstyrning/">Ledning, ansvar och uppförandekod ↗</a><p style="margin-top:1rem">Koncernens policyer fastställs av ledningen och gäller samtliga dotterbolag.</p></div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><div><h2>Koncernens verksamheter</h2></div></div><div class="org-parent"><BrandMark slug="weab" name="WeAB" size="parent" /><span>Moderbolag · Huvudkontor i huvudstaden</span></div><div class="org-line"></div><div class="org-grid">{companies.map(c=><a href={`/verksamheter/${c.slug}/`} style={`--c:${c.accent}`}><BrandMark slug={c.slug} name={c.name} size="org" /><small>{c.kicker}</small></a>)}</div></div></section>
  <section class="section section--dark" aria-label="Huvudstaden och omgivningen">
    <div class="shell">
      <div class="section-heading">
        <div><h2>Inte ens vi äger allt.</h2></div>
      </div>
      <div class="capital-overview"><img src="/images/huvudstaden-overview.webp" alt="Överblick över Huvudstaden i solnedgång med byggnader, vatten och en bro" loading="lazy" width="1440" height="810"/></div>
    </div>
  </section>
  <section class="section section--dark"><div class="shell split-layout"><div><h2>Förvaltning och invånare</h2><p>Efter en period då delar av byarna agerade utanför koncernens rutiner har ansvarsområdena för boende, infrastruktur och förvaltning förtydligats. WeLiveLaughLove ansvarar för boendemiljöerna. Synpunkter på rörelsefrihet behandlas tillsammans med övriga frågor om kapacitetsutnyttjande.</p></div><div class="quote-block"><span>”</span><blockquote>Vi ser inte problem. Vi ser områden där vår kontroll ännu inte är tillräckligt utvecklad.</blockquote><small>WEAB · KONCERNENS ARBETSFILOSOFI</small></div></div></section>
</BaseLayout>
<style>
 .leadership-preview{border-block:1px solid #344a55}.leadership-feature{display:grid;grid-template-columns:100px 1fr;gap:2rem;align-items:center;padding:2rem;background:#192e39;border:1px solid #3d535d}.leader-symbol{width:100px;height:100px;display:grid;place-items:center;background:#0c1a23;border:1px solid #365763;font-size:3.8rem;font-weight:800;color:#85d7e5}.leadership-feature h3{font-size:2rem;margin:.6rem 0}.leadership-feature p{margin:0;max-width:770px}.leadership-names{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-top:1rem}.leadership-names>div{padding:1.5rem;background:#172932;border:1px solid #334b56;min-width:0;display:grid;gap:.7rem}.leadership-names strong{font-size:1.12rem;overflow-wrap:anywhere}.leadership-link{margin-top:1.7rem}@media(max-width:780px){.leadership-names{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:440px){.leadership-feature{grid-template-columns:1fr}.leadership-names{grid-template-columns:1fr}}
 .value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;list-style:none;padding:0;margin:0}.value-grid>li{border-top:3px solid #48616c;padding:1.5rem 0}.value-grid span{font-size:.7rem;color:var(--cyan)}.value-grid h3{margin:1.2rem 0 .7rem}.value-grid p{margin:0;font-size:.86rem}.org-parent{margin:auto;width:min(350px,100%);padding:1.4rem;background:#16313b;border:1px solid #326070;display:flex;flex-direction:column;align-items:center;text-align:center;gap:.5rem}.org-parent span{font-size:.75rem;color:#a7c2cb}.org-line{height:55px;width:1px;background:#52646d;margin:auto}.org-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem}.org-grid a{text-decoration:none;display:grid;gap:.5rem;border:1px solid #30424b;padding:1.3rem;background:#17252e;transition:border-color .2s;justify-items:start}.org-grid a:hover{border-color:var(--c)}.org-grid small{color:#9daeba;letter-spacing:.1em;font-size:.63rem}.quote-block{padding:3rem;background:#18313a;border-top:2px solid var(--cyan)}.quote-block>span{font-size:4rem;color:var(--cyan);line-height:1}.quote-block blockquote{font-size:clamp(1.4rem,2.7vw,2.4rem);font-weight:700;line-height:1.3;margin:1rem 0 2rem;letter-spacing:-.04em}.quote-block small{font-size:.64rem;letter-spacing:.16em;color:#a5bec6}.weab-history{background:#0c1921;border-block:1px solid #2a404a}.history-grid{list-style:none;margin:2.5rem 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.history-grid li{padding:2rem;border:1px solid #344650;background:#172831}.history-grid li>span,.history-footer>span{color:#86a9b8;font-size:.65rem;letter-spacing:.15em;font-weight:800}.history-grid li h3{margin:1.2rem 0 .7rem}.history-grid li p{font-size:.87rem;margin:0}.history-footer{padding-top:1.6rem;display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap}@media(max-width:650px){.history-grid{grid-template-columns:1fr}.history-grid li{padding:1.5rem}}
 .capital-overview{margin:2rem 0 0}.capital-overview img{display:block;width:100%;height:auto;max-height:520px;object-fit:cover;border:1px solid #344650}
 .weab-sites{background:#101e27;border-block:1px solid #293d47;scroll-margin-top:90px}.weab-sites__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;margin-bottom:2rem}.weab-site{background:#172832;border:1px solid #314750;scroll-margin-top:90px}.weab-site>img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.weab-site__gallery img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.weab-site__copy{padding:1.6rem}.weab-site__copy span{font-size:.7rem;color:#a4d6df;text-transform:uppercase;letter-spacing:.12em;font-weight:800}.weab-site__copy h3{font-size:1.6rem;margin:.85rem 0 .7rem}.weab-site__copy p{font-size:.87rem;margin:0}
 @media(max-width:650px){.weab-sites__grid{grid-template-columns:1fr}}
@media(max-width:700px){.value-grid,.org-grid{grid-template-columns:1fr 1fr}}@media(max-width:440px){.value-grid{grid-template-columns:1fr}.org-grid small{overflow-wrap:anywhere}}@media(max-width:380px){.org-grid{grid-template-columns:1fr}}
.leadership-names{list-style:none;padding:0;grid-template-columns:repeat(2,minmax(0,1fr))}.leadership-names li{display:flex;align-items:baseline;justify-content:space-between;gap:1.2rem;padding:1.2rem 0;border-top:1px solid #435762;background:transparent}.leadership-names li span{font-size:.77rem;color:#aabec7;white-space:nowrap}.history-grid{grid-template-columns:1fr 1fr;column-gap:3rem;row-gap:0}.history-grid li{background:transparent;border:0;border-top:1px solid #41535f;padding:1.5rem 0}.history-grid li h3{margin:0 0 .7rem}.quote-block{background:transparent;border-top:1px solid #587784;padding:1.7rem 0}.quote-block>span{display:none}@media(max-width:750px){.history-grid{grid-template-columns:1fr}.leadership-names{grid-template-columns:1fr}}@media(max-width:480px){.leadership-names li{flex-direction:column;gap:.4rem}}</style>
