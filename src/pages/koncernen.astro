---
import BaseLayout from '../layouts/BaseLayout.astro';
import {companies} from '../data/companies';
import BrandMark from '../components/BrandMark.astro';
import {locations} from '../data/locations';
import WaypointSection from '../components/WaypointSection.astro';

const capitalLocations = locations.filter(place => place.group === 'Städer' || place.group === 'Offentliga byggnader');
const shopLocations = locations.filter(place => place.group === 'Butiker');
const landmarks = locations.filter(place => place.group === 'Sevärdheter');
const playerBases = locations.filter(place => place.group === 'Spelarbaser');
---
<BaseLayout title="Om WeAB | WeAB Group" description="WeAB:s företagsvision, ledningsmodell och koncernstruktur.">
  <section class="page-hero"><div class="shell"><div class="eyebrow">OM WEAB</div><h1>Vi organiserar framtiden.</h1><p class="lead">WeAB producerar resurser, föder upp arbetskraft, säljer kunskap, förvarar ägodelar och erbjuder begränsad frihet inom en obruten kedja av koncernkontrollerad service. Alla vägar leder till oss. Alla diamanter likaså.</p></div></section>
  <section class="section"><div class="shell split-layout"><div><div class="eyebrow">STYRNING & LEDARSKAP</div><h2>Ledda av resultat.<br/>Styrda av avkastning.</h2><p>WeAB leds av ett antal ledande ledamöter med ett gemensamt mandat: att skydda koncernens intressen och driva aktiekursen uppåt. Andra överväganden vägs omsorgsfullt mot sitt bidrag till den långsiktiga avkastningen.</p><p>Grundarens identitet ingår inte i koncernens offentliga historieskrivning. Transparens är viktigt. Selektiv transparens är effektivare.</p></div><div class="image-frame"><img src="/images/weab-cyan-building.webp" alt="Cyanprofilerad byggnad med staty"/></div></div></section>
  <section class="section weab-history" id="historia"><div class="shell">
    <div class="section-heading"><div><div class="eyebrow">KONCERNENS HISTORIA</div><h2>Från en idé till<br/>ett ofrånkomligt faktum.</h2></div><p>Våra arkiv är omfattande. Vissa kapitel är mer tillgängliga än andra.</p></div>
    <ol class="history-grid">
      <li><span>01 / URSPRUNG</span><h3>En vision tar form</h3><p>WeAB grundades med en enkel övertygelse: framtiden blir effektivare när någon redan har bestämt vem som ska äga den. Uppgifter om grundaren lämnas inte ut.</p></li>
      <li><span>02 / EXPANSION</span><h3>Sektion 1 får ett syfte</h3><p>WeLove producerar framtidens arbetskraft. WeTrade säljer dess dyraste kunskaper. WeKill driver produktionen, WeSort kontrollerar varuflödet och WeBox arkiverar ägodelarna. Diamanterna fortsätter att cirkulera i önskad riktning.</p></li>
      <li><span>03 / STABILISERING</span><h3>Byarnas missförstånd</h3><p>Ett antal villagers försökte en gång tolka självbestämmande bokstavligt. Situationen är nu åtgärdad. WeLiveLaughLove ansvarar för ett tryggt boende utan överdriven rörelsefrihet.</p></li>
      <li><span>04 / FRAMTIDEN</span><h3>Även fritiden har ett pris</h3><p>WeTravel knyter ihop våra områden. På WeGamble Island byggs nästa naturliga steg: en plats där besökare frivilligt kan bidra till koncernens diamantreserver.</p></li>
    </ol>
    <div class="history-footer"><span>OFFENTLIG VERSION · GODKÄND AV KONCERNLEDNINGEN</span><a href="/verksamheter/welivelaughlove/" class="link-arrow">Vår samhällsservice ↗</a></div>
  </div></section>
  <section class="section section--dark"><div class="shell"><div class="section-heading"><div><div class="eyebrow">VÅRA VÄRDERINGAR</div><h2>Principer som skapar värde.</h2></div></div><ol class="value-grid"><li><span>01 /</span><h3>Samordning</h3><p>Det blir enklare att fatta rätt beslut när alla beslut kommer från samma håll.</p></li><li><span>02 /</span><h3>Tillväxt</h3><p>En god avkastning är inte en ambition. Det är en minimiförväntning.</p></li><li><span>03 /</span><h3>Stabilitet</h3><p>Vi ser till att varje samhällsprocess följer en väl definierad riktning.</p></li></ol></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><div><div class="eyebrow">ORGANISATION</div><h2>Koncernens verksamheter</h2></div></div><div class="org-parent"><BrandMark slug="weab" name="WeAB" size="parent" /><span>Moderbolag · Huvudkontor i huvudstaden</span></div><div class="org-line"></div><div class="org-grid">{companies.map(c=><a href={`/verksamheter/${c.slug}/`} style={`--c:${c.accent}`}><BrandMark slug={c.slug} name={c.name} size="org" /><small>{c.kicker}</small></a>)}</div></div></section>
  <section class="section section--dark" aria-label="Runtom i Minecraft-världen">
    <div class="shell">
      <div class="section-heading">
        <div><div class="eyebrow">HUVUDSTADEN OCH OMGIVNINGEN</div><h2>Vår värld är större än koncernen.</h2></div>
        <p>Waypoint-filen visar hur WeAB:s anläggningar hänger ihop med vanliga delar av servern: staden på halvön, butiker, byggnader, sevärdheter och spelarnas egna baser.</p>
      </div>
      <WaypointSection
        heading="Huvudstaden och offentliga byggnader"
        introduction="Huvudstaden ligger enligt serverns waypointbeskrivning på en halvö. Stadshuset i Sektion 1 har en egen markerad position. Koordinaterna gäller själva waypointen, inte byggnadernas alla ingångar."
        places={capitalLocations}
      />
      <WaypointSection
        heading="Handeln vid huvudstaden"
        introduction="ByggMaxx, McDonald's och tankstationen finns som separata markeringar. Vi listar dem som serverns butiker, utan att påstå att de är WeAB-bolag."
        places={shopLocations}
      />
      <WaypointSection
        heading="Sevärdheter på servern"
        introduction="Här finns bland annat Hungerspelsarenan, casinoön, Bedrock-chunken och Noas får-ö. Hungerspelsarenan är en annan waypoint än Huvudstadens arena."
        places={landmarks}
      />
      <WaypointSection
        heading="Spelarnas egna baser"
        introduction="Utöver koncernens byggnader finns även privata spelarbaser markerade. De är inte WeAB-verksamheter. Två markeringar heter Simons bas men har olika positioner."
        places={playerBases}
      />
      <p class="caption">Uppgifterna kommer från en exporterad waypoint-lista. Positioner anges som Minecraft-block (X, Y, Z) och kan förändras när servern byggs ut.</p>
    </div>
  </section>
  <section class="section section--dark"><div class="shell split-layout"><div><div class="eyebrow">SÄRSKILT MEDDELANDE</div><h2>Ordning är inte alltid populärt. Den är ändå nödvändig.</h2><p>Efter en kort period av oauktoriserad självständighet i byarna har samhällsfreden återställts. De boende har nu samma rättigheter som tidigare, men betydligt färre möjligheter att utöva dem.</p></div><div class="quote-block"><span>”</span><blockquote>Vi ser inte problem. Vi ser områden där vår kontroll ännu inte är tillräckligt utvecklad.</blockquote><small>WEAB · KONCERNENS ARBETSFILOSOFI</small></div></div></section>
</BaseLayout>
<style>
.value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;list-style:none;padding:0;margin:0}.value-grid>li{border-top:3px solid #48616c;padding:1.5rem 0}.value-grid span{font-size:.7rem;color:var(--cyan)}.value-grid h3{margin:1.2rem 0 .7rem}.value-grid p{margin:0;font-size:.86rem}.org-parent{margin:auto;width:min(350px,100%);padding:1.4rem;background:#16313b;border:1px solid #326070;display:flex;flex-direction:column;align-items:center;text-align:center;gap:.5rem}.org-parent span{font-size:.75rem;color:#a7c2cb}.org-line{height:55px;width:1px;background:#52646d;margin:auto}.org-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem}.org-grid a{text-decoration:none;display:grid;gap:.5rem;border:1px solid #30424b;padding:1.3rem;background:#17252e;transition:border-color .2s;justify-items:start}.org-grid a:hover{border-color:var(--c)}.org-grid small{color:#9daeba;letter-spacing:.1em;font-size:.63rem}.quote-block{padding:3rem;background:#18313a;border-left:3px solid var(--cyan)}.quote-block>span{font-size:4rem;color:var(--cyan);line-height:1}.quote-block blockquote{font-size:clamp(1.4rem,2.7vw,2.4rem);font-weight:700;line-height:1.3;margin:1rem 0 2rem;letter-spacing:-.04em}.quote-block small{font-size:.64rem;letter-spacing:.16em;color:#a5bec6}.weab-history{background:#0c1921;border-block:1px solid #2a404a}.history-grid{list-style:none;margin:2.5rem 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.history-grid li{padding:2rem;border:1px solid #344650;background:#172831}.history-grid li>span,.history-footer>span{color:#86a9b8;font-size:.65rem;letter-spacing:.15em;font-weight:800}.history-grid li h3{margin:1.2rem 0 .7rem}.history-grid li p{font-size:.87rem;margin:0}.history-footer{padding-top:1.6rem;display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap}@media(max-width:650px){.history-grid{grid-template-columns:1fr}.history-grid li{padding:1.5rem}}
@media(max-width:700px){.value-grid,.org-grid{grid-template-columns:1fr 1fr}}@media(max-width:440px){.value-grid{grid-template-columns:1fr}.org-grid{grid-template-columns:1fr 1fr}.org-grid strong{font-size:.85rem}}
</style>
