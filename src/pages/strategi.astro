---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companies } from '../data/companies';
const companyBySlug = Object.fromEntries(companies.map(company => [company.slug, company]));
const valueChain = [
  { number: '01', name: 'Produktion', slug: 'wekill', detail: 'Råvaror och industriella flöden tas fram där naturen erbjuder bäst förutsättningar för standardisering.' },
  { number: '02', name: 'Sortering och lagring', slug: 'wesort', detail: 'Resurser styrs genom gemensamma lagerprocesser. Oberoende förråd bidrar sällan till jämförbarheten.' },
  { number: '03', name: 'Förvaring', slug: 'webox', detail: 'Shulkerbaserade system håller varor tillgängliga, märkta och omsorgsfullt registrerade i koncernens struktur.' },
  { number: '04', name: 'Transport', slug: 'wetravel', detail: 'Räls och isbåtsleder förbinder verksamheterna. Alternativa färdvägar bedöms utifrån deras strategiska nödvändighet.' },
  { number: '05', name: 'Handel', slug: 'wetrade', detail: 'Kunskap och enchantments erbjuds i ett samlat handelssystem där kunderna möter samma höga standard överallt.' }
];
const supporting = [
  {slug:'welove',heading:'Framtidens kompetensförsörjning',body:'Långsiktig befolknings- och personalplanering säkerställer ett förutsägbart tillskott av arbetskraft.'},
  {slug:'welivelaughlove',heading:'Bostäder och samhällsstabilitet',body:'Gemensam planering skapar kapacitet för fler boende och minskar belastningen av individuella boendeval.'},
  {slug:'werule',heading:'Myndigheter och offentliga lokaler',body:'WeRule äger samtliga offentliga lokaler och utför all myndighetsutövning, inklusive våldsmonopolet. Kontrakten som tilldelades WeAB gäller på obestämd tid.'},
  {slug:'wegamble',heading:'Nya kundupplevelser',body:'På WeGamble Island utvecklas ett erbjudande som skapar omsättning även efter att kundens ursprungliga behov är uppfyllt.'}
];
---
<BaseLayout title="Strategi och affärsmodell | WeAB Group" description="WeAB:s värdekedja från WeKill till WeTrade, och hur koncernens övriga bolag knyts till produktion och handel.">
  <header class="page-hero strategy-hero">
    <div class="shell">
      
      <h1>Hela värdekedjan.<br/>En enda ägare.</h1>
      <p class="lead">WeKill tar fram material, WeSort fördelar det, WeBox lagrar det och WeTravel kör det vidare. I nästa led säljer WeTrade kunskap och förtrollningar. Samma koncern får intäkterna i varje steg.</p>
      <a href="#affarsmodell" class="btn">Utforska affärsmodellen ↓</a>
    </div>
  </header>

  <section class="section" id="affarsmodell">
    <div class="shell">
      <div class="section-heading">
        <div><h2>Från första resurs till slutkund.</h2></div>
        <p>De fem stegen beskriver koncernens faktiska verksamhetsområden. Det finns inga offentliggjorda volymtal för den samlade kedjan.</p>
      </div>
      <ol class="value-chain">
        {valueChain.map(step => <li>
          <span class="chain-num">{step.number}</span>
          <div><h3>{step.name}</h3><p>{step.detail}</p></div>
          <a href={`/verksamheter/${step.slug}/`} aria-label={`Läs mer om ${companyBySlug[step.slug].name}`}>
            <strong>{companyBySlug[step.slug].name}</strong><span aria-hidden="true">↗</span>
          </a>
        </li>)}
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell split-layout">
      <div><h2>Skalbarhet genom samordning.</h2><p class="lead">När en koncern äger produktionen, logistiken och distributionsvägarna uppstår betydande samordningsvinster.</p><p>WeAB arbetar löpande för att minska beroendet av aktörer som inte omfattas av koncernens kvalitetssäkring, prissättning eller ägarstyrning.</p><a class="link-arrow" href="/investerare/">Investerarperspektivet ↗</a></div>
      <dl class="strategy-principles"><div><dt>Produktion</dt><dd>WeKill kan utöka kapaciteten inom den befintliga anläggningsstrukturen. Hur mycket som faktiskt produceras följs separat från konstruktionskapacitet.</dd></div><div><dt>Logistik</dt><dd>WeSort, WeBox och WeTravel hanterar olika delar av samma varuflöde. Det minskar behovet av externa överlämningar, och av externa leverantörer.</dd></div><div><dt>Styrning</dt><dd>WeRule samlar myndighetsbeslut, offentligt tvång och omprövning under samma huvudman. Invånarnas invändningar tas emot utan att behöva lämna koncernen.</dd></div></dl>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><h2>Fler verksamheter.<br/>Samma strategi.</h2></div><p>Värdekedjan kompletteras av fastigheter, samhällstjänster, personalförsörjning och framtida nöjesverksamhet.</p></div>
      <div class="supporting-grid">{supporting.map(item => <a href={`/verksamheter/${item.slug}/`} class="supporting-card"><div><h3>{companyBySlug[item.slug].name}</h3><p>{item.heading}. {item.body}</p></div><span class="supporting-status">{companyBySlug[item.slug].status}</span><span class="supporting-arrow" aria-hidden="true">↗</span></a>)}</div>
    </div>
  </section>

</BaseLayout>
<style>
.strategy-hero{background:linear-gradient(90deg,#0a1921f2,#0a1921ca 64%,#0a192176),url('/images/section-1-overview.webp') center / cover}
.strategy-hero .btn{margin-top:.8rem}
.value-chain{list-style:none;padding:0;margin:2.3rem 0 0;border-top:1px solid #3c5260}
.value-chain li{display:grid;grid-template-columns:65px minmax(0,1fr) 160px;align-items:center;gap:1.7rem;padding:1.5rem 0;border-bottom:1px solid #3c5260}
.chain-num{font-size:.8rem;color:#83d8e6;font-weight:800}
.value-chain h3{font-size:1.4rem;margin:0 0 .5rem}
.value-chain p{font-size:.89rem;line-height:1.6;max-width:65ch;margin:0}
.value-chain a{display:flex;align-items:center;justify-content:space-between;gap:1rem;text-decoration:none;font-size:.84rem;font-weight:750;color:#c9e6eb}
.value-chain a span{color:#79d6e4}
.value-chain a:hover strong{text-decoration:underline;text-underline-offset:3px}
.strategy-principles{margin:0;border-top:1px solid #47606b}
.strategy-principles div{padding:1.2rem 0;border-bottom:1px solid #47606b}
.strategy-principles dt{font-size:1.02rem;font-weight:800;margin-bottom:.5rem}
.strategy-principles dd{margin:0;font-size:.87rem;line-height:1.65;color:#b5c9d1}
.supporting-grid{display:block;border-top:1px solid #445a65}
.supporting-card{display:grid;grid-template-columns:minmax(0,1fr) 160px 20px;align-items:baseline;gap:1.5rem;padding:1.3rem 0;border-bottom:1px solid #445a65;text-decoration:none}
.supporting-card h3{font-size:1.2rem;margin:0 0 .45rem}
.supporting-card p{font-size:.87rem;margin:0}
.supporting-status{font-size:.77rem;color:#b1c6d0}
.supporting-arrow{color:#88dce9}
.supporting-card:hover h3{text-decoration:underline;text-underline-offset:3px}
@media(max-width:730px){.value-chain li{grid-template-columns:40px 1fr;gap:1rem}.value-chain li>a{grid-column:2}.supporting-card{grid-template-columns:1fr 20px}.supporting-status{grid-column:1;grid-row:2}.supporting-arrow{grid-column:2;grid-row:1}}
</style>
