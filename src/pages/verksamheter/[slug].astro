---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { imageAsset, responsiveWidths } from '../../data/imageAssets';
import BrandMark from '../../components/BrandMark.astro';
import { companies } from '../../data/companies';
import { projects } from '../../data/projects';
import CompanyAssets from '../../components/CompanyAssets.astro';
import { companyEditorial } from '../../data/companyEditorial';
import { emailForCompany } from '../../data/contacts';
import { leadingMembers } from '../../data/leadership';

export function getStaticPaths() {
  return companies.map(company => ({ params: { slug: company.slug }, props: { company } }));
}

const { company } = Astro.props;
const relatedProjects = projects.filter(project => project.division === company.name);
const editorial = companyEditorial[company.slug];
const contactEmail = emailForCompany(company.slug);
const assetsFirst = ['wekill', 'welivelaughlove', 'wetravel', 'werule', 'wegamble'].includes(company.slug);
const appointedLeader = leadingMembers.find(member => member.name === (company.slug === 'welivelaughlove' ? 'Filuren2003' : company.slug === 'welove' ? 'Haapalainen' : ''));
---
<BaseLayout title={`${company.name} | WeAB Group`} description={company.overview}>
  <div class="company-theme" style={`--company-accent:${company.accent};--company-on-accent:${company.accent === '#00BCD4' ? '#06212b' : '#fff'}`}>
    <section class="company-hero">
      {company.image && <Image class="company-hero__image" src={imageAsset(company.image)} alt="" layout="full-width" widths={responsiveWidths} sizes="100vw" aria-hidden="true" loading="eager" fetchpriority="high" />}
      <div class="company-hero__shade" aria-hidden="true"></div>
      <div class="shell company-hero__content">
        <nav class="company-crumb" aria-label="Brödsmulor"><a href="/verksamheter/">Verksamheter</a><span aria-hidden="true">/</span><span>{company.name}</span></nav>
        <div class="company-hero__main">
          <BrandMark slug={company.slug} name={company.name} size="hero" />
          <h1>{company.tagline}</h1>
          <p class="lead">{company.overview}</p>
          <div class="hero-tools">
            <a href="#anlaggningar" class="btn company-btn">Se anläggningarna ↓</a>
            <a href="#verksamhet" class="hero-secondary">Läs om verksamheten ↓</a>
          </div>
        </div>
        <p class="company-hero__meta">{company.status} <span aria-hidden="true">·</span> {company.location}</p>
      </div>
    </section>

    {appointedLeader && <section class="section company-appointment"><div class="shell company-appointment__inner">
      <div>{company.slug === 'welivelaughlove'
          ? <><h2>Filuren2003 leder boendeordningen</h2><p>Filuren2003 har tagit över som koncernens förtrycksminister och huvudansvarig för WeLiveLaughLove. Han drev igenom att byarna bara får vatten utdelat varannan dag för att spara pengar och belönades med ”Årets insparning 2025” på koncernens champagnefest, där bara företagets toppar var inbjudna. Han är fortfarande otroligt stolt över beslutet.</p></>
          : <><h2>Haapalainen ansvarar för WeLove</h2><p>Haapalainen ansvarar för WeLove och leder arbetet med koncernens personalförsörjning.</p></>}
        <a class="link-arrow" href={`/ledning/${appointedLeader.slug}/`}>Lär känna {appointedLeader.name} ↗</a></div>
      <Image src={imageAsset(appointedLeader.profileImage)} alt={`Profilbild för ${appointedLeader.name}`} layout="constrained" widths={[96, 144, 288]} sizes="(max-width: 600px) 96px, 144px" loading="lazy" />
    </div></section>}

    {assetsFirst && <CompanyAssets editorial={editorial} projects={relatedProjects} slug={company.slug} />}

    <section id="verksamhet" class="section company-about">
      <div class="shell split-layout">
        <div><h2>{company.name} i praktiken.</h2><p class="lead">{company.description}</p></div>
        <div class="facts"><h3>Verksamhetsöversikt</h3><dl>
          {company.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
          <div><dt>Verksamhetsstatus</dt><dd>{company.status}</dd></div>
          <div><dt>Plats</dt><dd>{company.location}</dd></div>
        </dl><div class="company-contact"><span>VERKSAMHETSKONTAKT</span><a href={"mailto:" + contactEmail}>{contactEmail} ↗</a></div></div>
      </div>
    </section>

    <section class="section section--dark company-services"><div class="shell">
      <h2>Det här hanterar {company.name}.</h2>
      <ol class="service-list">{company.services.map(service => <li>{service}</li>)}</ol>
    </div></section>

    {!assetsFirst && <CompanyAssets editorial={editorial} projects={relatedProjects} slug={company.slug} />}

    <nav class="company-return" aria-label="Tillbaka till koncernens verksamheter"><div class="shell"><a href="/verksamheter/">← Alla koncernbolag</a><a href="/strategi/">Koncernens affärsmodell ↗</a></div></nav>
  </div>
</BaseLayout>

<style>
  .company-appointment { padding-block: clamp(2rem, 5vw, 3.5rem); border-bottom: 1px solid #34454f; }
  .company-appointment__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .company-appointment img { width: clamp(96px, 12vw, 144px); height: auto; flex: none; border-radius: 50%; }
  .company-appointment h2 { margin: 0 0 .8rem; }
  .company-appointment p { max-width: 67ch; margin: 0 0 1rem; }
  @media (max-width: 600px) { .company-appointment__inner { align-items: flex-start; flex-direction: column-reverse; gap: 1.25rem; } }
  .company-theme { --cyan: var(--company-accent); }
  .company-theme .company-btn { background: var(--company-accent); color: var(--company-on-accent); }
  .company-hero { position: relative; isolation: isolate; overflow: hidden; min-height: max(660px, calc(100svh - 78px)); background: #0d1922; border-bottom: 1px solid #32424d; }
  .company-hero__image { position: absolute; inset: 0 0 0 auto; z-index: -2; width: 75%; height: 100%; object-fit: cover; object-position: center; }
  .company-hero__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg,#0c1821 0%,#0c1821f5 27%,#0c1821ca 48%,#0c18217d 75%,#0c18218f 100%),linear-gradient(0deg,#0c1821 0%,transparent 32%),linear-gradient(150deg,color-mix(in srgb,var(--company-accent) 18%,transparent),transparent 50%); }
  .company-hero__content { min-height: inherit; display: flex; flex-direction: column; padding-block: 2rem 2.5rem; }
  .company-crumb { display: flex; align-items: center; gap: .7rem; font-size: .77rem; color: #c2d1d9; }
  .company-crumb a { color: #dbe8ed; text-decoration: none; }
  .company-crumb a:hover { text-decoration: underline; }
  .company-hero__main { margin-block: auto; padding-block: 3.25rem; max-width: min(750px, 100%); }
  .company-hero__main :global(.brand-mark) { margin-bottom: 2.25rem; }
  .company-hero h1 { max-width: 12ch; font-size: clamp(2.8rem, 6.1vw, 5.7rem); margin-bottom: 1.35rem; }
  .company-hero .lead { color: #e0e9ec; max-width: 620px; margin-bottom: 0; }
  .hero-tools { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .company-hero__meta { margin: 0; color: #b9cad1; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .company-hero__meta span { margin-inline: .5rem; color: var(--company-accent); }
  #verksamhet { scroll-margin-top: 90px; }
  .facts { background: #182731; border: 1px solid #34454f; padding: 2rem; }
  .facts h3 { margin-bottom: 1.7rem; }
  .facts dl { margin: 0; }
  .facts dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-top: 1px solid #354651; font-size: .82rem; }
  .facts dt { color: #a7bdc9; }
  .facts dd { font-weight: 700; text-align: right; margin: 0; }
  .company-contact { margin-top:1.4rem; padding-top:1.4rem; border-top:1px solid #354651; display:grid; gap:.55rem; }
  .company-contact span { font-size:.65rem; font-weight:800; color:#9db6c1; letter-spacing:.12em; }
  .company-contact a { font-size:.94rem; font-weight:800; color:#a6e9f2; overflow-wrap:anywhere; }
  .service-list { list-style: decimal-leading-zero; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 3rem; margin: 2rem 0 0; padding-left: 2.5rem; }
  .service-list li { padding: 1.2rem .75rem; border-top: 1px solid #35464e; font-size: 1.12rem; font-weight: 700; line-height: 1.45; }
  .service-list li::marker { color: var(--company-accent); font-size: .8rem; font-weight: 800; }
  .company-cta { padding: 6rem 0; background: linear-gradient(115deg,color-mix(in srgb,var(--company-accent) 23%,#0d1e27),#0d1e27); border-top: 1px solid #314c58; }
  .company-cta h2 { max-width: 780px; }
  .company-cta .btn { margin-top: 1rem; }
  @media (max-width: 900px) {
    .company-hero__image { width: 100%; }
    .company-hero__shade { background: linear-gradient(90deg,#0c1821ee 0%,#0c1821ba 70%,#0c182199 100%),linear-gradient(0deg,#0c1821,transparent 60%); }
  }
  @media (max-width: 700px) {
    .company-hero { min-height: max(690px, calc(100svh - 78px)); }
    .company-hero__content { padding-block: 1.5rem 2rem; }
    .company-hero__main { padding-block: 2.5rem; }
    .company-hero__main :global(.brand-mark) { margin-bottom: 1.75rem; }
    .company-hero h1 { font-size: clamp(2.6rem,9vw,4rem); }
    .company-hero__shade { background: linear-gradient(0deg,#0c1821 0%,#0c1821db 40%,#0c1821b3 100%),linear-gradient(90deg,#0c1821bd,transparent); }
    .service-list { grid-template-columns: 1fr; }
  }
.hero-secondary{font-size:.86rem;color:#bce6ed;font-weight:700;text-decoration:underline;text-underline-offset:4px}.company-return{padding:2rem 0;border-top:1px solid #344a54;background:#111f27}.company-return .shell{display:flex;gap:2rem;justify-content:space-between;flex-wrap:wrap}.company-return a{color:#a7e2ed;text-decoration:none;font-size:.87rem;font-weight:750}.company-return a:hover{text-decoration:underline}</style>
