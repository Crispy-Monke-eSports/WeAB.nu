---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {companies} from '../../data/companies';
import {projects} from '../../data/projects';
import Logo from '../../components/Logo.astro';
export function getStaticPaths(){return companies.map(company=>({params:{slug:company.slug},props:{company}}));}
const {company}=Astro.props;
const relatedProjects = projects.filter(project => project.division === company.name);
---
<BaseLayout title={`${company.name} | WeAB Group`} description={company.overview}>
 <div class="company-theme" style={`--company-accent:${company.accent}`}>
  <section class="company-hero"><div class="shell"><div class="company-crumb"><a href="/verksamheter/">Verksamheter</a> <span>/</span> {company.name}</div><div class="company-hero-grid"><div><div class="eyebrow">{company.kicker}</div><h1>{company.tagline}</h1><p class="lead">{company.overview}</p><div class="hero-tools"><a href="#verksamhet" class="btn company-btn">Om verksamheten ↓</a><a href="/kontakt/" class="btn btn-outline">Kontakta koncernen ↗</a></div></div><div class="logo-plate"><Logo name={company.name} accent={company.accent} size="lg" stacked/><span>{company.status}</span></div></div></div></section>
  <section class="company-photo"><div class="shell"><div class="photo-box">{company.image ? <img src={company.image} alt={company.imageAlt} /> : <div class="no-photo"><img src={`/logos/${company.slug}.svg`} width="174" height="97" alt="" /><strong>{company.name}</strong></div>}</div></div></section>
  <section id="verksamhet" class="section"><div class="shell split-layout"><div><div class="eyebrow">VÅRT UPPDRAG</div><h2>En bransch. En vinnare.</h2><p class="lead">{company.description}</p></div><div class="facts"><h3>Verksamhetsöversikt</h3>{company.facts.map(f=><div><span>{f.label}</span><strong>{f.value}</strong></div>)}<div><span>Verksamhetsstatus</span><strong>{company.status}</strong></div><div><span>Plats</span><strong>{company.location}</strong></div></div></div></section>
  <section class="section section--dark"><div class="shell"><div class="eyebrow">VÅRA KOMPETENSER</div><h2>Det vi gör bäst.</h2><div class="service-grid">{company.services.map((service,i)=><div><span>{String(i+1).padStart(2,'0')}</span><h3>{service}</h3><span class="arrow" aria-hidden="true">↗</span></div>)}</div></div></section>
  {company.secondaryImage && <section class="section"><div class="shell split-layout"><div class="image-frame secondary-image"><img src={company.secondaryImage} alt={company.secondaryAlt} loading="lazy" /></div><div><div class="eyebrow">DOKUMENTERAD VERKSAMHET</div><h2>Vi lämnar inget åt slumpen.</h2><p>Inte resurserna. Inte invånarna. Framför allt inte vinsten.</p><a href="/projekt/" class="link-arrow">Se fler anläggningar ↗</a></div></div></section>}
  {relatedProjects.length > 0 && <section class="section company-projects"><div class="shell">
    <div class="section-heading"><div><div class="eyebrow">VÅRA ANLÄGGNINGAR</div><h2>Det här är vad vi kallar framsteg.</h2></div><a class="link-arrow" href="/projekt/">Alla anläggningar ↗</a></div>
    <div class="company-project-grid">{relatedProjects.map(project => <a class="company-project" href={`/projekt/#${project.id}`}>
      <div class="image-frame"><img src={project.image} alt={project.alt} loading="lazy" /></div>
      <div class="company-project-info"><span class="small-caps">{project.category} · {project.stage}</span><h3>{project.name}</h3><p>{project.description}</p></div>
    </a>)}</div>
  </div></section>}
  <section class="company-cta"><div class="shell"><span class="eyebrow">THE WE GROUP</span><h2>WeAB. Där varje verksamhet räknas.</h2><a class="btn company-btn" href="/verksamheter/">Tillbaka till våra verksamheter ↗</a></div></section>
 </div>
</BaseLayout>
<style>
.company-projects{background:#111e27;border-top:1px solid #263944}.company-project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.company-project{background:#182731;border:1px solid #334550;text-decoration:none;display:block}.company-project:hover{border-color:var(--company-accent)}.company-project .image-frame{height:235px;border:0;border-radius:0}.company-project .image-frame img{height:100%}.company-project-info{padding:1.2rem 1.4rem}.company-project-info h3{margin:.65rem 0}.company-project-info p{font-size:.84rem;margin:0}.company-theme #verksamhet{scroll-margin-top:90px}@media(max-width:650px){.company-project-grid{grid-template-columns:1fr}.company-project .image-frame{height:220px}}
.company-theme{--cyan:var(--company-accent)}.company-hero{padding:2rem 0 5rem;background:radial-gradient(circle at 95% 40%,color-mix(in srgb,var(--company-accent) 20%,transparent),transparent 40%),#0d1922;border-bottom:1px solid #32424d}.company-crumb{font-size:.77rem;color:#8ba3b2;margin-bottom:5rem}.company-crumb a{color:#bfcbd2;text-decoration:none}.company-crumb span{margin:0 .6rem}.company-hero-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(270px,.8fr);align-items:center;gap:3rem}.company-hero h1{font-size:clamp(2.7rem,6vw,5.1rem)}.company-hero .lead{max-width:700px}.company-hero .eyebrow{color:var(--company-accent)}.hero-tools{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem}.company-btn{background:var(--company-accent);color:#fff}.logo-plate{background:linear-gradient(145deg,#1a2a33,#111e26);border:1px solid #40515b;aspect-ratio:1;max-width:330px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.8rem;margin-left:auto;width:100%}.logo-plate>span{font-size:.65rem;letter-spacing:.18em;color:#91aab7;text-transform:uppercase}.company-photo{background:#101b23}.photo-box{height:min(53vw,470px);min-height:280px;margin-top:-1px;overflow:hidden}.photo-box img{width:100%;height:100%;object-fit:cover}.no-photo{height:100%;width:100%;background:repeating-linear-gradient(35deg,#172730,#172730 24px,#1d303a 25px,#1d303a 27px);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.8rem}.no-photo img{width:min(55%,300px);height:auto;image-rendering:pixelated}.no-photo strong{font-size:1.5rem}.no-photo small{letter-spacing:.14em;font-size:.66rem;color:#b8c5ce}.facts{background:#182731;border:1px solid #34454f;padding:2rem}.facts h3{margin-bottom:1.7rem}.facts div{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-top:1px solid #354651;font-size:.82rem}.facts span{color:#94a9b7}.facts strong{text-align:right}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:2rem}.service-grid>div{border:1px solid #35464e;min-height:170px;padding:1.5rem;background:#172630;position:relative}.service-grid span{color:var(--company-accent);font-size:.75rem;font-weight:800}.service-grid h3{margin:1rem 0}.service-grid .arrow{position:absolute;right:1.5rem;top:1.5rem;color:#9eafba}.secondary-image{min-height:450px}.secondary-image img{height:100%}.company-cta{padding:5rem 0;background:linear-gradient(90deg,color-mix(in srgb,var(--company-accent) 25%,#0e1a21),#101b23)}.company-cta h2{max-width:750px}.company-cta .eyebrow{color:#efffff}@media(max-width:800px){.company-hero-grid{grid-template-columns:1fr}.logo-plate{margin-left:0;max-width:210px;aspect-ratio:1}.company-crumb{margin-bottom:2.5rem}.service-grid{grid-template-columns:1fr}.photo-box{height:310px}}
</style>
