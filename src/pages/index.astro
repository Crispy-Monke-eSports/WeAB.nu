---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyCard from '../components/CompanyCard.astro';
import {companies} from '../data/companies';
import {projects, featuredProjectIds} from '../data/projects';
import { publications, publicationFormatLabels } from '../data/publications.ts';
import {arenaPhotos} from '../data/arena';
import { chiefExecutive } from '../data/leadership';
const featuredProjects = featuredProjectIds.flatMap(id => {
  const project = projects.find(item => item.id === id);
  return project ? [project] : [];
});
const companySlugByName = Object.fromEntries(companies.map(company => [company.name, company.slug]));
const latestReleases = publications.filter(article => article.format === 'pressmeddelande').slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <img class="hero-image" src="/images/weab-cyan-building.webp" alt="Cyanfärgad företagsbyggnad med monumental vit figur" fetchpriority="high"/>
    <div class="hero-shade"></div>
    <div class="shell hero-content">
      <h1>En bättre värld.<br/><em>På våra villkor.</em></h1>
      <p>WeAB utvecklar och driver samhällsbärande verksamheter inom produktion, logistik, transport, fastigheter och tjänster. Vi skapar långsiktigt värde genom att göra varje led i ekonomin till en del av samma koncern.</p>
      <div class="hero-actions"><a href="/verksamheter/" class="btn">Utforska koncernen <span aria-hidden="true">↗</span></a><a href="/koncernen/" class="btn btn-outline">Lär känna WeAB</a></div>
    </div>
    <div class="hero-foot"><span>WEAB · THE WE GROUP</span><span>EN KONCERN. ALLA LÖSNINGAR.</span></div>
  </section>

  <aside class="company-register" aria-label="Koncernregister">
    <div class="shell company-register__inner">
      <span class="small-caps">WEAB GROUP / KONCERNÖVERSIKT</span>
      <p><strong>{companies.length} dotterbolag.</strong> Från industriell produktion till infrastruktur, handel och samhällsservice. Samordnade för långsiktigt värdeskapande.</p>
      <a href="/verksamheter/" class="link-arrow">Bläddra i registret <span aria-hidden="true">↗</span></a>
    </div>
  </aside>

  <section class="corporate-facts" aria-label="Koncernen i korthet"><div class="shell facts-row">
    <div><strong>{companies.length}</strong><span>Dotterbolag</span></div>
    <div><strong>1</strong><span>Gemensam koncernstrategi</span></div>
    <div><strong>24/7</strong><span>Handelsverksamhet</span></div>
    <a href="/koncernen/">Koncernen i korthet ↗</a>
  </div></section>

  <section class="section"><div class="shell">
    <div class="split-layout intro">
      <div><span class="small-caps">OM WEAB GROUP</span><h2>En integrerad koncern med långsiktigt perspektiv.</h2></div>
      <div><p class="lead">WeAB är en vertikalt integrerad företagsgrupp som samlar produktion, infrastruktur och invånarnära tjänster under en och samma vision.</p><p>Våra verksamheter är utformade för att vara beroende av varandra – från den första resursen till den sista transaktionen. Det ger kunderna ett sammanhållet erbjudande och oss en ovanligt tydlig marknadsposition.</p><a class="link-arrow" href="/koncernen/">Läs om koncernen <span>↗</span></a></div>
    </div>
  </div></section>

  <section class="section section--dark"><div class="shell">
    <div class="section-heading"><div><h2>Ett ekosystem.<br/>Ett ägarskap.</h2></div></div>
    <div class="card-grid">{companies.map(company=><CompanyCard company={company}/>)}</div>
  </div></section>

  <section class="section"><div class="shell split-layout pipeline">
    <div class="image-frame pipeline-image"><img src="/images/section-1-overview.webp" alt="Överblick över Sektion 1 med järnfarm, produktionsbyggnader, mobgrinder och räls" loading="lazy"/></div>
    <div><h2>Från första resurs till sista transaktion.</h2><p>Vi producerar det du behöver, lagrar det du äger och transporterar det du köper. Sedan säljer vi det gärna till dig igen.</p>
      <div class="pipeline-steps"><div><b>01</b><strong>Producera</strong><span>WeKill</span></div><div><b>02</b><strong>Sortera</strong><span>WeSort</span></div><div><b>03</b><strong>Hantera</strong><span>WeBox</span></div><div><b>04</b><strong>Transportera</strong><span>WeTravel</span></div></div><a href="/strategi/" class="link-arrow" style="margin-top:1.4rem">Läs om vår affärsmodell ↗</a>
    </div>
  </div></section>

  <section class="section section--dark"><div class="shell">
    <div class="section-heading"><div><h2>Byggt för att bestå.</h2></div><a href="/verksamheter/" class="link-arrow">Utforska verksamheterna ↗</a></div>
    <div class="featured-grid">{featuredProjects.map((project)=><a class="featured" href={`/verksamheter/${companySlugByName[project.division]}/#anlaggning-${project.id}`}><div class="image-frame"><img src={project.image} alt={project.alt} loading="lazy"/></div><div class="featured-info"><span>{project.division} · {project.category}</span><h3>{project.name}</h3><span aria-hidden="true">↗</span></div></a>)}</div>
  </div></section>

  <section class="section responsible-section"><div class="shell split-layout">
    <div><span class="small-caps">HÅLLBARHET OCH SAMHÄLLSANSVAR</span><h2>Framsteg som gör avtryck.</h2><p class="lead">Vår hållbarhetsstrategi utgår från effektiv användning av naturens resurser, trygg samhällsplanering och gemensamma koncernstandarder.</p><p>Vi tror på att varje tillgång ska bidra till framtiden. Därför arbetar vi för att även tidigare oexploaterade miljöer ska få en tydlig plats i värdekedjan.</p><a href="/hallbarhet/" class="btn btn-outline">Läs om vårt hållbarhetsarbete ↗</a></div>
    <div class="image-frame responsible-image"><img src="/images/wekill-farms.webp" width="1440" height="810" alt="Sammanhängande produktionsanläggningar med omfattande resursinfrastruktur" loading="lazy" /></div>
  </div></section>

  <section class="arena-spotlight" aria-labelledby="arena-spotlight-heading">
    <div class="shell arena-spotlight__grid">
      <div class="arena-spotlight__copy">
        <h2 id="arena-spotlight-heading">Byarnas ära står på spel.</h2>
        <p class="lead">I huvudstadens stora arena möts bybor från olika distrikt. Var och en tävlar för att vinna ära till sin hemby. Koncernen tillhandahåller läktarna – och tar gärna åt sig äran för arrangemanget.</p>
        <a class="btn btn-outline" href="/arena/">Besök arenan <span aria-hidden="true">↗</span></a>
      </div>
      <a class="arena-spotlight__image" href="/arena/" aria-label="Se bilder från Huvudstadens arena">
        <img src={arenaPhotos[0].src} alt={arenaPhotos[0].alt} width="1440" height="810" loading="lazy" decoding="async"/>
        <span>HUVUDSTADENS ARENA <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </section>

  <section class="values-banner"><div class="shell"><h2>Valfrihet är bra.<br/><em>Samordning är bättre.</em></h2><p>Vissa kallar det monopol. Vi kallar det kundförenkling.</p><a href="/investerare/" class="btn btn-outline">Investerarrelationer ↗</a></div></section>

  <section class="section"><div class="shell"><div class="section-heading"><div><h2>Senaste från koncernen</h2></div><a href="/press/" class="link-arrow">Alla pressmeddelanden ↗</a></div>
    <div class="news-grid">{latestReleases.map(article=><a href={`/nyheter/${article.slug}/`} class="news-card"><div class="image-frame"><img src={article.image} alt={article.alt} loading="lazy"/></div><h3>{article.title}</h3><span class="small-caps">{publicationFormatLabels[article.format]}</span><p>{article.summary}</p><span class="news-more">Läs artikeln ↗</span></a>)}</div>
  </div></section>
  <section class="ceo-note"><div class="shell ceo-note__inner">
    <div><span class="small-caps">LEDNINGENS PERSPEKTIV</span><blockquote>Vår främsta styrka är att vi kan erbjuda samhället ett valfritt antal alternativ, så länge samtliga tillhör oss.</blockquote><p>{chiefExecutive.name} · Verkställande direktör · Uttalande förmedlat av huvudkontoret</p></div>
    <a href="/bolagsstyrning/" class="btn btn-outline">Vår ledning och bolagsstyrning ↗</a>
  </div></section>
</BaseLayout>
<style>
.corporate-facts{border-bottom:1px solid #304752;background:#10212c}.facts-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;align-items:center;gap:1.2rem;padding-block:1.5rem}.facts-row>div{border-right:1px solid #35515e;display:grid;gap:.4rem}.facts-row strong{font-size:1.8rem;letter-spacing:-.04em}.facts-row span{font-size:.73rem;color:#a9c2cd}.facts-row>a{font-size:.8rem;color:#9ce3ee;font-weight:800}.responsible-section{background:#10232a}.responsible-image{min-height:380px}.responsible-image img{height:100%}.ceo-note{padding:5rem 0;background:#152936;border-top:1px solid #355261}.ceo-note__inner{display:flex;justify-content:space-between;align-items:center;gap:3rem}.ceo-note blockquote{font-size:clamp(1.35rem,2.5vw,2.15rem);max-width:830px;line-height:1.35;font-weight:750;margin:1.1rem 0}.ceo-note p{font-size:.76rem}.ceo-note .btn{flex-shrink:0}@media(max-width:950px){.facts-row{grid-template-columns:repeat(3,minmax(0,1fr))}.facts-row>a{grid-column:1/-1}.ceo-note__inner{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.facts-row{grid-template-columns:1fr 1fr}.facts-row>div{min-height:70px}.facts-row>div:nth-child(3){border-right:0}.responsible-image{min-height:220px}}
.hero{position:relative;min-height:min(760px,83vh);display:flex;align-items:center;overflow:hidden;background:#13222a}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;filter:saturate(.7) brightness(.72)}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,15,22,.97) 0%,rgba(5,15,22,.86) 33%,rgba(5,15,22,.24) 100%),linear-gradient(0deg,rgba(5,15,22,.8),transparent 45%)}.hero-content{position:relative;z-index:1;padding:6rem 0 8.5rem}.hero-content h1{max-width:980px;margin:0}.hero-content h1 em{font-style:normal;color:#70dbeb}.hero-content p{color:#d0dbe0;max-width:620px;font-size:1.08rem;margin:1.6rem 0 2rem}.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap}.hero-foot{position:absolute;z-index:1;bottom:0;left:0;width:100%;display:flex;justify-content:space-between;padding:1.4rem max(calc((100vw - var(--max))/2),1.7rem);border-top:1px solid #ffffff36;font-size:.63rem;letter-spacing:.17em;color:#c4d0d5;font-weight:700}.company-register{background:#0f1d26;border-bottom:1px solid #2b3d47}.company-register__inner{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:2rem;align-items:center;padding-block:1.5rem}.company-register p{margin:0;color:#cad8df;font-size:.92rem}.company-register strong{color:white}.company-register .small-caps{white-space:nowrap}.intro{align-items:start}.pipeline-image{min-height:550px;height:100%}.pipeline-image img{height:100%}.pipeline-steps{border-top:1px solid #33444f;margin-top:2rem}.pipeline-steps>div{display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:.8rem;padding:1.05rem 0;border-bottom:1px solid #33444f}.pipeline-steps b{color:var(--cyan);font-size:.7rem}.pipeline-steps strong{font-size:.95rem}.pipeline-steps span{color:#a6b9c3;font-size:.8rem}.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}.featured{text-decoration:none}.featured .image-frame{height:230px}.featured .image-frame img{height:100%}.featured-info{padding:1.1rem 0;position:relative}.featured-info span:first-child{font-size:.65rem;letter-spacing:.14em;color:#96b0bc;text-transform:uppercase}.featured-info h3{margin:.55rem 0}.featured-info span:last-child{position:absolute;right:0;bottom:1.5rem;color:#79dbe6}.arena-spotlight{padding:6rem 0;background:#0c1a23;border-block:1px solid #28434f}.arena-spotlight__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:4rem;align-items:center}.arena-spotlight__copy h2{font-size:clamp(2.15rem,3.8vw,3.7rem)}.arena-spotlight__copy p.lead{font-size:1.05rem}.arena-spotlight__copy .btn{margin-top:.6rem}.arena-spotlight__image{display:block;text-decoration:none;border:1px solid #385360;overflow:hidden;background:#11232d}.arena-spotlight__image img{width:100%;aspect-ratio:16/9;object-fit:cover}.arena-spotlight__image>span{display:flex;justify-content:space-between;gap:1rem;padding:1rem 1.3rem;font-size:.7rem;font-weight:800;letter-spacing:.15em;color:#c7e9ec}.arena-spotlight__image:hover,.arena-spotlight__image:focus-visible{border-color:#8ce9f5}.values-banner{background:radial-gradient(circle at 80% 50%,#175767 0%,#102630 38%,#09171f 80%);border-block:1px solid #304954;padding:6.5rem 0}.values-banner h2{font-size:clamp(2.3rem,5vw,5.2rem);margin:.25rem 0 1rem}.values-banner em{font-style:normal;color:#65d8e9}.values-banner p{max-width:550px;margin-bottom:1.8rem}.news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.4rem}.news-card{text-decoration:none}.news-card .image-frame{height:200px;margin-bottom:1.2rem}.news-card .image-frame img{height:100%}.news-card h3{margin:.7rem 0}.news-card p{font-size:.85rem}.news-more{font-size:.8rem;font-weight:800;color:#7cddea}@media(max-width:800px){.arena-spotlight__grid{grid-template-columns:1fr;gap:2rem}.arena-spotlight{padding:4rem 0}.hero{min-height:640px}.hero-image{object-position:57% center}.hero-shade{background:linear-gradient(90deg,#07131ae8,#07131a9c),linear-gradient(0deg,#07131ae0,transparent)}.company-register__inner{grid-template-columns:1fr;gap:.65rem}.featured-grid,.news-grid{grid-template-columns:1fr 1fr}.pipeline-image{min-height:350px}}@media(max-width:550px){.hero-content{padding:5rem 0 6rem}.hero-content p{font-size:1rem}.hero-foot{font-size:.53rem;gap:1rem}.featured-grid,.news-grid{grid-template-columns:1fr}}
.featured:hover .image-frame,.featured:focus-visible .image-frame,.news-card:hover .image-frame,.news-card:focus-visible .image-frame{border-color:#80dfed}
.featured:hover h3,.news-card:hover h3{text-decoration:underline;text-decoration-color:#80dfed;text-underline-offset:.2em}
</style>
