---
import BaseLayout from '../layouts/BaseLayout.astro';
import {companies} from '../data/companies';
import {projects, featuredProjectIds} from '../data/projects';
import { publications, publicationFormatLabels } from '../data/publications.ts';
import {arenaPhotos} from '../data/arena';
import { chiefExecutive } from '../data/leadership';
const featuredProjects = featuredProjectIds.flatMap(id => {
  const project = projects.find(item => item.id === id);
  return project ? [project] : [];
});
const companySlugByName = Object.fromEntries(companies.map(company => [company.name, company.slug]));
const latestReleases = publications.filter(article => article.format === 'pressmeddelande').slice(0, 3);
const releaseDate = (date: string) => new Intl.DateTimeFormat('sv-SE', {day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));
---
<BaseLayout>
  <section class="hero">
    <img class="hero-image" src="/images/weab-cyan-building.webp" alt="Cyanfärgad företagsbyggnad med monumental vit figur" fetchpriority="high"/>
    <div class="hero-shade"></div>
    <div class="shell hero-content">
      <h1>En bättre värld.<br/><em>På våra villkor.</em></h1>
      <p>WeKill sköter produktionen, WeSort fördelar resurserna och WeBox tar hand om lagret. WeTravel binder ihop anläggningarna. Övriga koncernbolag ser till att även arbete, handel och offentliga byggnader ingår i samma ekonomi.</p>
      <a href="/verksamheter/" class="btn">Se koncernens verksamheter <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section"><div class="shell">
    <div class="split-layout intro">
      <div><h2>En organisation för nästan allt.</h2></div>
      <div><p class="lead">I Sektion 1 ligger flera av koncernens verksamheter nära varandra. Materialen hämtas, sorteras, förvaras och säljs vidare utan att behöva lämna WeAB.</p><p>Modellen används också för bostäder, transporter och kommunala fastigheter. Den som bor eller handlar i området möter därför ofta samma ägare flera gånger om dagen.</p><a class="link-arrow" href="/strategi/">Så hänger bolagen ihop ↗</a></div>
    </div>
  </div></section>

  <section class="section section--dark operating-section"><div class="shell">
    <div class="section-heading"><h2>Koncernbolagen</h2><p>Nio verksamheter med egna anläggningar, uppdrag och kontaktvägar.</p></div>
    <div class="operating-directory">{companies.map(company => <a href={`/verksamheter/${company.slug}/`} class="operating-row"><strong>{company.name}</strong><span>{company.kicker}</span><span class="operating-arrow" aria-hidden="true">↗</span></a>)}</div>
    <a class="link-arrow" href="/verksamheter/">Verksamheternas adresser, status och anläggningar ↗</a>
  </div></section>

  <section class="section"><div class="shell split-layout pipeline">
    <div class="image-frame pipeline-image"><img src="/images/section-1-overview.webp" alt="Överblick över Sektion 1 med järnfarm, produktionsbyggnader, mobgrinder och räls" loading="lazy"/></div>
    <div><h2>Fyra led mellan farm och handel.</h2><p>Sektion 1 visar hur WeKill, WeSort och WeBox redan delar materialflöden. WeTravel ansluter området till övriga verksamheter. Kunden behöver sällan veta var ett bolag slutar och nästa börjar.</p>
      <div class="pipeline-steps"><div><b>01</b><strong>Producera</strong><span>WeKill</span></div><div><b>02</b><strong>Sortera</strong><span>WeSort</span></div><div><b>03</b><strong>Hantera</strong><span>WeBox</span></div><div><b>04</b><strong>Transportera</strong><span>WeTravel</span></div></div><a href="/strategi/" class="link-arrow" style="margin-top:1.4rem">Läs om vår affärsmodell ↗</a>
    </div>
  </div></section>

  <section class="section section--dark"><div class="shell">
    <div class="section-heading"><h2>Anläggningar i drift och utveckling</h2><a href="/verksamheter/" class="link-arrow">Fler anläggningar ↗</a></div>
    <div class="featured-grid">{featuredProjects.map((project)=><a class="featured" href={`/verksamheter/${companySlugByName[project.division]}/#anlaggning-${project.id}`}><div class="image-frame"><img src={project.image} alt={project.alt} loading="lazy"/></div><div class="featured-info"><h3>{project.name}</h3><span aria-hidden="true">↗</span></div></a>)}</div>
  </div></section>

  <section class="section responsible-section"><div class="shell split-layout">
    <div><h2>Vår syn på resursanvändning.</h2><p class="lead">WeKill samlar den industriella produktionen i särskilda anläggningar. Material som tidigare uppstod utan planering kan nu redovisas som en del av koncernens försörjning.</p><p>Vi räknar även exploaterad mark som ett framsteg när den tas i bruk. Några jämförbara miljöresultat har ännu inte publicerats.</p><a href="/hallbarhet/" class="link-arrow">Läs koncernens hållbarhetsredovisning ↗</a></div>
    <div class="image-frame responsible-image"><img src="/images/wekill-farms.webp" width="1440" height="810" alt="Sammanhängande produktionsanläggningar med omfattande resursinfrastruktur" loading="lazy" /></div>
  </div></section>

  <section class="arena-spotlight" aria-labelledby="arena-spotlight-heading">
    <div class="shell arena-spotlight__grid">
      <div class="arena-spotlight__copy">
        <h2 id="arena-spotlight-heading">Byarnas ära står på spel.</h2>
        <p class="lead">I huvudstadens stora arena möts bybor från olika distrikt. Var och en tävlar för att vinna ära till sin hemby. Koncernen tillhandahåller läktarna – och tar gärna åt sig äran för arrangemanget.</p>
        <a class="btn btn-outline" href="/arena/">Besök arenan <span aria-hidden="true">↗</span></a>
      </div>
      <a class="arena-spotlight__image" href="/arena/" aria-label="Se bilder från Huvudstadens arena">
        <img src={arenaPhotos[0].src} alt={arenaPhotos[0].alt} width="1440" height="810" loading="lazy" decoding="async"/>
        <span>HUVUDSTADENS ARENA <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </section>

  <section class="section home-press"><div class="shell">
    <div class="section-heading"><h2>Senaste pressmeddelandena</h2><a href="/press/" class="link-arrow">Pressarkivet ↗</a></div>
    <ol class="home-press__list">{latestReleases.map(article => <li><a href={`/nyheter/${article.slug}/`}><div><h3>{article.title}</h3><p>{article.summary}</p></div><span class="home-press__meta"><time datetime={article.publishedAt}>{releaseDate(article.publishedAt)}</time><span>{article.issuer?.name ?? publicationFormatLabels[article.format]}</span></span><span class="home-press__arrow" aria-hidden="true">↗</span></a></li>)}</ol>
  </div></section>
  <section class="ceo-note"><div class="shell ceo-note__inner">
    <div><blockquote>Konkurrens ger konsumenten fler alternativ. Det kräver samtidigt att någon fattar fler beslut. Vi arbetar på en mer samordnad lösning.</blockquote><p>{chiefExecutive.name} · Verkställande direktör · Uttalande förmedlat av huvudkontoret</p></div>
    <a href="/bolagsstyrning/" class="btn btn-outline">Vår ledning och bolagsstyrning ↗</a>
  </div></section>
</BaseLayout>
<style>
.responsible-section{background:#10232a}.responsible-image{min-height:380px}.responsible-image img{height:100%}.ceo-note{padding:5rem 0;background:#152936;border-top:1px solid #355261}.ceo-note__inner{display:flex;justify-content:space-between;align-items:center;gap:3rem}.ceo-note blockquote{font-size:clamp(1.35rem,2.5vw,2.15rem);max-width:830px;line-height:1.35;font-weight:750;margin:1.1rem 0}.ceo-note p{font-size:.76rem}.ceo-note .btn{flex-shrink:0}@media(max-width:950px){.ceo-note__inner{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.responsible-image{min-height:220px}}
.hero{position:relative;min-height:min(760px,83vh);display:flex;align-items:center;overflow:hidden;background:#13222a}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;filter:saturate(.7) brightness(.72)}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,15,22,.97) 0%,rgba(5,15,22,.86) 33%,rgba(5,15,22,.24) 100%),linear-gradient(0deg,rgba(5,15,22,.8),transparent 45%)}.hero-content{position:relative;z-index:1;padding:6rem 0 8.5rem}.hero-content h1{max-width:980px;margin:0}.hero-content h1 em{font-style:normal;color:#70dbeb}.hero-content p{color:#d0dbe0;max-width:620px;font-size:1.08rem;margin:1.6rem 0 2rem}.intro{align-items:start}.pipeline-image{min-height:550px;height:100%}.pipeline-image img{height:100%}.pipeline-steps{border-top:1px solid #33444f;margin-top:2rem}.pipeline-steps>div{display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:.8rem;padding:1.05rem 0;border-bottom:1px solid #33444f}.pipeline-steps b{color:var(--cyan);font-size:.7rem}.pipeline-steps strong{font-size:.95rem}.pipeline-steps span{color:#a6b9c3;font-size:.8rem}.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}.featured{text-decoration:none}.featured .image-frame{height:230px}.featured .image-frame img{height:100%}.featured-info{padding:1.1rem 0;position:relative}.featured-info span:first-child{font-size:.65rem;letter-spacing:.14em;color:#96b0bc;text-transform:uppercase}.featured-info h3{margin:.55rem 0}.featured-info span:last-child{position:absolute;right:0;bottom:1.5rem;color:#79dbe6}.arena-spotlight{padding:6rem 0;background:#0c1a23;border-block:1px solid #28434f}.arena-spotlight__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:4rem;align-items:center}.arena-spotlight__copy h2{font-size:clamp(2.15rem,3.8vw,3.7rem)}.arena-spotlight__copy p.lead{font-size:1.05rem}.arena-spotlight__copy .btn{margin-top:.6rem}.arena-spotlight__image{display:block;text-decoration:none;border:1px solid #385360;overflow:hidden;background:#11232d}.arena-spotlight__image img{width:100%;aspect-ratio:16/9;object-fit:cover}.arena-spotlight__image>span{display:flex;justify-content:space-between;gap:1rem;padding:1rem 1.3rem;font-size:.7rem;font-weight:800;letter-spacing:.15em;color:#c7e9ec}.arena-spotlight__image:hover,.arena-spotlight__image:focus-visible{border-color:#8ce9f5}@media(max-width:800px){.arena-spotlight__grid{grid-template-columns:1fr;gap:2rem}.arena-spotlight{padding:4rem 0}.hero{min-height:640px}.hero-image{object-position:57% center}.hero-shade{background:linear-gradient(90deg,#07131ae8,#07131a9c),linear-gradient(0deg,#07131ae0,transparent)}.featured-grid,.pipeline-image{min-height:350px}}@media(max-width:550px){.hero-content{padding:5rem 0 6rem}.hero-content p{font-size:1rem}.featured-grid,}
.featured:hover .image-frame,.featured:focus-visible .image-frame,
.featured:hover h3,
.operating-section .section-heading{align-items:end}.operating-directory{display:grid;grid-template-columns:1fr 1fr;column-gap:3rem;margin:0 0 2rem}.operating-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr) 20px;align-items:baseline;gap:1rem;padding:1.15rem 0;border-top:1px solid #40545e;text-decoration:none;min-width:0}.operating-row strong{font-size:1.08rem}.operating-row>span:nth-child(2){font-size:.74rem;color:#a4b9c3}.operating-arrow{color:#83dce7}.operating-row:hover strong,.operating-row:focus-visible strong{text-decoration:underline;text-underline-offset:3px}.home-press__list{list-style:none;margin:0;padding:0}.home-press__list li{border-top:1px solid #3b505d}.home-press__list li:last-child{border-bottom:1px solid #3b505d}.home-press__list li>a{display:grid;grid-template-columns:minmax(0,1fr) 180px 24px;align-items:start;gap:2rem;padding:1.5rem 0;text-decoration:none}.home-press__list h3{font-size:1.22rem;margin:0 0 .65rem;max-width:65ch}.home-press__list p{margin:0;font-size:.88rem;max-width:70ch}.home-press__meta{display:grid;gap:.5rem;font-size:.78rem;color:#abc3cc}.home-press__arrow{color:#86e0eb}.home-press__list a:hover h3{text-decoration:underline;text-underline-offset:3px}.ceo-note__inner{border-top:1px solid #4a6874;padding-top:1.6rem}.ceo-note{background:#0d1e28;padding:3.5rem 0}.responsible-section{background:#11212a}@media(max-width:850px){.operating-directory{grid-template-columns:1fr}.home-press__list li>a{grid-template-columns:1fr 25px;gap:1rem}.home-press__meta{grid-row:2;display:flex;flex-wrap:wrap;gap:1rem}.home-press__arrow{grid-column:2;grid-row:1}}@media(max-width:520px){.operating-row{grid-template-columns:1fr 20px;gap:.3rem}.operating-row>span:nth-child(2){grid-column:1;grid-row:2}.operating-arrow{grid-column:2;grid-row:1}}
</style>
