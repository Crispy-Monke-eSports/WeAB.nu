---
import BaseLayout from '../layouts/BaseLayout.astro';
import { imageDimensions } from '../data/imageDimensions';
import {companies} from '../data/companies';
import {projects, featuredProjectIds} from '../data/projects';
import { publications, publicationFormatLabels } from '../data/publications.ts';
import {arenaPhotos} from '../data/arena';
import { chiefExecutive } from '../data/leadership';
const featuredProjects = featuredProjectIds.flatMap(id => {
  const project = projects.find(item => item.id === id);
  return project ? [project] : [];
});
const companySlugByName = Object.fromEntries(companies.map(company => [company.name, company.slug]));
const latestReleases = publications.filter(article => article.format === 'pressmeddelande').slice(0, 3);
const releaseDate = (date: string) => new Intl.DateTimeFormat('sv-SE', {day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));
---
<BaseLayout>
  <section class="hero">
    <img class="hero-image" src="/images/weab-cyan-building.webp" alt="Cyanfärgad företagsbyggnad med monumental vit figur" width="1800" height="1013" fetchpriority="high"/>
    <div class="hero-shade"></div>
    <div class="shell hero-content">
      <h1>En bättre värld.<br/><em>På våra villkor.</em></h1>
      <p>WeKill sköter produktionen, WeSort fördelar resurserna och WeBox tar hand om lagret. WeTravel binder ihop anläggningarna. Övriga koncernbolag ser till att även arbete, handel och offentliga byggnader ingår i samma ekonomi.</p>
      <a href="/verksamheter/" class="btn">Se koncernens verksamheter <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section"><div class="shell">
    <div class="split-layout intro">
      <div><h2>En organisation för nästan allt.</h2></div>
      <div><p class="lead">I Sektion 1 ligger flera av koncernens verksamheter nära varandra. Materialen hämtas, sorteras, förvaras och säljs vidare utan att behöva lämna WeAB.</p><p>Modellen används också för bostäder, transporter och kommunala fastigheter. Den som bor eller handlar i området möter därför ofta samma ägare flera gånger om dagen.</p><a class="link-arrow" href="/strategi/">Så hänger bolagen ihop ↗</a></div>
    </div>
  </div></section>

  <section class="section section--dark operating-section"><div class="shell">
    <div class="section-heading"><h2>Koncernbolagen</h2><p>Nio verksamheter med egna anläggningar, uppdrag och kontaktvägar.</p></div>
    <div class="operating-directory">{companies.map(company => <a href={`/verksamheter/${company.slug}/`} class="operating-row"><strong>{company.name}</strong><span>{company.kicker}</span><span class="operating-arrow" aria-hidden="true">↗</span></a>)}</div>
    <a class="link-arrow" href="/verksamheter/">Verksamheternas adresser, status och anläggningar ↗</a>
  </div></section>

  <section class="section"><div class="shell split-layout pipeline">
    <div class="image-frame pipeline-image"><img src="/images/section-1-overview.webp" alt="Överblick över Sektion 1 med järnfarm, produktionsbyggnader, mobgrinder och räls" width="1440" height="810" loading="lazy"/></div>
    <div><h2>Fyra led mellan farm och handel.</h2><p>Sektion 1 visar hur WeKill, WeSort och WeBox redan delar materialflöden. WeTravel ansluter området till övriga verksamheter. Kunden behöver sällan veta var ett bolag slutar och nästa börjar.</p>
      <div class="pipeline-steps"><div><b>01</b><strong>Producera</strong><span>WeKill</span></div><div><b>02</b><strong>Sortera</strong><span>WeSort</span></div><div><b>03</b><strong>Hantera</strong><span>WeBox</span></div><div><b>04</b><strong>Transportera</strong><span>WeTravel</span></div></div><a href="/strategi/" class="link-arrow" style="margin-top:1.4rem">Läs om vår affärsmodell ↗</a>
    </div>
  </div></section>

  <section class="section section--dark"><div class="shell">
    <div class="section-heading"><h2>Anläggningar i drift och utveckling</h2><a href="/verksamheter/" class="link-arrow">Fler anläggningar ↗</a></div>
    <div class="featured-grid">{featuredProjects.map((project)=><a class="featured" href={`/verksamheter/${companySlugByName[project.division]}/#anlaggning-${project.id}`}><div class="image-frame"><img src={project.image} alt={project.alt} {...imageDimensions(project.image)} loading="lazy"/></div><div class="featured-info"><h3>{project.name}</h3><span aria-hidden="true">↗</span></div></a>)}</div>
  </div></section>

  <section class="section responsible-section"><div class="shell split-layout">
    <div><h2>Vår syn på resursanvändning.</h2><p class="lead">WeKill samlar den industriella produktionen i särskilda anläggningar. Material som tidigare uppstod utan planering kan nu redovisas som en del av koncernens försörjning.</p><p>Vi räknar även exploaterad mark som ett framsteg när den tas i bruk. Några jämförbara miljöresultat har ännu inte publicerats.</p><a href="/hallbarhet/" class="link-arrow">Läs koncernens hållbarhetsredovisning ↗</a></div>
    <div class="image-frame responsible-image"><img src="/images/wekill-farms.webp" width="1800" height="1013" alt="Sammanhängande produktionsanläggningar med omfattande resursinfrastruktur" loading="lazy" /></div>
  </div></section>

  <section class="arena-spotlight" aria-labelledby="arena-spotlight-heading">
    <div class="shell arena-spotlight__grid">
      <div class="arena-spotlight__copy">
        <h2 id="arena-spotlight-heading">Byarnas ära står på spel.</h2>
        <p class="lead">I huvudstadens stora arena möts bybor från olika distrikt. Var och en tävlar för att vinna ära till sin hemby. Koncernen tillhandahåller läktarna – och tar gärna åt sig äran för arrangemanget.</p>
        <a class="btn btn-outline" href="/arena/">Besök arenan <span aria-hidden="true">↗</span></a>
      </div>
      <a class="arena-spotlight__image" href="/arena/" aria-label="Se bilder från Huvudstadens arena">
        <img src={arenaPhotos[0].src} alt={arenaPhotos[0].alt} width="1440" height="810" loading="lazy" decoding="async"/>
        <span>HUVUDSTADENS ARENA <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </section>

  <section class="section home-press"><div class="shell">
    <div class="section-heading"><h2>Senaste pressmeddelandena</h2><a href="/press/" class="link-arrow">Pressarkivet ↗</a></div>
    <ol class="home-press__list">{latestReleases.map(article => <li><a href={`/nyheter/${article.slug}/`}><div><h3>{article.title}</h3><p>{article.summary}</p></div><span class="home-press__meta"><time datetime={article.publishedAt}>{releaseDate(article.publishedAt)}</time><span>{article.issuer?.name ?? publicationFormatLabels[article.format]}</span></span><span class="home-press__arrow" aria-hidden="true">↗</span></a></li>)}</ol>
  </div></section>
  <section class="ceo-note"><div class="shell ceo-note__inner">
    <div><blockquote>Konkurrens ger konsumenten fler alternativ. Det kräver samtidigt att någon fattar fler beslut. Vi arbetar på en mer samordnad lösning.</blockquote><p>{chiefExecutive.name} · Verkställande direktör · Uttalande förmedlat av huvudkontoret</p></div>
    <a href="/bolagsstyrning/" class="btn btn-outline">Vår ledning och bolagsstyrning ↗</a>
  </div></section>
</BaseLayout>
<style>
.hero{position:relative;min-height:clamp(560px,77svh,780px);display:flex;align-items:center;overflow:hidden;background:#13222a}
.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;filter:saturate(.75) brightness(.8)}
.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#07121bf5 0%,#07121bcf 45%,#07121b42 100%)}
.hero-content{position:relative;z-index:1;padding:6rem 0}
.hero-content h1{max-width:980px;margin:0}
.hero-content h1 em{font-style:normal;color:#75dbe8}
.hero-content p{color:#d5e1e6;max-width:630px;font-size:1.08rem;margin:1.6rem 0 1.8rem;line-height:1.7}
.intro{align-items:start}
.operating-directory{display:grid;grid-template-columns:1fr 1fr;column-gap:3rem;margin:0 0 2rem}
.operating-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr) 20px;align-items:baseline;gap:1rem;padding:1.1rem 0;border-top:1px solid #40545e;text-decoration:none;min-width:0}
.operating-row strong{font-size:1.07rem}
.operating-row>span:nth-child(2){font-size:.75rem;color:#a4b9c3;line-height:1.4}
.operating-arrow{color:#83dce7}
.operating-row:hover strong,.operating-row:focus-visible strong{text-decoration:underline;text-underline-offset:3px}
.pipeline-image{min-height:430px;height:100%;margin:0}
.pipeline-image img{height:100%}
.pipeline-steps{border-top:1px solid #3c515b;margin-top:1.8rem}
.pipeline-steps>div{display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:1rem;padding:1rem 0;border-bottom:1px solid #3c515b}
.pipeline-steps b{color:var(--cyan);font-size:.76rem}
.pipeline-steps strong{font-size:.93rem}
.pipeline-steps span{color:#b0c4cd;font-size:.82rem}
.featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.3rem}
.featured{text-decoration:none;min-width:0}
.featured .image-frame{height:220px}
.featured .image-frame img{height:100%}
.featured-info{padding:1rem 0;display:flex;align-items:baseline;justify-content:space-between;gap:1rem}
.featured-info h3{font-size:1.18rem;line-height:1.3;margin:0}
.featured-info>span{color:#81d8e6;font-size:1.2rem}
.featured:hover h3,.featured:focus-visible h3{text-decoration:underline;text-underline-offset:3px}
.responsible-section{background:#111f28}
.responsible-image{min-height:355px}
.responsible-image img{height:100%}
.arena-spotlight{padding:5rem 0;background:#0c1a23;border-block:1px solid #304550}
.arena-spotlight__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:4rem;align-items:center}
.arena-spotlight__copy h2{font-size:clamp(2rem,3.6vw,3.6rem)}
.arena-spotlight__copy p.lead{font-size:1.04rem}
.arena-spotlight__copy .btn{margin-top:.6rem}
.arena-spotlight__image{display:block;text-decoration:none;overflow:hidden;background:#11232d}
.arena-spotlight__image img{width:100%;aspect-ratio:16/9;object-fit:cover}
.arena-spotlight__image>span{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;font-size:.73rem;font-weight:800;letter-spacing:.09em;color:#c7e9ec}
.arena-spotlight__image:hover span,.arena-spotlight__image:focus-visible span{text-decoration:underline}
.home-press__list{list-style:none;margin:0;padding:0}
.home-press__list li{border-top:1px solid #3b505d}
.home-press__list li:last-child{border-bottom:1px solid #3b505d}
.home-press__list li>a{display:grid;grid-template-columns:minmax(0,1fr) 170px 24px;align-items:start;gap:2rem;padding:1.5rem 0;text-decoration:none}
.home-press__list h3{font-size:1.2rem;margin:0 0 .6rem;max-width:65ch}
.home-press__list p{margin:0;font-size:.87rem;max-width:70ch}
.home-press__meta{display:grid;gap:.5rem;font-size:.78rem;color:#b2c6cf}
.home-press__arrow{color:#86e0eb}
.home-press__list a:hover h3{text-decoration:underline;text-underline-offset:3px}
.ceo-note{padding:3.5rem 0;background:#0d1e28;border-top:1px solid #38515f}
.ceo-note__inner{display:flex;justify-content:space-between;align-items:center;gap:3rem}
.ceo-note blockquote{font-size:clamp(1.3rem,2.5vw,2.05rem);line-height:1.4;max-width:790px;font-weight:700;margin:0 0 1rem}
.ceo-note p{font-size:.8rem;margin:0}
.ceo-note .btn{flex-shrink:0}
@media(max-width:950px){.operating-directory{grid-template-columns:1fr}.ceo-note__inner{align-items:flex-start;flex-direction:column}.featured-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.arena-spotlight__grid{grid-template-columns:1fr;gap:2rem}}
@media(max-width:650px){.hero{min-height:590px}.hero-image{object-position:58% center}.hero-shade{background:linear-gradient(90deg,#07121bf0,#07121b9c)}.hero-content{padding:4.5rem 0}.pipeline-image,.responsible-image{min-height:240px}.featured-grid{grid-template-columns:1fr}.home-press__list li>a{grid-template-columns:1fr 24px;gap:1rem}.home-press__meta{grid-column:1;grid-row:2;display:flex;flex-wrap:wrap;gap:1rem}.home-press__arrow{grid-column:2;grid-row:1}.arena-spotlight{padding:3.7rem 0}.operating-row{grid-template-columns:1fr 20px;gap:.3rem}.operating-row>span:nth-child(2){grid-column:1;grid-row:2}.operating-arrow{grid-column:2;grid-row:1}}
</style>
