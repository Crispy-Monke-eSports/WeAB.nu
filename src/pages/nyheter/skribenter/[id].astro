---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { imageAsset, responsiveWidths } from '../../../data/imageAssets';
import { authors, type Author } from '../../../data/authors.ts';
import { authorPublications, publicationFormatLabels } from '../../../data/publications.ts';

export function getStaticPaths() {
  return authors.map(author => ({ params: { id: author.id }, props: { author } }));
}
const { author } = Astro.props as { author: Author };
const stories = authorPublications(author.id);
const dateLabel = (date: string) => new Intl.DateTimeFormat('sv-SE', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
}).format(new Date(`${date}T12:00:00Z`));
---
<BaseLayout
  title={`${author.name} | WeAB Tidningen`}
  description={`Läs ${author.name}s artiklar och lär känna skribentens bakgrund och bevakningsområde.`}
>
  <header class="page-hero">
    <div class="shell author-header">
      <a class="back" href="/nyheter/skribenter/">← Alla skribenter</a>
      <div class="writer">
        <div>
          <h1>{author.name}</h1>
          <p class="writer-role">{author.role} · {stories.length} artiklar</p>
        </div>
      </div>
      <p class="lead">{author.biography}</p>
      <div class="writer-focus">
        <div><h2>Bevakar</h2><p>{author.beat}</p></div>
        <div><h2>Bakgrund</h2><p>{author.background}</p></div>
      </div>
    </div>
  </header>
  <section class="section author-articles">
    <div class="shell">
      <h2>Artiklar av {author.name}</h2>
      <div class="story-grid">
        {stories.map(story => <a class="story" href={`/nyheter/${story.slug}/`}>
          <div class="story-image"><Image src={imageAsset(story.image)} alt={story.alt} layout="constrained" widths={responsiveWidths} sizes="(max-width: 680px) 100vw, 220px" loading="lazy" /></div>
          <h3>{story.title}</h3>
          <p class="meta">{publicationFormatLabels[story.format]} · {dateLabel(story.publishedAt)}</p>
          <p>{story.summary}</p>
          <span class="read">Läs artikeln <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
.author-header{max-width:1050px}
.back{display:inline-block;margin-bottom:2.4rem;color:#a2dfeb;text-decoration:none;font-size:.82rem}
.writer{margin-bottom:1.5rem}
.writer h1{font-size:clamp(2.25rem,5vw,4.5rem);margin:0;overflow-wrap:anywhere}
.writer-role{color:#aac5ce;font-size:.87rem;margin:.7rem 0 0}
.writer-focus{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem;border-top:1px solid #445b65;margin-top:2.5rem;padding-top:1.6rem}
.writer-focus h2{font-size:1.1rem;margin:0 0 .6rem}
.writer-focus p{font-size:.9rem;line-height:1.65;margin:0}
.author-articles{background:#0b1720}
.author-articles>div>h2{font-size:clamp(1.7rem,3vw,2.6rem);margin:0 0 1.5rem}
.story-grid{display:grid;grid-template-columns:1fr;gap:0;border-top:1px solid #415765}
.story{display:grid;grid-template-columns:220px minmax(0,1fr);gap:.4rem 1.8rem;align-items:start;padding:1.5rem 0;border-bottom:1px solid #415765;text-decoration:none;color:inherit}
.story-image{grid-column:1;grid-row:1 / span 4;width:100%;aspect-ratio:16/10;overflow:hidden}
.story-image img{width:100%;height:100%;object-fit:cover}
.story h3{grid-column:2;font-size:1.3rem;line-height:1.3;margin:0}
.story:hover h3,.story:focus-visible h3{text-decoration:underline;text-underline-offset:3px}
.story p{grid-column:2;font-size:.87rem;line-height:1.6;margin:0}
.story .meta{grid-column:2;font-size:.74rem;color:#a8bdc7}
.read{grid-column:2;color:#93dfed;font-size:.8rem;font-weight:750}
@media(max-width:680px){.writer-focus{grid-template-columns:1fr}.story{grid-template-columns:1fr;gap:.65rem}.story-image{grid-column:1;grid-row:auto}.story h3,.story p,.story .meta,.read{grid-column:1}}
</style>
