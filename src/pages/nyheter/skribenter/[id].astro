---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { authors, type Author } from '../../../data/authors.ts';
import { authorPublications, publicationFormatLabels } from '../../../data/publications.ts';

export function getStaticPaths() {
  return authors.map(author => ({ params: { id: author.id }, props: { author } }));
}
const { author } = Astro.props as { author: Author };
const stories = authorPublications(author.id);
const dateLabel = (date: string) => new Intl.DateTimeFormat('sv-SE', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
}).format(new Date(`${date}T12:00:00Z`));
---
<BaseLayout
  title={`${author.name} | WeAB Tidningen`}
  description={`Läs ${author.name}s artiklar och lär känna skribentens ämnesområde och stil.`}
>
  <header class="page-hero">
    <div class="shell author-header">
      <a class="back" href="/nyheter/skribenter/">← Alla skribenter</a>
      <div class="writer">
        <div class="avatar" aria-hidden="true">{author.name.split(' ').map(part => part[0]).slice(0, 2).join('')}</div>
        <div>
          <h1>{author.name}</h1>
          <p class="writer-role">{author.role} · {stories.length} artiklar</p>
        </div>
      </div>
      <p class="lead">{author.biography}</p>
      <div class="writer-focus">
        <div><h2>Bevakar</h2><p>{author.beat}</p></div>
        <div><h2>Skriver så här</h2><p>{author.approach}</p></div>
      </div>
    </div>
  </header>
  <section class="section author-articles">
    <div class="shell">
      <h2>Artiklar av {author.name}</h2>
      <div class="story-grid">
        {stories.map(story => <a class="story" href={`/nyheter/${story.slug}/`}>
          <div class="story-image"><img src={story.image} alt={story.alt} loading="lazy" /></div>
          <h3>{story.title}</h3>
          <p class="meta">{publicationFormatLabels[story.format]} · {dateLabel(story.publishedAt)}</p>
          <p>{story.summary}</p>
          <span class="read">Läs artikeln <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .author-header{max-width:1080px}
  .back{display:inline-block;margin-bottom:2.5rem;color:#9dddea;text-decoration:none;font-size:.82rem}
  .writer{display:flex;align-items:center;gap:1.5rem;margin-bottom:1.5rem}
  .writer h1{font-size:clamp(2.2rem,5vw,4.4rem);margin:0;overflow-wrap:anywhere}
  .avatar{display:grid;place-items:center;background:#284753;color:#d6f0f3;border:1px solid #60808e;width:100px;height:100px;flex:none;font-size:1.6rem;letter-spacing:.12em;font-weight:700}
  .writer-role{color:#a3c3cc;font-size:.87rem;margin:.7rem 0 0}
  .writer-focus{display:grid;grid-template-columns:1fr 1fr;gap:2.2rem;border-top:1px solid #4b626d;margin-top:2.4rem;padding-top:1.6rem}
  .writer-focus h2{font-size:1.1rem;margin:0 0 .6rem}
  .writer-focus p{font-size:.9rem;line-height:1.7;margin:0}
  .author-articles{background:#0b1720}
  .author-articles>div>h2{font-size:clamp(1.6rem,3vw,2.6rem);margin:0 0 2rem}
  .story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2.2rem 1.3rem}
  .story{display:flex;flex-direction:column;align-items:start;text-decoration:none;color:inherit}
  .story-image{width:100%;aspect-ratio:16/10;overflow:hidden;border:1px solid #37505c}
  .story-image img{width:100%;height:100%;object-fit:cover}
  .story h3{font-size:1.25rem;line-height:1.35;margin:1rem 0 .55rem}
  .story:hover h3,.story:focus-visible h3{text-decoration:underline;text-decoration-color:#8bdfec}
  .story p{font-size:.85rem;line-height:1.6;margin:0 0 .9rem}
  .story .meta{font-size:.72rem;color:#9db6c2}
  .read{margin-top:auto;font-size:.76rem;color:#91e3ee;font-weight:700}
  @media(max-width:1000px){.story-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:650px){.writer{align-items:flex-start}.avatar{width:63px;height:63px;font-size:1.1rem}.writer-focus,.story-grid{grid-template-columns:1fr}}
</style>
