---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { authors } from '../../../data/authors.ts';
import { authorArticleCounts } from '../../../data/publications.ts';
---
<BaseLayout title="Skribenterna | WeAB Tidningen" description="Läs arkivtexter och skribentprofiler för WeAB Tidningens femton publicerade författare, däribland den avlidna Märta Ek.">
  <header class="page-hero">
    <div class="shell">
      <h1>Möt skribenterna.</h1>
      <p class="lead">Femton skribentprofiler och deras publicerade texter. Arkivet omfattar även tidigare medarbetare, däribland Märta Ek, som avled den 3 november 2051.</p>
      <a href="/nyheter/" class="back-link">← Till tidningen</a>
    </div>
  </header>
  <section class="section authors-section">
    <div class="shell">
      <div class="author-grid">
        {authors.map(author => <a class="author-card" href={`/nyheter/skribenter/${author.id}/`}>
          <div class="author-details">
            <h2>{author.name}</h2>
            <p class="role">{author.role} · {authorArticleCounts[author.id]} artiklar</p>
            <p class="biography">{author.biography}</p>
            <span class="read">Läs skribentens texter <span aria-hidden="true">↗</span></span>
          </div>
        </a>)}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
.authors-section{background:#101d25}
.back-link{display:inline-block;margin-top:1.2rem;font-size:.85rem;color:#96dbe7}
.author-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:3.5rem;row-gap:0;border-top:1px solid #425661}
.author-card{display:flex;flex-direction:column;text-decoration:none;color:inherit;padding:1.6rem 0;border-bottom:1px solid #425661;min-width:0}
.author-card:hover h2,.author-card:focus-visible h2{text-decoration:underline;text-underline-offset:3px}
.author-details{display:flex;flex-direction:column;flex:1}
.author-details h2{font-size:1.28rem;line-height:1.3;margin:0 0 .5rem;overflow-wrap:anywhere}
.role{font-size:.75rem;color:#9fb9c5;margin:0 0 .8rem}
.biography{font-size:.89rem;line-height:1.65;margin:0 0 1rem}
.read{color:#8de1ec;font-size:.8rem;font-weight:750;margin-top:auto}
@media(max-width:680px){.author-grid{grid-template-columns:1fr}}
</style>
