---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { news } from '../../data/news';
export function getStaticPaths() {
  return news.map(article => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
const displayDate = new Intl.DateTimeFormat('sv-SE', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${article.publishedAt}T12:00:00Z`));
---
<BaseLayout title={`${article.title} | WeAB Nyhetsrum`} description={article.summary}>
  <header class="page-hero">
    <div class="shell article-shell">
      <a class="back" href="/nyheter/">← Till nyhetsrummet</a>
      <div class="article-meta"><span class="eyebrow">{article.type}</span><time datetime={article.publishedAt}>{displayDate}</time></div>
      <h1>{article.title}</h1>
      <p class="lead">{article.summary}</p>
    </div>
  </header>
  <article class="section">
    <div class="shell article-shell">
      <div class="image-frame article-photo"><img src={article.image} alt={article.alt} /></div>
      <div class="article-source">WEAB GROUP / KONCERNKOMMUNIKATION</div>
      <div class="article-body">{article.body.map(paragraph => <p>{paragraph}</p>)}</div>
      <div class="article-end"><a class="btn btn-outline" href="/nyheter/">Alla nyheter <span aria-hidden="true">↗</span></a></div>
      <small class="satire-note">Innehållet är satir.</small>
    </div>
  </article>
</BaseLayout>
<style>
  .article-shell{max-width:850px}.article-shell h1{overflow-wrap:anywhere}
  .article-meta{display:flex;align-items:baseline;gap:1.3rem;flex-wrap:wrap;margin-bottom:.65rem}
  .article-meta time{font-size:.79rem;color:#a5b8c3}
  .article-photo{height:430px;margin-bottom:2.1rem}
  .article-photo img{display:block;height:100%;width:100%;object-fit:cover}
  .article-source{font-size:.65rem;letter-spacing:.17em;font-weight:800;color:#93aebc;margin-bottom:2.2rem}
  .article-body p{font-size:clamp(1rem,1.45vw,1.1rem);line-height:1.82;margin:0 0 1.6rem;color:#d3dee3}
  .article-body p:first-child{font-weight:550;color:#edf3f5}
  .article-end{border-top:1px solid #344551;margin-top:3.2rem;padding-top:1.5rem}
  .back{display:block;margin-bottom:2rem;color:#9fc4d0;text-decoration:none;font-size:.86rem}
  .satire-note{display:block;font-size:.65rem;line-height:1.5;color:#8696a0;letter-spacing:.01em;margin-top:2.5rem}
  @media(max-width:650px){.article-photo{height:260px}.article-body p{line-height:1.7}}
</style>
