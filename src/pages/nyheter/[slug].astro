---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publications, publicationFormatLabels } from '../../data/publications.ts';
import type { Publication } from '../../data/publications.ts';

export function getStaticPaths() {
  return publications.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}
const { article } = Astro.props as { article: Publication };
const dateLabel = (iso: string) => new Intl.DateTimeFormat('sv-SE',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }
).format(new Date(`${iso}T12:00:00Z`));
const related = publications
  .filter(item => item.slug !== article.slug && (item.format === article.format || item.type === article.type))
  .slice(0, 2);
---
<BaseLayout title={`${article.title} | WeAB Tidningen`} description={article.summary}>
  <header class="page-hero publication-hero">
    <div class="shell article-shell">
      <a class="back-link" href="/nyheter/">← Till WeAB Tidningen</a>
      <h1>{article.title}</h1>
      <p class="lead">{article.summary}</p>
      <div class="publication-meta">
        <span>{publicationFormatLabels[article.format]}</span>
        <time datetime={article.publishedAt}>{dateLabel(article.publishedAt)}</time>
        <span>{article.byline}</span>
      </div>
    </div>
  </header>

  <article class="section publication-article">
    <div class="shell article-shell">
      <figure class="publication-image">
        <img src={article.image} alt={article.alt} loading="eager" decoding="async" />
      </figure>
      <div class="article-body">
        {article.body.map(paragraph => <p>{paragraph}</p>)}
      </div>
      {related.length > 0 && <aside class="related">
        <h2>Fortsätt läsa</h2>
        <div class="related-list">{related.map(item => <a href={`/nyheter/${item.slug}/`}>
          <strong>{item.title}</strong>
          <span>{publicationFormatLabels[item.format]} · {dateLabel(item.publishedAt)}</span>
        </a>)}</div>
      </aside>}
      <nav class="article-end" aria-label="Tillbaka till tidningen">
        <a class="btn btn-outline" href="/nyheter/">Alla texter <span aria-hidden="true">↗</span></a>
      </nav>
      <small class="satire-note">Innehållet är satir.</small>
    </div>
  </article>
</BaseLayout>
<style>
  .article-shell{max-width:900px}
  .publication-hero h1{overflow-wrap:anywhere;max-width:870px}
  .back-link{display:inline-block;margin-bottom:2rem;font-size:.85rem;text-decoration:none;color:#a5c7d0}
  .back-link:hover,.back-link:focus-visible{text-decoration:underline}
  .publication-meta{display:flex;align-items:baseline;flex-wrap:wrap;gap:.45rem 1.3rem;margin-top:2rem;padding-top:1.2rem;border-top:1px solid #47616c;color:#a6bac4;font-size:.8rem}
  .publication-meta span:first-child{color:#8fdfec;font-weight:800}
  .publication-image{margin:0 0 2.4rem;width:100%;height:clamp(240px,42vw,470px);border:1px solid #3b4e5a;overflow:hidden;background:#142531}
  .publication-image img{width:100%;height:100%;object-fit:cover;display:block}
  .article-body p{font-size:clamp(1rem,1.4vw,1.09rem);line-height:1.83;color:#d1dfe4;margin:0 0 1.55rem}
  .article-body p:first-child{color:#f0f5f7;font-weight:550}
  .related{border-top:1px solid #3d5360;padding-top:2.2rem;margin-top:3rem}
  .related h2{font-size:1.4rem;margin:0 0 1.25rem}
  .related-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem}
  .related-list a{display:grid;gap:.7rem;padding:1.2rem;border:1px solid #344c57;text-decoration:none;color:#e8f1f4}
  .related-list a:hover,.related-list a:focus-visible{border-color:#81dce9}
  .related-list strong{font-size:1.02rem;line-height:1.4}
  .related-list span{font-size:.75rem;color:#99b4bf}
  .article-end{border-top:1px solid #344551;margin-top:2.7rem;padding-top:1.5rem}
  .satire-note{display:block;margin-top:2.4rem;color:#91a3ac;font-size:.65rem;line-height:1.5;letter-spacing:.01em}
  @media(max-width:620px){.related-list{grid-template-columns:1fr}.article-body p{line-height:1.72}.publication-hero h1{font-size:clamp(2.2rem,10vw,4rem)}}
</style>
