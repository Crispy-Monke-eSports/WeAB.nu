---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { imageAsset, responsiveWidths } from '../data/imageAssets';
import { arenaPhotos, hungerGames } from '../data/arena';
---

<BaseLayout
  title="Huvudstadens arena | WeAB Group"
  description="Huvudstadens arena används för Hungerspelen: två bybor från varje by kämpar till döden. Arrangemanget ger intäkter till WeAB."
>
  <section class="arena-hero" aria-labelledby="arena-heading">
    <Image
      class="arena-hero__image"
      src={imageAsset(arenaPhotos[0].src)}
      alt={arenaPhotos[0].alt}
      layout="full-width"
      widths={responsiveWidths}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="arena-hero__shade" aria-hidden="true"></div>
    <div class="shell arena-hero__content">
      <h1 id="arena-heading">Två från varje by.<br /><em>Hungerspelen i Huvudstaden.</em></h1>
      <p class="lead">Huvudstadens arena är platsen för Hungerspelen. Varje by skickar två bybor som tvingas kämpa mot de andra deltagarna till döden. WeAB ansvarar för arenan och tar emot inkomsterna från arrangemanget.</p>
      <a class="btn" href="#bildgalleri">Utforska arenan <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="section" aria-labelledby="arena-about">
    <div class="shell arena-intro">
      <div>
        <h2 id="arena-about">Varje by bidrar.<br />WeAB tar emot.</h2>
      </div>
      <div>
        <p class="lead">Hungerspelen bygger på en enkel ordning: två deltagare från varje by förs till arenan för en kamp till döden. Deras byar står för deltagarna. Koncernen står för anläggningen och intäktsredovisningen.</p>
        <p>Den blåvita byggnaden har läktare, belysta passager och separata ytor för publik och deltagare. Striderna är dödliga; det är inte en vanlig idrottstävling. WeAB beskriver verksamheten som ett publikt arrangemang, och inkomsterna tillfaller koncernen. Några belopp, genomförandedatum eller officiella resultat publiceras inte här.</p>
        <dl class="arena-facts">
          <div><dt>Plats</dt><dd>Huvudstaden</dd></div>
          <div><dt>Deltagare</dt><dd>{hungerGames.contestantsPerVillage} bybor från varje by</dd></div>
          <div><dt>Arrangemang</dt><dd>{hungerGames.name}</dd></div>
          <div><dt>Utgång</dt><dd>Kamp till döden</dd></div>
          <div><dt>Ekonomi</dt><dd>Intäkter till WeAB</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="bildgalleri" aria-labelledby="gallery-heading">
    <div class="shell">
      <div class="section-heading">
        <div>
          <h2 id="gallery-heading">Byggd för att synas.</h2>
        </div>
      </div>
      <div class="arena-gallery">
        {arenaPhotos.map((photo, index) => (
          <div class:list={['arena-gallery__item', { 'arena-gallery__item--wide': index === 0 }]}>
            <Image src={imageAsset(photo.src)} alt={photo.alt} layout="constrained" widths={responsiveWidths} sizes={index === 0 ? '100vw' : '(max-width: 700px) 100vw, 50vw'} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="arena-bottom">
    <div class="shell arena-bottom__inner">
      <div>
        <h2>Byarna tillhandahåller deltagarna.<br />WeAB behåller intäkterna.</h2>
      </div>
      <a href="/verksamheter/" class="btn btn-outline">Utforska koncernens verksamheter <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .arena-hero{position:relative;min-height:clamp(570px,70svh,790px);display:flex;align-items:end;overflow:hidden;background:#101d28}
  .arena-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%}
  .arena-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,14,22,.94),rgba(4,14,22,.72) 46%,rgba(4,14,22,.18) 100%),linear-gradient(0deg,rgba(4,14,22,.8),transparent 68%)}
  .arena-hero__content{position:relative;z-index:1;padding-top:8rem;padding-bottom:5rem}
  .arena-hero h1{max-width:920px;margin:.4rem 0 1.6rem;font-size:clamp(2.8rem,6.4vw,6.2rem)}
  .arena-hero h1 em{font-style:normal;color:#83e0ed}
  .arena-hero .lead{max-width:670px;color:#e2edf1;margin:0 0 2rem}
  .arena-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:5rem}
  .arena-intro h2{max-width:520px}
  .arena-facts{margin:2rem 0 0;border-top:1px solid #334753}
  .arena-facts div{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid #334753}
  .arena-facts dt{color:#9fb4bf}
  .arena-facts dd{margin:0;text-align:right;font-weight:700}
  #bildgalleri{scroll-margin-top:90px}
  .arena-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}
  .arena-gallery__item{margin:0;min-width:0;border-top:2px solid #397584;background:#101e27}
  .arena-gallery__item--wide{grid-column:1 / -1}
  .arena-gallery__item img{width:100%;height:clamp(230px,28vw,410px);object-fit:cover}
  .arena-gallery__item--wide img{height:clamp(290px,45vw,570px)}
  .arena-bottom{padding:5rem 0;border-top:1px solid #314b59}
  .arena-bottom__inner{display:flex;justify-content:space-between;align-items:end;gap:2rem}
  .arena-bottom h2{font-size:clamp(1.75rem,3vw,2.8rem);max-width:770px;margin:0}
  .arena-bottom .btn{flex-shrink:0}
  @media(max-width:800px){.arena-intro{gap:2rem}.arena-bottom__inner{align-items:start;flex-direction:column}}
  @media(max-width:650px){.arena-hero__content{padding:6rem 0 3.5rem}.arena-hero__shade{background:linear-gradient(90deg,rgba(4,14,22,.88),rgba(4,14,22,.5)),linear-gradient(0deg,#04101c,transparent 75%)}.arena-intro,.arena-gallery{grid-template-columns:1fr}.arena-gallery__item--wide{grid-column:auto}.arena-gallery__item img,.arena-gallery__item--wide img{height:auto;aspect-ratio:16/9}.arena-facts div{align-items:baseline}}
</style>
