---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props {title?:string;description?:string;}
const {title='WeAB Group | En bättre värld. På våra villkor.', description='WeAB är en fiktiv megakoncern på en Minecraft-server, med verksamheter inom produktion, logistik, boende, transport och underhållning.'}=Astro.props;
---
<!doctype html>
<html lang="sv">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <meta name="description" content={description}/>
 <meta name="theme-color" content="#0b141b" />
 <meta property="og:title" content={title}/>
 <meta property="og:description" content={description}/>
 <meta property="og:type" content="website" />
 <link rel="icon" type="image/svg+xml" href="/logos/weab.svg" />
 <title>{title}</title>
</head>
<body><a class="skip-link" href="#main">Hoppa till innehåll</a><Header/><main id="main"><slot/></main><Footer/></body>
</html>
