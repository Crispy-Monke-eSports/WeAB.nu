---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResistanceInterference from '../components/ResistanceInterference.astro';
import ResistanceMorse from '../components/ResistanceMorse.astro';
import ResistanceEyes from '../components/ResistanceEyes.astro';
import ResistanceMinigame from '../components/ResistanceMinigame.astro';
import SpiritTransmission from '../components/SpiritTransmission.astro';
import BuilderDiagnostics from '../components/BuilderDiagnostics.astro';
import { resistanceLockdown } from '../data/resistanceLockdown.ts';
import { resistanceSignal } from '../data/resistanceSignal.ts';
import { spiritTyping } from '../data/spiritTyping.ts';
import { spiritVoice } from '../data/spiritVoiceTiming.ts';
import { cameraEncounter } from '../data/cameraEncounter.ts';
import CameraEncounter from '../components/CameraEncounter.astro';
import { companies } from '../data/companies';
import { minigameInvitationCookieName } from '../data/resistanceMinigameInvitation.ts';
import '../styles/global.css';
interface Props {title?:string;description?:string;enableInterference?:boolean;}
const {title='WeAB Group | En bättre värld. På våra villkor.', description='WeAB verkar inom produktion, logistik, boende, transport och nöje. En bättre värld, på våra villkor.', enableInterference=true}=Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://weab.nu').toString();
const socialImage = new URL('/images/weab-cyan-building.webp', Astro.site ?? 'https://weab.nu').toString();
const companySlug = Astro.url.pathname.match(/^\/verksamheter\/([^/]+)\/?$/)?.[1];
const faviconSlug = companies.find(company => company.slug === companySlug)?.slug ?? 'weab';
---
<!doctype html>
<html lang="sv">
<head>

 <style is:inline>
  /* Spärren måste döljas/visas i HEAD innan ordinarie innehåll ritas. */
  #weab-quarantine { display: none; }
  /* Sätts av HEAD:s cookie-kontroll innan någon ordinarie sidtext hinner synas.
     Visa först när sidans texter hunnit ersättas med själens länkar. */
  html.weab-save-call:not(.weab-save-call-ready) body > :is(aside,header,main,footer) {
    visibility: hidden !important;
  }
  html.weab-save-call body > :is(aside,header,main,footer) :is(a,button,summary,[role="button"],[role="link"]) {
    color: #d8f5f7 !important;
    cursor: pointer !important;
    text-decoration: underline !important;
    text-decoration-style: dashed !important;
    text-underline-offset: .18em;
    text-shadow: 2px 0 rgb(165 41 67 / .5), -2px 0 rgb(36 142 165 / .55);
  }
  html.weab-save-call body > :is(aside,header,main,footer) {
    text-shadow: 1px 0 rgb(163 36 61 / .32), -1px 0 rgb(42 134 152 / .35);
  }
   html.weab-quarantined, html.weab-minigame-confirmed { scroll-behavior: auto; }
   html.weab-quarantined body, html.weab-minigame-confirmed body {
    margin: 0 !important;
    background: #071019 !important;
    min-height: 100svh !important;
    overflow: hidden !important;
  }
   html.weab-quarantined body > :not(#weab-quarantine),
   html.weab-minigame-confirmed body > :not(#weab-quarantine) { display: none !important; }
   html.weab-quarantined #weab-quarantine,
   html.weab-minigame-confirmed #weab-quarantine {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding: 2rem;
    background: #071019;
    color: #e6eef1;
    text-align: center;
    isolation: isolate;
  }
   html.weab-quarantined #weab-quarantine::before,
   html.weab-minigame-confirmed #weab-quarantine::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg, transparent 0, transparent 5px, rgb(151 188 196 / .02) 6px
    );
    z-index: -1;
  }
  #weab-quarantine img {
    display: block;
    width: min(240px, 65vw);
    height: auto;
    object-fit: contain;
  }
  #weab-quarantine .weab-quarantine__copy {
    max-width: 52ch;
    min-height: 6em;
  }
  #weab-quarantine p {
    max-width: 50ch;
    margin: 0;
    color: #d4e0e5;
    font: 600 clamp(1rem, 2.6vw, 1.45rem)/1.65 "Segoe UI", Arial, sans-serif;
    letter-spacing: .015em;
    overflow-wrap: anywhere;
  }
  #weab-quarantine .weab-quarantine__intrusion {
    margin-top: 1.5rem;
    font: 500 clamp(.95rem, 2.3vw, 1.3rem)/1.7 ui-monospace, monospace;
    color: #c5a4aa;
    letter-spacing: .055em;
    text-shadow: 2px 0 #491722, -2px 0 #23414e;
  }
  #weab-quarantine .weab-quarantine__intrusion[hidden] { display: none !important; }
  /* Sammanhängande analoga störningar medan själens bokstäver skrivs. */
  html.weab-spirit-typing #weab-quarantine .weab-quarantine__intrusion {
    text-shadow: -2px 0 #236b77, 2px 0 #943749, 0 0 9px rgb(192 73 98 / .45);
    animation: weab-spirit-text-drift .43s steps(3, end) infinite;
  }
  html.weab-spirit-typing #weab-quarantine::before {
    background:
      repeating-linear-gradient(0deg, transparent 0 3px,
        rgb(102 174 190 / .07) 4px, transparent 5px 9px),
      linear-gradient(176deg, transparent 18%,
        rgb(124 25 48 / .06) 40%, transparent 64%);
    opacity: .6;
  }
  @keyframes weab-spirit-text-drift {
    0%, 100% { transform: translateX(0); }
    34% { transform: translateX(-1px); }
    67% { transform: translateX(1px); }
  }
  html.weab-intruding #weab-quarantine img {
    filter: grayscale(.85) brightness(.6);
    transform: translateX(2px);
  }
  html.weab-intruding #weab-quarantine .weab-quarantine__system {
    color: #70878f;
    text-decoration: line-through;
    text-decoration-color: #53636b;
  }
  html.weab-death-confirmed #weab-quarantine .weab-quarantine__system {
    color: #e6eef1;
    text-decoration: none;
  }

  /* DDLC-inspirerad, men egen WeAB-form: sönderrivna textrader och
     färgkanalsförskjutningar istället för strobeljus eller skrämselfoton. */
  #weab-quarantine .weab-quarantine__copy {
    position: relative;
    z-index: 2;
    width: min(100%, 54ch);
  }
  #weab-quarantine .weab-quarantine__system,
  #weab-quarantine .weab-quarantine__intrusion { position: relative; }
  #weab-quarantine .weab-quarantine__spinner {
    position: relative;
    z-index: 2;
    display: block;
    width: 24px;
    height: 24px;
    border: 2px solid #35515e;
    border-top-color: #a2d5df;
    border-radius: 50%;
    animation: weab-quarantine-spin 1.2s linear infinite;
    flex-shrink: 0;
  }
  #weab-quarantine .weab-quarantine__fragment {
    display: none;
    position: absolute;
    inset: auto auto -1.7rem 13%;
    max-width: 85%;
    color: #9d6570;
    font: 700 .77rem ui-monospace,monospace;
    letter-spacing: .18em;
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
  }
  html.weab-critical #weab-quarantine {
    background: linear-gradient(175deg, #071019, #110d15 52%, #071019);
  }
  html.weab-critical #weab-quarantine::before { opacity: .68; }
  html.weab-overrun #weab-quarantine .weab-quarantine__system {
    opacity: .73;
    text-decoration: line-through;
    text-decoration-color: #844858;
  }
  html.weab-glitching #weab-quarantine::after {
    content: "";
    position: absolute;
    z-index: 1;
    pointer-events: none;
    top: var(--weab-tear-y, 47%);
    left: -4%;
    right: -4%;
    height: clamp(12px, 2.7vh, 25px);
    transform: translateX(var(--weab-tear-x, 3px));
    background:
      linear-gradient(0deg, transparent, #5b253b35 44%, #90acbc22 50%, transparent),
      repeating-linear-gradient(90deg, #861d3722 0 9px, #152a3922 9px 20px);
    box-shadow: 0 -2px 0 #7a26301a, 0 3px 0 #91bfbe12;
  }
  html.weab-glitching #weab-quarantine img {
    transform: translateX(var(--weab-tear-x, 3px)) skewX(-1deg);
    filter: drop-shadow(4px 0 #72344075) drop-shadow(-4px 0 #3879865c);
  }
  html.weab-glitching #weab-quarantine .weab-quarantine__system,
  html.weab-glitching #weab-quarantine .weab-quarantine__intrusion {
    transform: translateX(calc(var(--weab-tear-x, 3px) * -.6));
    text-shadow: 3px 0 #723440a6, -3px 0 #3879868c;
  }
  html.weab-glitching #weab-quarantine .weab-quarantine__system::after,
  html.weab-glitching #weab-quarantine .weab-quarantine__intrusion:not([hidden])::after {
    content: attr(data-echo);
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: #ac8b94;
    opacity: .8;
    clip-path: inset(42% 0 27% 0);
    transform: translateX(calc(var(--weab-tear-x, 3px) * -1.5));
    text-decoration: none;
  }
  html.weab-glitching #weab-quarantine .weab-quarantine__fragment { display: block; }
  html.weab-death-confirmed #weab-quarantine {
    background: #071019;
  }
  @keyframes weab-quarantine-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    html.weab-spirit-typing #weab-quarantine .weab-quarantine__intrusion { animation: none; }
    #weab-quarantine .weab-quarantine__spinner { animation: none; }
    html.weab-glitching #weab-quarantine img,
    html.weab-glitching #weab-quarantine .weab-quarantine__system,
    html.weab-glitching #weab-quarantine .weab-quarantine__intrusion {
      transform: none;
    }
    html.weab-glitching #weab-quarantine::after,
    html.weab-glitching #weab-quarantine .weab-quarantine__fragment {
      display: none;
    }
  }
 </style>
 <script is:inline define:vars={{
   lockCookieName: resistanceLockdown.cookieName,
   lockDurationMs: resistanceLockdown.durationMs,
   lockNoticeKey: resistanceLockdown.noticeKey,
   lockOpening: resistanceLockdown.opening,
   lockSystemEarly: resistanceLockdown.systemEarly,
   lockSystemLate: resistanceLockdown.systemLate,
   lockSpiritEarly: resistanceLockdown.spiritEarly,
   lockSpiritLate: resistanceLockdown.spiritLate,
   lockWaypointWhispers: resistanceLockdown.waypointWhispers,
   cameraScene: cameraEncounter,
   exitMessage: resistanceLockdown.exitMessage,
   exitMessageMs: resistanceLockdown.exitMessageMs,
    signalSessionKey: resistanceSignal.sessionKey,
   invitationCookieName: minigameInvitationCookieName,
   spiritTypingMinMs: spiritTyping.minMs,
   spiritTypingPerCharacterMs: spiritTyping.perCharacterMs,
   spiritTypingMaxMs: spiritTyping.maxMs,
   spiritTypingMarginMs: spiritTyping.nextBeatMarginMs,
   spiritTypingFrameMs: spiritTyping.frameMs,
   spiritVoiceLibrary: spiritVoice
 }}>
  (() => {
    const root = document.documentElement;
    const cookiePrefix = lockCookieName + '=';
    let lockTimer;
    let glitchTimer;
    let microTearTimer;
    let confirmedDisplayed = false;
    let lastBeatKey = '';
    let activeTypingKey = '';
    let presenceActive = false;
    let personalizedBeatKey = '';
    let personalizedBeatText = '';
    let cameraStartedKey = '';
    let cameraReplyText = '';
    let cameraReplyStatus = '';
    let cameraReplyTime = 0;
    let cameraReplyKey = '';
    let timelineExpiry = 0;
    let timeline = [];

    function seededRandom(seed) {
      let state = seed | 0;
      return () => {
        state = (state + 0x6D2B79F5) | 0;
        let value = Math.imul(state ^ (state >>> 15), 1 | state);
        value ^= value + Math.imul(value ^ (value >>> 7), 61 | value);
        return ((value ^ (value >>> 14)) >>> 0) / 0x100000000;
      };
    }

    function shuffled(source, random) {
      const values = [...source];
      for (let i = values.length - 1; i > 0; i--) {
        const j = Math.floor(random() * (i + 1));
        [values[i], values[j]] = [values[j], values[i]];
      }
      return values;
    }

    // Samma seed (cookie-sluttid) ger samma kamp i alla flikar,
    // men olika ordning och pauser vid nästa övertagandeförsök.
    function getTimeline(until) {
      if (timelineExpiry === until && timeline.length) return timeline;
      timelineExpiry = until;
      const random = seededRandom(Math.trunc(until) ^ 0x5e4b110d);
      const earlySystem = shuffled(lockSystemEarly, random);
      const lateSystem = shuffled(lockSystemLate, random);
      const earlySpirit = shuffled(lockSpiritEarly, random);
      const lateSpirit = shuffled(lockSpiritLate, random);
      timeline = [{ atMs: 0, voice: 'system', text: lockOpening }];
      const used = new Set([lockOpening]);
      let elapsed = 0;
      let eventIndex = 0;
      while (true) {
        const gap = elapsed < 170_000
          ? 6_000 + Math.floor(random() * 5_400)
          : elapsed < 270_000
            ? 3_800 + Math.floor(random() * 5_000)
            : 2_000 + Math.floor(random() * 3_100);
        elapsed += gap;
        if (elapsed >= lockDurationMs - 1_000) break;
        const late = elapsed >= 170_000;
        const voice = eventIndex % 4 === 3 ? 'system' : 'intrusion';
        const preferred = voice === 'system'
          ? (late ? lateSystem : earlySystem)
          : (late ? lateSpirit : earlySpirit);
        const fallback = voice === 'system'
          ? (late ? earlySystem : lateSystem)
          : (late ? earlySpirit : lateSpirit);
        const text = preferred.pop() ?? fallback.pop();
        if (!text || used.has(text)) break;
        timeline.push({ atMs: elapsed, voice, text });
        used.add(text);
        eventIndex++;
      }
      // Kort kamerafråga tidigt, utan att påverka den senare ledtråden.
      const cameraBeat = timeline.find(beat =>
        beat.voice === 'intrusion' && beat.atMs >= 62_000 && beat.atMs < 100_000);
      if (cameraBeat) cameraBeat.text = cameraScene.request;

      // Motsvarar resistanceLockdown.createLockdownTimeline:
      // en ledtråd i varje karantän ska faktiskt nå fram till besökaren.
      const waypoint = timeline.find(beat =>
        beat.voice === 'intrusion' && beat.atMs >= 130_000);
      if (waypoint) {
        waypoint.text = lockWaypointWhispers[
          Math.abs(Math.trunc(until)) % lockWaypointWhispers.length
        ];
      }
      return timeline;
    }

    function pulseGlitch(level) {
      if (!root.classList.contains('weab-quarantined') ||
          root.classList.contains('weab-death-confirmed')) return;
      window.clearTimeout(glitchTimer);
      root.classList.remove('weab-glitching');
      // Vilken del av bilden som slits sönder ändras varje gång.
      root.style.setProperty('--weab-tear-y', (18 + Math.random() * 66).toFixed(1) + '%');
      root.style.setProperty('--weab-tear-x', (Math.random() * 14 - 7).toFixed(1) + 'px');
      const fragment = document.getElementById('weab-quarantine-fragment');
      if (fragment) {
        const artifacts = ['▓▓░▒ 0x██', '///////', '0000 ▒▒ ██', '███ NUL ██', '░░░█▓█'];
        fragment.textContent = artifacts[Math.floor(Math.random() * artifacts.length)];
      }
      root.classList.add('weab-glitching');
      glitchTimer = window.setTimeout(() => root.classList.remove('weab-glitching'),
        180 + Math.floor(Math.random() * (level >= 2 ? 250 : 110)));
    }

    function scheduleMicroTears() {
      window.clearTimeout(microTearTimer);
      if (!root.classList.contains('weab-quarantined') ||
          root.classList.contains('weab-death-confirmed')) return;
      const progress = Number(root.dataset.weabCorruption || '0');
      const delay = 3_200 - Math.floor(progress * 1_900) +
        Math.floor(Math.random() * 3_300);
      microTearTimer = window.setTimeout(() => {
        if (document.visibilityState === 'visible') pulseGlitch(progress > .68 ? 2 : 1);
        scheduleMicroTears();
      }, delay);
    }

    function readCookieExpiry(now) {
      const part = document.cookie.split(';').map(item => item.trim())
        .find(item => item.startsWith(cookiePrefix));
      if (!part) return 0;
      const until = Number(part.slice(cookiePrefix.length));
      return Number.isSafeInteger(until) && until > now &&
        until <= now + lockDurationMs ? until : 0;
    }

    function readQuietExpiry(now) {
      const part = document.cookie.split(';').map(item => item.trim())
        .find(item => item.startsWith(cookiePrefix + 'quiet.'));
      if (!part) return 0;
      const until = Number(part.slice((cookiePrefix + 'quiet.').length));
      return Number.isSafeInteger(until) && until > now &&
        until <= now + lockDurationMs ? until : 0;
    }

    function readNoticeExpiry(now) {
      try {
        const until = Number(localStorage.getItem(lockNoticeKey));
        return Number.isSafeInteger(until) && until > now - exitMessageMs &&
          until <= now + lockDurationMs ? until : 0;
      } catch {
        return 0;
      }
    }

    function updateTypingSound(active, beatKey, strength) {
      // Vid första renderingen i HEAD finns ljudlyssnaren ännu inte.
      // DOMContentLoaded anropar renderStruggle igen.
      if (document.readyState === 'loading') return;
      const key = active ? beatKey : '';
      root.classList.toggle('weab-spirit-typing', Boolean(active));
      if (activeTypingKey === key) return;
      activeTypingKey = key;
      window.dispatchEvent(new CustomEvent('weab:spirit-typing', {
        detail: { active: Boolean(active), strength }
      }));
    }

    function updateSpiritPresence(active) {
      if (document.readyState === 'loading' || presenceActive === active) return;
      presenceActive = active;
      window.dispatchEvent(new CustomEvent('weab:spirit-presence', {
        detail: { active }
      }));
    }

    let lastVoiceKey = '';
    function updateSpiritVoice(text, key, age, duration, strength) {
      if (document.readyState === 'loading') return;
      const entry = spiritVoiceLibrary[text];
      if (!entry || !duration || age >= duration || document.hidden) {
        if (lastVoiceKey) window.dispatchEvent(new Event('weab:voice-stop'));
        lastVoiceKey = '';
        return;
      }
      if (lastVoiceKey === key) return;
      lastVoiceKey = key;
      window.dispatchEvent(new CustomEvent('weab:voice-speak', {
        detail: { text, ageMs: age, durationMs: duration, profile: strength }
      }));
    }

    function revealRecordedText(text, age, duration) {
      const entry = spiritVoiceLibrary[text];
      if (!entry || age >= duration) return text;
      const position = age * entry.durationMs / duration;
      let end = 0;
      for (const [from, to, start, finish] of entry.words) {
        if (position < start) break;
        end = position >= finish ? to : from + Math.floor((to - from) *
          (position - start) / Math.max(1, finish - start));
        if (position < finish) break;
      }
      return text.slice(0, end);
    }

    function showSystem(text, intrusionText) {
      const status = document.getElementById('weab-quarantine-status');
      const breach = document.getElementById('weab-quarantine-intrusion');
      if (status) {
        status.textContent = text;
        status.dataset.echo = text;
      }
      if (breach) {
        breach.hidden = !intrusionText;
        breach.textContent = intrusionText || '';
        breach.dataset.echo = intrusionText || '';
      }
    }

    function renderStruggle(until, now) {
      const beats = getTimeline(until);
      const elapsed = Math.max(0, lockDurationMs - (until - now));
      const progress = Math.min(1, elapsed / lockDurationMs);
      let latestSystem = lockOpening;
      let latestIntrusion = '';
      let currentBeat = beats[0];
      let nextAt = lockDurationMs;
      for (const beat of beats) {
        if (beat.atMs > elapsed) {
          nextAt = beat.atMs;
          break;
        }
        currentBeat = beat;
        if (beat.voice === 'system') {
          latestSystem = beat.text;
          latestIntrusion = '';
        } else {
          latestIntrusion = beat.text;
        }
      }
      // Kamerans svar får överrösta en statusrad i högst några sekunder.
      const replyAge = now - cameraReplyTime;
      const reacting = Boolean(cameraReplyText &&
        replyAge >= 0 && replyAge < cameraScene.responseMs);
      if (reacting) latestIntrusion = cameraReplyText;
      root.dataset.weabCorruption = String(progress);
      root.classList.toggle('weab-intruding', Boolean(latestIntrusion));
      root.classList.toggle('weab-overrun', progress > .62 && Boolean(latestIntrusion));
      root.classList.toggle('weab-critical', progress > .54);
      root.classList.remove('weab-death-confirmed');
      const originalBeatKey = until + ':' + currentBeat.atMs;
      const beatKey = reacting ? cameraReplyKey : originalBeatKey;
      const isSpirit = reacting ||
        (currentBeat.voice === 'intrusion' && Boolean(latestIntrusion));
      // Ett FÅTAL repliker kan nämna verkligt observerade webbläsardetaljer.
      // Nätuppslagets tillåtna orts-/operatörsetiketter lever bara i fliken;
      // IP och råsvar används aldrig i replikerna. Avsändaren avslöjas inte.
      if (isSpirit && !reacting &&
          !lockWaypointWhispers.includes(latestIntrusion) &&
          beats.indexOf(currentBeat) % 13 === 2 &&
          document.readyState !== 'loading') {
        if (personalizedBeatKey !== beatKey) {
          const detail = { index: Math.floor(until / 1000) + beats.indexOf(currentBeat),
            text: '' };
          window.dispatchEvent(new CustomEvent('weab:visitor-whisper', { detail }));
          if (detail.text) {
            personalizedBeatKey = beatKey;
            personalizedBeatText = detail.text;
          }
        }
        if (personalizedBeatKey === beatKey) latestIntrusion = personalizedBeatText;
      }
      const oldDuration = isSpirit
        ? Math.min(
          Math.max(spiritTypingMinMs, Math.min(spiritTypingMaxMs,
            [...latestIntrusion].length * spiritTypingPerCharacterMs)),
          reacting ? cameraScene.responseMs :
            Math.max(330, nextAt - currentBeat.atMs - spiritTypingMarginMs))
        : 0;
      const recorded = spiritVoiceLibrary[latestIntrusion];
      const available = reacting ? cameraScene.responseMs :
        Math.max(330, nextAt - currentBeat.atMs - spiritTypingMarginMs);
      const duration = isSpirit && recorded
        ? Math.min(recorded.durationMs, available,
          !reacting && currentBeat.text === cameraScene.request ? oldDuration : Infinity)
        : oldDuration;
      const age = reacting ? replyAge : Math.max(0, elapsed - currentBeat.atMs);
      // Börja med webbläsarens tillståndsdialog först när besökaren
      // hunnit läsa själens fråga.
      if (!reacting && currentBeat.text === cameraScene.request &&
          cameraStartedKey !== originalBeatKey &&
          document.readyState !== 'loading' &&
          document.visibilityState === 'visible' &&
          age >= duration && age < duration + 1_800) {
        cameraStartedKey = originalBeatKey;
        window.dispatchEvent(new CustomEvent('weab:camera-encounter-start', {
          detail: { key: originalBeatKey }
        }));
      }
      const typing = Boolean(isSpirit && age < duration &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      const visibleLetters = typing
        ? recorded ? revealRecordedText(latestIntrusion, age, duration)
          : [...latestIntrusion].slice(0,
            Math.floor([...latestIntrusion].length * age / duration)).join('')
        : latestIntrusion;
      // data-echo måste använda samma SYNLIGA text, annars visar
      // glitchens överlagring hela meddelandet innan det har skrivits.
      const displayed = typing ? visibleLetters + '▌' : visibleLetters;
      showSystem(latestSystem, displayed);
      updateSpiritPresence(isSpirit && document.visibilityState === 'visible');
      const strength = reacting
        ? (cameraReplyStatus === 'allowed' ? 'medium' : 'harsh')
        : progress > .70 ? 'harsh' : progress > .38 ? 'medium' : 'soft';
      updateTypingSound(typing && document.visibilityState === 'visible',
        beatKey, strength);
      updateSpiritVoice(isSpirit ? latestIntrusion : '', beatKey, age, duration,
        reacting && cameraReplyStatus !== 'allowed' ? 'desperate' :
          progress > .38 ? 'broken' : 'weak');
      if (beatKey !== lastBeatKey && document.readyState !== 'loading') {
        lastBeatKey = beatKey;
        pulseGlitch(progress > .62 || currentBeat.voice === 'intrusion' ? 2 : 1);
        if (isSpirit && document.visibilityState === 'visible') {
          window.dispatchEvent(new CustomEvent('weab:spirit-burst', {
            detail: { strength }
          }));
        }
      }
      const untilNext = Math.min(until - now, Math.max(0, nextAt - elapsed));
      return typing || reacting
        ? Math.min(Math.max(50, untilNext), spiritTypingFrameMs)
        : untilNext;
    }

    function showConfirmed(now, until) {
      root.classList.add('weab-quarantined', 'weab-death-confirmed');
      root.classList.remove('weab-intruding', 'weab-overrun',
        'weab-critical', 'weab-glitching');
      updateTypingSound(false, '', 'soft');
      updateSpiritPresence(false);
      updateSpiritVoice('', '', 0, 0, 'weak');
      root.dataset.weabCorruption = '0';
      window.clearTimeout(glitchTimer);
      window.clearTimeout(microTearTimer);
      showSystem(exitMessage, '');
      if (document.readyState !== 'loading') document.title = 'WeAB | Anslutningen återupptas';
      if (confirmedDisplayed) return;
      confirmedDisplayed = true;
      const remaining = until > 0 ? Math.max(0, until + exitMessageMs - now) : exitMessageMs;
      window.clearTimeout(lockTimer);
      lockTimer = window.setTimeout(() => {
        try { localStorage.removeItem(lockNoticeKey); } catch { /* Lagring är valfri. */ }
        location.reload();
      }, remaining);
    }

    function applyLockdown() {
      // Uttrycklig testadress kringgår spärren även i produktion.
      if (new URLSearchParams(location.search).get('previewMinigame') === '1') return;
      // Morse slutförs på ursprungsfliken. Ett NYTT dokument låses i HEAD.
      if (root.dataset.weabMorseRunning === '1') return;
      const now = Date.now();
      const quietUntil = readQuietExpiry(now);
      if (quietUntil) {
        root.classList.remove('weab-save-call', 'weab-save-call-ready');
        if (document.readyState !== 'loading' && !root.classList.contains('weab-quiet')) {
          location.reload(); // Rensa redan synliga störningar i andra öppna flikar.
          return;
        }
        root.classList.add('weab-quiet');
        try { sessionStorage.removeItem(signalSessionKey); } catch { /* Privat läge. */ }
        window.clearTimeout(lockTimer);
        lockTimer = window.setTimeout(applyLockdown, quietUntil - now + 20);
        return;
      }
      if (root.classList.contains('weab-quiet')) {
        root.classList.remove('weab-quiet');
        location.reload(); // Ny slumpad session först när tystnaden löpt ut.
        return;
      }
      const until = readCookieExpiry(now);
      const notice = readNoticeExpiry(now);
      const wasLocked = root.classList.contains('weab-quarantined');

      if (until) {
        root.classList.remove('weab-save-call', 'weab-save-call-ready');
        window.clearTimeout(lockTimer);
        confirmedDisplayed = false;
        try { sessionStorage.removeItem(signalSessionKey); } catch { /* Privat läge. */ }
        root.classList.add('weab-quarantined');
        if (document.readyState !== 'loading') document.title = 'WeAB | Informationskontroll';
        const nextBeatMs = renderStruggle(until, now);
        if (!wasLocked) scheduleMicroTears();
        lockTimer = window.setTimeout(applyLockdown, Math.max(50, nextBeatMs + 12));
      } else if (notice && now >= notice) {
        root.classList.remove('weab-save-call', 'weab-save-call-ready');
        showConfirmed(now, notice);
      } else if (wasLocked) {
        // En bakgrundsflik kan ha sovit förbi exakt sluttid. Visa ändå
        // återtagningsmeddelandet innan en ny slumpad ARG-session startas.
        root.classList.remove('weab-save-call', 'weab-save-call-ready');
        showConfirmed(now, 0);
      } else {
        // Även en manuellt öppnad URL får samma kapade text före första paint.
        // Cookien försvinner först när spelaren själv väljer en RÄDDA DOM-länk.
        const invited = document.cookie.split(';').some(part =>
          part.trim() === invitationCookieName + '=1');
        root.classList.toggle('weab-save-call', invited);
        if (!invited) root.classList.remove('weab-save-call-ready');
      }
    }

    window.addEventListener('weab:camera-reaction', event => {
      const detail = event.detail;
      if (!detail || detail.key !== cameraStartedKey ||
          !root.classList.contains('weab-quarantined') ||
          root.classList.contains('weab-death-confirmed')) return;
      const reply = cameraScene[detail.status];
      if (typeof reply !== 'string') return;
      cameraReplyText = reply;
      cameraReplyStatus = detail.status;
      cameraReplyTime = Date.now();
      cameraReplyKey = detail.key + ':reaction:' + detail.status;
      applyLockdown();
    });

    applyLockdown(); // Körs innan BODY renderats.
    window.addEventListener('storage', event => {
      if (event.key === lockNoticeKey || event.key === 'weab:resistance:quiet') applyLockdown();
    });
    window.addEventListener('pageshow', event => {
      if (event.persisted && root.dataset.weabMorseRunning === '1') {
        // Återställ inte en redan korrumperad Morse-sida från historikcachen.
        location.reload();
        return;
      }
      applyLockdown();
    });
    window.addEventListener('focus', applyLockdown);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        updateSpiritVoice('', '', 0, 0, 'weak');
        updateSpiritPresence(false);
      }
      else applyLockdown();
    });
    document.addEventListener('DOMContentLoaded', () => {
      applyLockdown();
      if (location.pathname === '/' && root.classList.contains('weab-quiet')) {
        try {
          if (sessionStorage.getItem('weab:resistance:result:v1') === '1') {
            sessionStorage.removeItem('weab:resistance:result:v1');
            // RESULTAT.txt skapas en gång och levereras som en statisk fil.
            // Ingen Base64-beräkning eller filgenerering sker hos besökaren.
            const link = document.createElement('a');
            link.href = '/RESULTAT.txt';
            link.download = 'RESULTAT.txt';
            link.hidden = true;
            document.body.appendChild(link);
            link.click();
            link.remove();
          }
        } catch { /* Nedladdning beror på webbläsarens tillåtelse. */ }
      }
      if (root.classList.contains('weab-quarantined') &&
          !root.classList.contains('weab-death-confirmed')) {
        scheduleMicroTears();
      }
    });
  })();
 </script>
