---
import Logo from './Logo.astro';
const links=[{href:'/koncernen/',label:'Koncernen'},{href:'/verksamheter/',label:'Verksamheter'},{href:'/projekt/',label:'Projekt'},{href:'/nyheter/',label:'Nyheter'},{href:'/investerare/',label:'Investerare'},{href:'/karriar/',label:'Karriär'}];
---
<header class="site-header">
  <div class="shell topbar">
    <Logo />
    <nav class="desktop-links" aria-label="Huvudmeny">
      {links.map(item=><a href={item.href}>{item.label}</a>)}
    </nav>
    <a href="/kontakt/" class="nav-contact">Kontakt <span aria-hidden="true">↗</span></a>
    <details class="mobile-menu">
      <summary aria-label="Öppna meny"><span></span><span></span><span></span></summary>
      <nav aria-label="Mobilmeny">{links.map(item=><a href={item.href}>{item.label}</a>)}<a href="/kontakt/">Kontakt</a></nav>
    </details>
  </div>
</header>
<style>
  .site-header{position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(208,237,243,.12);background:rgba(10,18,24,.90);backdrop-filter:blur(20px)}
  .topbar{display:flex;align-items:center;gap:1.8rem;min-height:77px}
  .desktop-links{display:flex;align-items:center;gap:1.45rem;margin-left:auto}
  .desktop-links a{font-size:.86rem;color:#b1bec8;text-decoration:none;transition:color .2s}.desktop-links a:hover,.desktop-links a:focus{color:white}
  .nav-contact{white-space:nowrap;color:#06181e;background:var(--cyan);font-weight:800;font-size:.8rem;padding:.79rem 1.05rem;text-decoration:none;border-radius:.18rem}
  .mobile-menu{display:none;position:relative;margin-left:auto}
  .mobile-menu summary{cursor:pointer;list-style:none;width:38px;display:grid;gap:5px;padding:10px 6px}.mobile-menu summary::-webkit-details-marker{display:none}
  .mobile-menu summary span{height:2px;background:white;display:block}
  .mobile-menu nav{position:absolute;right:0;top:51px;width:min(80vw,290px);background:#13212b;border:1px solid #334550;padding:.65rem;box-shadow:0 20px 60px #0009;display:grid}
  .mobile-menu nav a{padding:12px;color:white;text-decoration:none;border-bottom:1px solid #283841}
  @media(max-width:1120px){.desktop-links{gap:.9rem}.desktop-links a{font-size:.78rem}.topbar{gap:1rem}}
  @media(max-width:920px){.desktop-links,.nav-contact{display:none}.mobile-menu{display:block}}
</style>
