---
import Logo from './Logo.astro';
const currentSection = Astro.url.pathname.split('/')[1];
const links=[{href:'/koncernen/',label:'Koncernen'},{href:'/verksamheter/',label:'Verksamheter'},{href:'/hallbarhet/',label:'Hållbarhet'},{href:'/press/',label:'Press'},{href:'/investerare/',label:'Investerare'},{href:'/karriar/',label:'Karriär'}];
---
<aside class="site-notice" aria-label="Driftmeddelande från WeAB">
  <div class="shell">
    <svg class="site-notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M10.3 4.4a2 2 0 0 1 3.4 0l8.1 13.4a2 2 0 0 1-1.7 3H3.9a2 2 0 0 1-1.7-3z" />
      <path d="M12 9v5" />
      <circle cx="12" cy="17.3" r=".85" fill="currentColor" stroke="none" />
    </svg>
    <p>Vi har mottagit rapporter om återgivningsfel och missförstånd kring vissa livsformer. Ärendet hanteras. – WeAB</p>
  </div>
</aside>
<header class="site-header">
  <div class="shell topbar">
    <Logo />
    <nav class="desktop-links" aria-label="Huvudmeny">
      {links.map(item=><a href={item.href} class:list={{ active: currentSection === item.href.split('/')[1] }} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a href="/kontakt/" class="nav-contact">Kontakt <span aria-hidden="true">↗</span></a>
    <details class="mobile-menu">
      <summary><span class="sr-only">Meny</span><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></summary>
      <nav aria-label="Mobilmeny">{links.map(item=><a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}<a href="/kontakt/" aria-current={Astro.url.pathname === '/kontakt/' ? 'page' : undefined}>Kontakt</a></nav>
    </details>
  </div>
</header>
<style>
  .site-notice{background:#e3c66f;border-bottom:1px solid #aa8d42}
  .site-notice .shell{display:flex;align-items:center;justify-content:center;gap:.55rem;padding:.6rem 0}
  .site-notice__icon{width:17px;height:17px;flex:none;color:#283026}
  .site-notice p{margin:0;color:#283026;font-size:.78rem;font-weight:600;line-height:1.45}
  .site-header{position:sticky;top:0;z-index:100;border-bottom:1px solid #32414b;background:#0b151d}
  .topbar{display:flex;align-items:center;gap:1.8rem;min-height:77px}
  .desktop-links{display:flex;align-items:center;gap:1.45rem;margin-left:auto}
  .desktop-links a{font-size:.86rem;color:#b1bec8;text-decoration:none;transition:color .2s}.desktop-links a:hover,.desktop-links a:focus-visible,.desktop-links a.active{color:white}
  .nav-contact{white-space:nowrap;color:#06181e;background:var(--cyan);font-weight:800;font-size:.8rem;padding:.79rem 1.05rem;text-decoration:none;border-radius:.18rem}
  .mobile-menu{display:none;position:relative;margin-left:auto}
  .mobile-menu summary{cursor:pointer;list-style:none;width:38px;display:grid;gap:5px;padding:10px 6px}.mobile-menu summary::-webkit-details-marker{display:none}
  .mobile-menu summary>span:not(.sr-only){height:2px;background:white;display:block}
  .mobile-menu nav{position:absolute;right:0;top:51px;width:min(84vw,320px);max-height:calc(100svh - 100px);overflow-y:auto;background:#13212b;border:1px solid #334550;padding:.65rem;box-shadow:0 12px 30px #0009;display:grid}
  .mobile-menu nav a{padding:12px;color:white;text-decoration:none;border-bottom:1px solid #283841}.mobile-menu nav a:last-child{border-bottom:0}.mobile-menu nav a[aria-current="page"]{color:#8ce9f5;background:#1a3540}
  @media(max-width:1120px){.desktop-links{gap:.9rem}.desktop-links a{font-size:.78rem}.topbar{gap:1rem}}
  @media(max-width:920px){.desktop-links,.nav-contact{display:none}.mobile-menu{display:block}}
</style>
