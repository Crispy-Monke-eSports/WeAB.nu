---
import type {Company} from '../data/companies';
interface Props {company:Company;}
const {company} = Astro.props;
---
<a class="company-card" href={`/verksamheter/${company.slug}/`} style={`--company-color:${company.accent}`}>
  <span class="company-card__top"><img class="company-card__logo" src={`/logos/${company.slug}.svg`} alt="" aria-hidden="true" width="174" height="97" /></span>
  <span class="company-card__kicker">{company.kicker}</span>
  <strong>{company.name}</strong>
  <span class="company-card__overview">{company.overview}</span>
  <span class="company-card__bottom"><span>{company.status}</span></span>
</a>
<style>
.company-card{display:flex;flex-direction:column;background:#18242d;border:1px solid #2b3b46;border-top:3px solid var(--company-color);border-radius:.28rem;padding:1.5rem;color:#f5f8f9;text-decoration:none;min-height:305px;transition:transform .22s,border-color .22s,background .22s}.company-card:hover{transform:translateY(-5px);background:#1c2c35;border-color:var(--company-color)}.company-card__top,.company-card__bottom{display:flex;align-items:center;justify-content:space-between}.company-card__logo{height:auto;width:4.9rem;aspect-ratio:174/97;object-fit:contain;image-rendering:pixelated}.company-card__arrow{color:#97a8b5;font-size:1.2rem}.company-card__kicker{color:#95aab5;letter-spacing:.16em;font-weight:700;font-size:.59rem;margin-top:1.8rem}.company-card strong{font-size:1.45rem;letter-spacing:-.045em;margin-top:.3rem}.company-card__overview{font-size:.86rem;line-height:1.55;color:#adbcc7;margin:.75rem 0 1.2rem}.company-card__bottom{border-top:1px solid #31414b;padding-top:.8rem;margin-top:auto;color:#869aa6;font-size:.75rem}
</style>
