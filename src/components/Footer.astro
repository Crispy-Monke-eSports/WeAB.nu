---
import Logo from './Logo.astro';
import { companies } from '../data/companies';
---
<footer class="footer">
  <div class="shell footer-grid">
    <div class="footer-about"><Logo/><p>En bättre värld. På våra villkor.</p><small>Koncernens intressen är alltid dina intressen. Eventuell avvikande uppfattning hanteras internt.</small></div>
    <div><h3>Koncernen</h3><a href="/koncernen/">Om WeAB</a><a href="/projekt/">Projekt</a><a href="/investerare/">Investerare</a><a href="/karriar/">Karriär</a></div>
    <div><h3>Verksamheter</h3>{companies.map(item=><a href={`/verksamheter/${item.slug}/`}>{item.name}</a>)}</div>
    <div><h3>Information</h3><a href="/nyheter/">Nyhetsrum</a><a href="/kontakt/">Kontakt</a><span>Valuta: diamanter</span></div>
  </div>
  <div class="shell footer-bottom"><span>© WeAB Group · En koncern. Alla lösningar.</span><span>Alla rättigheter förbehållna. Även dina.</span></div>
  <p class="shell fiction-notice">WeAB är ett påhittat företag på en Minecraft-server. Verksamheter, aktier och jobb på denna webbplats är del av satiren.</p>
</footer>
<style>
.footer{background:#081017;border-top:1px solid #2a3944;margin-top:7rem;padding:4rem 0 1.4rem}.footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:2.5rem}.footer-grid h3{text-transform:uppercase;letter-spacing:.18em;font-size:.7rem;color:#93a9b5;margin:0 0 1.3rem}.footer-grid a,.footer-grid span{display:block;color:#a3b2bb;text-decoration:none;font-size:.86rem;margin:.65rem 0}.footer-grid a:hover{color:#59d6e6}.footer-about p{font-size:1.15rem;margin:1.5rem 0 .7rem}.footer-about small{font-size:.75rem;line-height:1.6;color:#788a97;display:block;max-width:350px}.fiction-notice{font-size:.72rem;margin:1rem auto 0;color:#91a6b1;line-height:1.6}.footer-bottom{border-top:1px solid #26343c;margin-top:3.2rem;padding-top:1.2rem;display:flex;justify-content:space-between;gap:1rem;color:#687b87;font-size:.72rem}@media(max-width:800px){.footer-grid{grid-template-columns:1fr 1fr}.footer-about{grid-column:span 2}}@media(max-width:480px){.footer-grid{grid-template-columns:1fr 1fr;gap:2rem 1rem}.footer-about{grid-column:span 2}.footer-bottom{flex-direction:column}}
</style>
