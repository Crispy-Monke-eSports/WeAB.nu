---
import BrandMark from './BrandMark.astro';
---
<a class="brand" href="/" aria-label="WeAB – startsida">
  <BrandMark slug="weab" name="WeAB" size="header" />
  <span class="brand__type">THE WE GROUP</span>
</a>
<style>
  .brand{display:inline-flex;gap:.75rem;align-items:center;color:inherit;text-decoration:none;min-width:0}
  .brand__type{font-size:.56rem;letter-spacing:.14em;color:#b4c8d1;font-weight:800;line-height:1.65;max-width:90px}
  @media(max-width:470px){.brand__type{display:none}}
</style>
