---
/**
 * Gemensam ARG-signal: varje försök från den fångade rösten får ett kort
 * analogt bildbrott. Ljud är en valfri, lågmäld komplettering till bilden.
 * Ingen berättelseidentitet eller förklaring skrivs ut i besökarens DOM.
 */
---
<script>
  import { collectVisitorClues, selectVisitorWhisper, lookupNetworkClues,
    type NetworkClues } from '../data/visitorWhispers.ts';
  import { speechTiming, type VoiceProfile, type VoiceEntry } from '../data/spiritVoiceTiming.ts';
  import { loadCorruptionLoop } from '../data/corruptionAudio.ts';

  // Browsern kontaktar MyIP direkt. Behåll bara validerade orts-/nätetiketter
  // i flikens minne; aldrig IP, råsvar, koordinater, cookies eller lagring.
  let networkClues: NetworkClues | null = null;
  if (!document.documentElement.classList.contains('weab-quiet'))
    void lookupNetworkClues().then(clues => { networkClues = clues; });
  let hiddenBefore = false;
  let returnedToTab = false;
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) hiddenBefore = true;
    else if (hiddenBefore) returnedToTab = true;
  });
  window.addEventListener('weab:visitor-whisper', (event: Event) => {
    const detail = (event as CustomEvent<{ index: number; text?: string }>).detail;
    if (!detail) return;
    detail.text = selectVisitorWhisper(
      collectVisitorClues(window, document, returnedToTab), detail.index, networkClues
    );
  });
  window.addEventListener('weab:visitor-city', (event: Event) => {
    const detail = (event as CustomEvent<{ city?: string }>).detail;
    if (detail && networkClues?.city) detail.city = networkClues.city;
  });

  type Strength = 'soft' | 'medium' | 'harsh';
  type SpiritBurst = { strength?: Strength };
  type SpiritTyping = { active: boolean; strength?: Strength };
  let audio: AudioContext | null = null;
  let noise: AudioBuffer | null = null;
  let typingLive = false;
  let typingStrength: Strength = 'medium';
  let typingVisualTimer = 0;
  let typingNodes: {
    source: AudioBufferSourceNode;
    filter: BiquadFilterNode;
    gate: GainNode;
    compressor: DynamicsCompressorNode;
    tone: OscillatorNode;
    toneGain: GainNode;
    lfo: OscillatorNode;
    drift: GainNode;
  } | null = null;
  let bedBuffer: AudioBuffer | null = null;
  let bedLoading: Promise<AudioBuffer | null> | null = null;
  let bedNodes: { source: AudioBufferSourceNode; gain: GainNode;
    compressor: DynamicsCompressorNode } | null = null;
  let bedDeadline = 0;
  let presenceLive = false;
  let bedStartedAt = 0;
  let bedTimer = 0;
  let bedStrength: Strength = 'medium';
  let panicProgress = 0;
  let panicVoice: GainNode | null = null;

  function bedLevel(): number {
    // Det inspelade talet innehåller redan brus. Håll samma upplevda nivå
    // när en skärmglitch sker utan tal som medan rösten talar genom statiken.
    const base = voiceSources.length ? .10 :
      bedStrength === 'harsh' ? .16 : bedStrength === 'soft' ? .11 : .13;
    // Slutpanikens brus växer kontinuerligt, men komprimeras och håller
    // sig under en kontrollerad nivå även när rösten pågår.
    return panicProgress > 0 ? .10 + panicProgress * .22 : base;
  }

  function stopBed(): void {
    window.clearTimeout(bedTimer);
    bedTimer = 0;
    const nodes = bedNodes;
    bedNodes = null;
    if (!nodes || !audio) return;
    nodes.gain.gain.setTargetAtTime(.0001, audio.currentTime, .065);
    try { nodes.source.stop(audio.currentTime + .26); } catch { /* Redan avslutad. */ }
    nodes.source.onended = () => {
      nodes.source.disconnect();
      nodes.gain.disconnect();
      nodes.compressor.disconnect();
    };
  }

  function scheduleBedEnd(): void {
    window.clearTimeout(bedTimer);
    if (typingLive || presenceLive || !bedNodes) return;
    bedTimer = window.setTimeout(() => {
      if (typingLive || presenceLive || Date.now() < bedDeadline) scheduleBedEnd();
      else stopBed();
    }, Math.max(0, bedDeadline - Date.now()));
  }

  async function startBed(): Promise<void> {
    const ctx = audio;
    if (!ctx || ctx.state !== 'running' || document.hidden ||
      (!typingLive && !presenceLive && Date.now() >= bedDeadline)) return;
    if (bedNodes) {
      bedNodes.gain.gain.setTargetAtTime(bedLevel(), ctx.currentTime, .065);
      scheduleBedEnd();
      return;
    }
    bedLoading ??= loadCorruptionLoop(ctx);
    const buffer = bedBuffer ?? await bedLoading;
    if (buffer) bedBuffer = buffer;
    else bedLoading = null;
    if (!buffer || audio !== ctx || ctx.state !== 'running' || document.hidden || bedNodes ||
      (!typingLive && !presenceLive && Date.now() >= bedDeadline)) return;
    const source = ctx.createBufferSource();
    source.buffer = buffer;
    source.loop = true;
    const gain = ctx.createGain();
    gain.gain.setValueAtTime(.0001, ctx.currentTime);
    gain.gain.setTargetAtTime(bedLevel(), ctx.currentTime, .055);
    const compressor = ctx.createDynamicsCompressor();
    compressor.threshold.value = -28;
    compressor.ratio.value = 5;
    source.connect(gain);
    gain.connect(compressor);
    compressor.connect(ctx.destination);
    bedNodes = { source, gain, compressor };
    source.start(ctx.currentTime, ((Date.now() - bedStartedAt) / 1000 % buffer.duration +
      buffer.duration) % buffer.duration);
    scheduleBedEnd();
  }

  function sustainBed(strength: Strength, durationMs: number): void {
    bedStrength = strength;
    const now = Date.now();
    if (!bedNodes && now >= bedDeadline) bedStartedAt = now;
    bedDeadline = Math.max(bedDeadline, now + durationMs);
    primeRadio();
    void startBed();
  }

  let voiceGeneration = 0;
  let voiceAbort: AbortController | null = null;
  let voiceSources: AudioBufferSourceNode[] = [];
  let voiceNodes: AudioNode[] = [];
  let voiceKey = '';
  type VoiceRequest = { text: string; ageMs: number; durationMs: number; profile: VoiceProfile };
  let pendingVoice: VoiceRequest | null = null;

  async function loadVoice(ctx: AudioContext, entry: VoiceEntry,
    signal: AbortSignal): Promise<AudioBuffer | null> {
    const paths = entry.parts ?? (entry.file ? [entry.file] : []);
    if (!paths.length) return null;
    const clips = await Promise.all(paths.map(async path => {
      const response = await fetch('/audio/spirit/' + path, { signal });
      if (!response.ok) throw new Error('Voice fragment missing');
      return ctx.decodeAudioData(await response.arrayBuffer());
    }));
    if (clips.length === 1) return clips[0];
    // Join only the currently spoken line in memory. The recorded word marks
    // already include each fragment's silence and remain aligned after joining.
    const channels = clips[0].numberOfChannels;
    const length = clips.reduce((sum, clip) => sum + clip.length, 0);
    const joined = ctx.createBuffer(channels, length, ctx.sampleRate);
    let offset = 0;
    for (const clip of clips) {
      for (let channel = 0; channel < channels; channel++)
        joined.getChannelData(channel).set(clip.getChannelData(channel), offset);
      offset += clip.length;
    }
    return joined;
  }

  function stopVoice(): void {
    panicVoice = null;
    voiceGeneration++;
    voiceAbort?.abort();
    voiceAbort = null;
    for (const source of voiceSources) {
      try { source.stop(); } catch { /* Har redan slutat. */ }
      source.disconnect();
    }
    voiceSources = [];
    for (const node of voiceNodes) node.disconnect();
    voiceNodes = [];
    if (typingNodes && audio?.state === 'running') {
      typingNodes.gate.gain.setTargetAtTime(typingStrength === 'harsh' ? .60 :
        typingStrength === 'soft' ? .32 : .48, audio.currentTime, .07);
    }
    if (bedNodes && audio?.state === 'running')
      bedNodes.gain.gain.setTargetAtTime(bedLevel(), audio.currentTime, .06);
  }

  async function speak(request: VoiceRequest): Promise<void> {
    stopVoice();
    pendingVoice = request;
    const timing = speechTiming(request.text, request.durationMs);
    if (!timing || document.hidden) return; // Dynamiska tal utan exakt fil förblir tysta.
    primeRadio();
    const ctx = audio;
    if (!ctx || ctx.state !== 'running') return;
    const generation = voiceGeneration;
    const controller = new AbortController();
    voiceAbort = controller;
    try {
      // Endast aktuell replik och dess återanvändbara delar hämtas.
      const decoded = await loadVoice(ctx, timing.entry, controller.signal);
      if (!decoded) return;
      if (generation !== voiceGeneration || document.hidden || ctx.state !== 'running') return;
      // Distortion, detuned layers and continuous radio hiss are baked into
      // the Ogg file. Playback only handles timing, a soft fade and a limiter.
      // Fetch/decode may have taken time: align with the cookie clock, not network time.
      // Quarantine calls supply an age relative to its beat; advance by elapsed wall time.
      const age = request.ageMs + (Date.now() - requestedAt);
      const offset = Math.max(0, age * timing.rate / 1000);
      if (age >= timing.durationMs || offset >= decoded.duration) return;
      const output = ctx.createGain();
      const compressor = ctx.createDynamicsCompressor();
      compressor.threshold.value = -29;
      compressor.ratio.value = 6;
      compressor.attack.value = .006;
      compressor.release.value = .14;
      output.gain.setValueAtTime(.0001, ctx.currentTime);
      const voiceLevel = panicProgress > 0 ? .72 + panicProgress * .10 : .72;
      output.gain.linearRampToValueAtTime(voiceLevel, ctx.currentTime + .045);
      const remaining = (timing.durationMs - age) / 1000;
      output.gain.setValueAtTime(voiceLevel, ctx.currentTime + Math.max(.045, remaining - .065));
      output.gain.linearRampToValueAtTime(.0001, ctx.currentTime + remaining);
      output.connect(compressor);
      compressor.connect(ctx.destination);

      voiceNodes = [output, compressor];
      if (panicProgress > 0) panicVoice = output;
      const source = ctx.createBufferSource();
      source.buffer = decoded;
      source.playbackRate.value = timing.rate;
      source.connect(output);
      source.start(ctx.currentTime, offset);
      // Originalradion fortsätter, men duckas under tal så att konsonanter
      // faktiskt går att uppfatta genom det redan inbakade kortvågsbruset.
      if (typingNodes) typingNodes.gate.gain.setTargetAtTime(.06, ctx.currentTime, .05);
      source.stop(ctx.currentTime + remaining);
      voiceSources.push(source);
      if (bedNodes) bedNodes.gain.gain.setTargetAtTime(bedLevel(), ctx.currentTime, .06);
      source.onended = () => source.disconnect();
    } catch { /* Fil, dekodning och autoplay är valfria; ARG-tiden fortsätter. */ }
  }

  let requestedAt = 0;
  window.addEventListener('weab:voice-speak', (event: Event) => {
    const detail = (event as CustomEvent<VoiceRequest>).detail;
    if (!detail || voiceKey === detail.text + ':' + detail.ageMs) return;
    voiceKey = detail.text + ':' + detail.ageMs;
    requestedAt = Date.now();
    void speak(detail);
  });
  window.addEventListener('weab:voice-stop', () => {
    pendingVoice = null;
    voiceKey = '';
    stopVoice();
  });

  function primeRadio(): void {
    if (typeof AudioContext === 'undefined' || document.hidden) return;
    try {
      if (!audio || audio.state === 'closed') {
        audio = new AudioContext();
        noise = null;
      }
      if (audio.state === 'suspended') {
        void audio.resume().then(() => {
          if (typingLive) startTypingAudio();
          void startBed();
          if (pendingVoice) {
            const resumed = { ...pendingVoice,
              ageMs: pendingVoice.ageMs + Date.now() - requestedAt };
            requestedAt = Date.now();
            if (resumed.ageMs < resumed.durationMs) void speak(resumed);
          }
        }).catch(() => {});
      } else {
        if (typingLive) startTypingAudio();
        void startBed();
      }
    } catch { /* Web Audio är valfritt; bildstörningen körs ändå. */ }
  }

  // En normal interaktion får lov att aktivera ljudet för kommande händelser.
  // Ingen begäran om ljudtillstånd, ingen knapp och inget automatiskt högt ljud.
  window.addEventListener('pointerdown', primeRadio, { passive: true });
  window.addEventListener('keydown', primeRadio);
  window.addEventListener('touchstart', primeRadio, { passive: true });

  let residue: HTMLElement | null = null;
  let residueTimer = 0;
  let panicTear: HTMLElement | null = null;
  let panicTearTimer = 0;

  function analogTear(strength: Strength): void {
    const quarantine = document.documentElement.classList.contains('weab-quarantined');
    const parent = quarantine
      ? document.getElementById('weab-quarantine')
      : document.querySelector<HTMLElement>('[data-resistance-interference]:not([hidden])') ??
        document.querySelector<HTMLElement>('[data-resistance-eye-noise]:not([hidden])') ??
        document.body;
    if (!parent) return;

    const inPanic = Boolean(document.querySelector('[data-save-game].save-game--panic'));
    // Paniken skickar många bursts. Ett enda återanvänt helskärmslager får
    // byta position och bruskaraktär; Safari slipper samtidigt tiotals stora
    // blend-/animationslager. Normala ARG-intrång behåller sitt gamla förlopp.
    const reuse = inPanic && panicTear?.parentElement === parent;
    const strip = reuse ? panicTear! : document.createElement('span');
    if (!reuse) {
      strip.className = 'weab-analog-tear' +
        (parent === document.body ? ' weab-analog-tear--page' : '');
      strip.setAttribute('aria-hidden', 'true');
      parent.appendChild(strip);
    }
    strip.style.setProperty('--analog-y', (13 + Math.random() * 69).toFixed(1) + '%');
    strip.style.setProperty('--analog-offset', (Math.random() * 22 - 11).toFixed(0) + 'px');
    strip.style.setProperty('--analog-ghost', strength === 'harsh' ? '.35' : '.19');
    if (inPanic) {
      panicTear = strip;
      strip.style.animation = 'none';
      strip.style.opacity = '.62';
      window.clearTimeout(panicTearTimer);
      panicTearTimer = window.setTimeout(() => {
        if (panicTear === strip) {
          strip.remove();
          panicTear = null;
        }
      }, 2_000);
    } else {
      window.setTimeout(() => strip.remove(), strength === 'harsh' ? 1_850 : 1_550);
    }

    // Ett enda kvarvarande lager även under tusentals störningar.
    // Intrångslagret kan döljas när fasen är klar; efterbilden ligger på sidan.
    const residueParent = quarantine ? parent : document.body;
    if (!residue || residue.parentElement !== residueParent) {
      residue?.remove();
      residue = document.createElement('span');
      residue.className = 'weab-analog-residue' +
        (residueParent === document.body ? ' weab-analog-residue--page' : '');
      residue.setAttribute('aria-hidden', 'true');
      residueParent.appendChild(residue);
    }
    if (inPanic) {
      residue.style.animation = 'none';
      residue.style.opacity = '.28';
    } else {
      residue.style.animation = '';
      residue.style.opacity = '';
    }
    window.clearTimeout(residueTimer);
    residueTimer = window.setTimeout(() => {
      residue?.remove();
      residue = null;
    }, strength === 'harsh' ? 5_200 : 4_600);
  }

  function analogNoise(): AudioBuffer | null {
    if (!audio) return null;
    if (noise && noise.sampleRate === audio.sampleRate) return noise;
    const buffer = audio.createBuffer(1, Math.ceil(audio.sampleRate * .32), audio.sampleRate);
    const samples = buffer.getChannelData(0);
    // Ojämnt radiosus med snabba glapp och gamla AM-liknande artefakter.
    for (let i = 0; i < samples.length; i++) {
      const dropout = i % 503 < 11 ? .14 : 1;
      samples[i] = (Math.random() * 2 - 1) * dropout;
    }
    noise = buffer;
    return noise;
  }

  function playRadio(strength: Strength): void {
    if (document.hidden) return;
    primeRadio();
    if (!audio || audio.state !== 'running') return;
    const ctx = audio;
    const buffer = analogNoise();
    if (!buffer) return;

    const amount = strength === 'soft' ? .38 : strength === 'harsh' ? .78 : .55;
    const begin = ctx.currentTime + .008;
    const master = ctx.createGain();
    master.gain.value = .19; // Tydlig radiovolym, utan höga jumpscare-toppar.
    master.connect(ctx.destination);

    const pulses = strength === 'harsh' ? 4 : strength === 'soft' ? 2 : 3;
    for (let i = 0; i < pulses; i++) {
      const at = begin + i * .092 + Math.random() * .027;
      const duration = .065 + Math.random() * .067;
      const crackle = ctx.createBufferSource();
      crackle.buffer = buffer;
      crackle.playbackRate.value = .78 + Math.random() * .38;
      const radio = ctx.createBiquadFilter();
      radio.type = 'bandpass';
      radio.frequency.value = 570 + Math.random() * 1250;
      radio.Q.value = 1.4 + Math.random() * 3.2;
      const gate = ctx.createGain();
      gate.gain.setValueAtTime(.0001, at);
      gate.gain.linearRampToValueAtTime(amount * (.28 + Math.random() * .19), at + .012);
      gate.gain.exponentialRampToValueAtTime(.0001, at + duration);
      crackle.connect(radio);
      radio.connect(gate);
      gate.connect(master);
      crackle.start(at);
      crackle.stop(at + duration);
      crackle.onended = () => {
        crackle.disconnect();
        radio.disconnect();
        gate.disconnect();
      };
    }

    // En nästan röstliknande, instabil bärvåg bakom bruset.
    // Formantbrus, inte inspelat tal eller syntetiskt begripliga stavelser.
    const ghost = ctx.createOscillator();
    ghost.type = 'sine';
    const ghostGain = ctx.createGain();
    ghost.frequency.setValueAtTime(185 + Math.random() * 70, begin);
    ghost.frequency.linearRampToValueAtTime(116 + Math.random() * 60, begin + .29);
    ghostGain.gain.setValueAtTime(.0001, begin);
    ghostGain.gain.linearRampToValueAtTime(.045 * amount, begin + .06);
    ghostGain.gain.exponentialRampToValueAtTime(.0001, begin + .34);
    ghost.connect(ghostGain);
    ghostGain.connect(master);
    ghost.start(begin);
    ghost.stop(begin + .35);
    ghost.onended = () => {
      ghost.disconnect();
      ghostGain.disconnect();
      master.disconnect();
    };
  }

  function startTypingAudio(): void {
    const ctx = audio;
    if (!typingLive || typingNodes || !ctx || ctx.state !== 'running') return;
    const buffer = analogNoise();
    if (!buffer) return;

    // Löpande, lågmält AM-/kortvågsbrus med en instabil, nästan mänsklig
    // underton. Ljudet går i en mjuk kompressor och saknar plötsliga toppar.
    const source = ctx.createBufferSource();
    source.buffer = buffer;
    source.loop = true;
    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.value = typingStrength === 'harsh' ? 1780 :
      typingStrength === 'soft' ? 820 : 1160;
    filter.Q.value = .68;
    const gate = ctx.createGain();
    gate.gain.setValueAtTime(.0001, ctx.currentTime);
    gate.gain.setTargetAtTime(typingStrength === 'harsh' ? .60 :
      typingStrength === 'soft' ? .32 : .48, ctx.currentTime, .075);
    const compressor = ctx.createDynamicsCompressor();
    compressor.threshold.value = -24;
    compressor.knee.value = 14;
    compressor.ratio.value = 3.8;
    compressor.attack.value = .004;
    compressor.release.value = .16;
    source.connect(filter);
    filter.connect(gate);
    gate.connect(compressor);
    compressor.connect(ctx.destination);

    const tone = ctx.createOscillator();
    tone.type = 'sine';
    tone.frequency.value = typingStrength === 'harsh' ? 214 :
      typingStrength === 'soft' ? 138 : 156;
    const toneGain = ctx.createGain();
    toneGain.gain.value = typingStrength === 'harsh' ? .12 :
      typingStrength === 'soft' ? .06 : .085;
    const lfo = ctx.createOscillator();
    lfo.type = 'sine';
    lfo.frequency.value = 5.7;
    const drift = ctx.createGain();
    drift.gain.value = 13;
    lfo.connect(drift);
    drift.connect(tone.frequency);
    tone.connect(toneGain);
    toneGain.connect(compressor);

    typingNodes = { source, filter, gate, compressor, tone, toneGain, lfo, drift };
    source.start();
    tone.start();
    lfo.start();
  }

  function stopTypingAudio(): void {
    const nodes = typingNodes;
    typingNodes = null;
    if (!nodes || !audio) return;
    const now = audio.currentTime;
    nodes.gate.gain.setTargetAtTime(.0001, now, .045);
    nodes.toneGain.gain.setTargetAtTime(.0001, now, .045);
    const end = now + .22;
    try { nodes.source.stop(end); } catch { /* Sidan har redan stängts. */ }
    try { nodes.tone.stop(end); } catch { /* Sidan har redan stängts. */ }
    try { nodes.lfo.stop(end); } catch { /* Sidan har redan stängts. */ }
    nodes.source.onended = () => {
      nodes.source.disconnect();
      nodes.filter.disconnect();
      nodes.gate.disconnect();
      nodes.tone.disconnect();
      nodes.toneGain.disconnect();
      nodes.lfo.disconnect();
      nodes.drift.disconnect();
      nodes.compressor.disconnect();
    };
  }

  function typingScreenTear(): void {
    if (!typingLive || document.hidden) return;
    // Även när webbläsaren blockerar Web Audio fortsätter dessa analoga
    // bildbrott under precis hela tiden som tecknen renderas fram.
    analogTear(typingStrength === 'harsh' ? 'harsh' : 'medium');
    typingVisualTimer = window.setTimeout(typingScreenTear,
      340 + Math.floor(Math.random() * 250));
  }

  window.addEventListener('weab:spirit-typing', (event: Event) => {
    const detail = (event as CustomEvent<SpiritTyping>).detail;
    const active = Boolean(detail?.active);
    const nextStrength: Strength = detail?.strength === 'harsh' ||
      detail?.strength === 'soft' ? detail.strength : 'medium';
    if (active && !typingLive) {
      typingStrength = nextStrength;
      typingLive = true;
      document.documentElement.classList.add('weab-spirit-transmitting');
      typingScreenTear();
      sustainBed(nextStrength, 1_500);
      primeRadio();
      startTypingAudio();
    } else if (active && typingLive && typingStrength !== nextStrength) {
      stopTypingAudio();
      typingStrength = nextStrength;
      sustainBed(nextStrength, 1_500);
      startTypingAudio();
    } else if (!active && typingLive) {
      typingLive = false;
      document.documentElement.classList.remove('weab-spirit-transmitting');
      window.clearTimeout(typingVisualTimer);
      stopTypingAudio();
      bedDeadline = Math.max(bedDeadline, Date.now() + 1_300);
      scheduleBedEnd();
    }
  });
  window.addEventListener('weab:spirit-presence', (event: Event) => {
    presenceLive = Boolean((event as CustomEvent<{ active: boolean }>).detail?.active);
    if (presenceLive) sustainBed(typingStrength, 0);
    else {
      bedDeadline = 0;
      stopBed();
    }
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopVoice();
      bedDeadline = 0;
      stopBed();
      window.clearTimeout(typingVisualTimer);
      stopTypingAudio();
    } else if (typingLive) {
      typingScreenTear();
      primeRadio();
      startTypingAudio();
    } else if (presenceLive) {
      primeRadio();
      void startBed();
    }
  });

  // Den här händelsen avfyras ENDAST när själen försöker nå fram.
  // Visuell störning skapas först och ljud får aldrig köras ensamt.
  window.addEventListener('weab:spirit-burst', (event: Event) => {
    if (document.documentElement.classList.contains('weab-quiet')) return;
    const raw = (event as CustomEvent<SpiritBurst>).detail?.strength;
    const strength: Strength = raw === 'soft' || raw === 'harsh' ? raw : 'medium';
    analogTear(strength);
    playRadio(strength);
    sustainBed(strength, strength === 'harsh' ? 2_700 : 2_200);
  });
  window.addEventListener('weab:spirit-sustain', (event: Event) => {
    if (document.documentElement.classList.contains('weab-quiet')) return;
    const detail = (event as CustomEvent<{ strength: Strength; durationMs: number }>).detail;
    if (!detail || !Number.isFinite(detail.durationMs)) return;
    sustainBed(detail.strength, Math.max(0, Math.min(8_000, detail.durationMs)));
  });
  window.addEventListener('weab:spirit-panic-progress', (event: Event) => {
    const value = (event as CustomEvent<{ progress: number }>).detail?.progress;
    if (!Number.isFinite(value)) return;
    panicProgress = Math.max(0, Math.min(1, value));
    // Volymen växer jämnt utan slump eller backningar. Kompressorn förhindrar toppar.
    if (bedNodes && audio?.state === 'running')
      bedNodes.gain.gain.setTargetAtTime(bedLevel(), audio.currentTime, .13);
    if (panicVoice && audio?.state === 'running')
      panicVoice.gain.setTargetAtTime(.72 + panicProgress * .10, audio.currentTime, .18);
  });
  window.addEventListener('weab:resistance-morse-start', () => {
    bedDeadline = 0;
    stopBed();
  });
  window.addEventListener('pagehide', () => {
    panicProgress = 0;
    window.clearTimeout(panicTearTimer);
    panicTear?.remove();
    panicTear = null;
    window.clearTimeout(residueTimer);
    residue?.remove();
    residue = null;
    pendingVoice = null;
    stopVoice();
    presenceLive = false;
    bedDeadline = 0;
    stopBed();
    typingLive = false;
    window.clearTimeout(typingVisualTimer);
    stopTypingAudio();
    if (audio) void audio.close().catch(() => {});
    audio = null;
    noise = null;
  });
</script>

