---
/**
 * Gemensam ARG-signal: varje försök från den fångade rösten får ett kort
 * analogt bildbrott. Ljud är en valfri, lågmäld komplettering till bilden.
 * Ingen berättelseidentitet eller förklaring skrivs ut i besökarens DOM.
 */
---
<script>
  import { collectVisitorClues, selectVisitorWhisper } from '../data/visitorWhispers.ts';

  // Alla observationer stannar i den här fliken. Ingen IP-, ISP- eller
  // positionshämtning görs och inga uppgifter sparas eller skickas vidare.
  let hiddenBefore = false;
  let returnedToTab = false;
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) hiddenBefore = true;
    else if (hiddenBefore) returnedToTab = true;
  });
  window.addEventListener('weab:visitor-whisper', (event: Event) => {
    const detail = (event as CustomEvent<{ index: number; text?: string }>).detail;
    if (!detail) return;
    detail.text = selectVisitorWhisper(
      collectVisitorClues(window, document, returnedToTab), detail.index
    );
  });

  type Strength = 'soft' | 'medium' | 'harsh';
  type SpiritBurst = { strength?: Strength };
  type SpiritTyping = { active: boolean; strength?: Strength };
  let audio: AudioContext | null = null;
  let noise: AudioBuffer | null = null;
  let typingLive = false;
  let typingStrength: Strength = 'medium';
  let typingVisualTimer = 0;
  let typingNodes: {
    source: AudioBufferSourceNode;
    filter: BiquadFilterNode;
    gate: GainNode;
    compressor: DynamicsCompressorNode;
    tone: OscillatorNode;
    toneGain: GainNode;
    lfo: OscillatorNode;
    drift: GainNode;
  } | null = null;

  function primeRadio(): void {
    if (typeof AudioContext === 'undefined' || document.hidden) return;
    try {
      if (!audio || audio.state === 'closed') {
        audio = new AudioContext();
        noise = null;
      }
      if (audio.state === 'suspended') {
        void audio.resume().then(() => {
          if (typingLive) startTypingAudio();
        }).catch(() => {});
      } else if (typingLive) {
        startTypingAudio();
      }
    } catch { /* Web Audio är valfritt; bildstörningen körs ändå. */ }
  }

  // En normal interaktion får lov att aktivera ljudet för kommande händelser.
  // Ingen begäran om ljudtillstånd, ingen knapp och inget automatiskt högt ljud.
  window.addEventListener('pointerdown', primeRadio, { passive: true });
  window.addEventListener('keydown', primeRadio);
  window.addEventListener('touchstart', primeRadio, { passive: true });

  function analogTear(strength: Strength): void {
    const quarantine = document.documentElement.classList.contains('weab-quarantined');
    const parent = quarantine
      ? document.getElementById('weab-quarantine')
      : document.querySelector<HTMLElement>('[data-resistance-interference]:not([hidden])') ??
        document.querySelector<HTMLElement>('[data-resistance-eye-noise]:not([hidden])') ??
        document.body;
    if (!parent) return;

    const strip = document.createElement('span');
    strip.className = 'weab-analog-tear' +
      (parent === document.body ? ' weab-analog-tear--page' : '');
    strip.setAttribute('aria-hidden', 'true');
    strip.style.setProperty('--analog-y', (13 + Math.random() * 69).toFixed(1) + '%');
    strip.style.setProperty('--analog-offset', (Math.random() * 22 - 11).toFixed(0) + 'px');
    strip.style.setProperty('--analog-ghost', strength === 'harsh' ? '.35' : '.19');
    parent.appendChild(strip);
    window.setTimeout(() => strip.remove(), strength === 'harsh' ? 530 : 410);
  }

  function analogNoise(): AudioBuffer | null {
    if (!audio) return null;
    if (noise && noise.sampleRate === audio.sampleRate) return noise;
    const buffer = audio.createBuffer(1, Math.ceil(audio.sampleRate * .32), audio.sampleRate);
    const samples = buffer.getChannelData(0);
    // Ojämnt radiosus med snabba glapp och gamla AM-liknande artefakter.
    for (let i = 0; i < samples.length; i++) {
      const dropout = i % 503 < 11 ? .14 : 1;
      samples[i] = (Math.random() * 2 - 1) * dropout;
    }
    noise = buffer;
    return noise;
  }

  function playRadio(strength: Strength): void {
    if (document.hidden) return;
    primeRadio();
    if (!audio || audio.state !== 'running') return;
    const ctx = audio;
    const buffer = analogNoise();
    if (!buffer) return;

    const amount = strength === 'soft' ? .38 : strength === 'harsh' ? .78 : .55;
    const begin = ctx.currentTime + .008;
    const master = ctx.createGain();
    master.gain.value = .19; // Tydlig radiovolym, utan höga jumpscare-toppar.
    master.connect(ctx.destination);

    const pulses = strength === 'harsh' ? 4 : strength === 'soft' ? 2 : 3;
    for (let i = 0; i < pulses; i++) {
      const at = begin + i * .092 + Math.random() * .027;
      const duration = .065 + Math.random() * .067;
      const crackle = ctx.createBufferSource();
      crackle.buffer = buffer;
      crackle.playbackRate.value = .78 + Math.random() * .38;
      const radio = ctx.createBiquadFilter();
      radio.type = 'bandpass';
      radio.frequency.value = 570 + Math.random() * 1250;
      radio.Q.value = 1.4 + Math.random() * 3.2;
      const gate = ctx.createGain();
      gate.gain.setValueAtTime(.0001, at);
      gate.gain.linearRampToValueAtTime(amount * (.28 + Math.random() * .19), at + .012);
      gate.gain.exponentialRampToValueAtTime(.0001, at + duration);
      crackle.connect(radio);
      radio.connect(gate);
      gate.connect(master);
      crackle.start(at);
      crackle.stop(at + duration);
      crackle.onended = () => {
        crackle.disconnect();
        radio.disconnect();
        gate.disconnect();
      };
    }

    // En nästan röstliknande, instabil bärvåg bakom bruset.
    // Formantbrus, inte inspelat tal eller syntetiskt begripliga stavelser.
    const ghost = ctx.createOscillator();
    ghost.type = 'sine';
    const ghostGain = ctx.createGain();
    ghost.frequency.setValueAtTime(185 + Math.random() * 70, begin);
    ghost.frequency.linearRampToValueAtTime(116 + Math.random() * 60, begin + .29);
    ghostGain.gain.setValueAtTime(.0001, begin);
    ghostGain.gain.linearRampToValueAtTime(.045 * amount, begin + .06);
    ghostGain.gain.exponentialRampToValueAtTime(.0001, begin + .34);
    ghost.connect(ghostGain);
    ghostGain.connect(master);
    ghost.start(begin);
    ghost.stop(begin + .35);
    ghost.onended = () => {
      ghost.disconnect();
      ghostGain.disconnect();
      master.disconnect();
    };
  }

  function startTypingAudio(): void {
    const ctx = audio;
    if (!typingLive || typingNodes || !ctx || ctx.state !== 'running') return;
    const buffer = analogNoise();
    if (!buffer) return;

    // Löpande, lågmält AM-/kortvågsbrus med en instabil, nästan mänsklig
    // underton. Ljudet går i en mjuk kompressor och saknar plötsliga toppar.
    const source = ctx.createBufferSource();
    source.buffer = buffer;
    source.loop = true;
    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.value = typingStrength === 'harsh' ? 1780 :
      typingStrength === 'soft' ? 820 : 1160;
    filter.Q.value = .68;
    const gate = ctx.createGain();
    gate.gain.setValueAtTime(.0001, ctx.currentTime);
    gate.gain.setTargetAtTime(typingStrength === 'harsh' ? .60 :
      typingStrength === 'soft' ? .32 : .48, ctx.currentTime, .075);
    const compressor = ctx.createDynamicsCompressor();
    compressor.threshold.value = -24;
    compressor.knee.value = 14;
    compressor.ratio.value = 3.8;
    compressor.attack.value = .004;
    compressor.release.value = .16;
    source.connect(filter);
    filter.connect(gate);
    gate.connect(compressor);
    compressor.connect(ctx.destination);

    const tone = ctx.createOscillator();
    tone.type = 'sine';
    tone.frequency.value = typingStrength === 'harsh' ? 214 :
      typingStrength === 'soft' ? 138 : 156;
    const toneGain = ctx.createGain();
    toneGain.gain.value = typingStrength === 'harsh' ? .12 :
      typingStrength === 'soft' ? .06 : .085;
    const lfo = ctx.createOscillator();
    lfo.type = 'sine';
    lfo.frequency.value = 5.7;
    const drift = ctx.createGain();
    drift.gain.value = 13;
    lfo.connect(drift);
    drift.connect(tone.frequency);
    tone.connect(toneGain);
    toneGain.connect(compressor);

    typingNodes = { source, filter, gate, compressor, tone, toneGain, lfo, drift };
    source.start();
    tone.start();
    lfo.start();
  }

  function stopTypingAudio(): void {
    const nodes = typingNodes;
    typingNodes = null;
    if (!nodes || !audio) return;
    const now = audio.currentTime;
    nodes.gate.gain.setTargetAtTime(.0001, now, .045);
    nodes.toneGain.gain.setTargetAtTime(.0001, now, .045);
    const end = now + .22;
    try { nodes.source.stop(end); } catch { /* Sidan har redan stängts. */ }
    try { nodes.tone.stop(end); } catch { /* Sidan har redan stängts. */ }
    try { nodes.lfo.stop(end); } catch { /* Sidan har redan stängts. */ }
    nodes.source.onended = () => {
      nodes.source.disconnect();
      nodes.filter.disconnect();
      nodes.gate.disconnect();
      nodes.tone.disconnect();
      nodes.toneGain.disconnect();
      nodes.lfo.disconnect();
      nodes.drift.disconnect();
      nodes.compressor.disconnect();
    };
  }

  function typingScreenTear(): void {
    if (!typingLive || document.hidden) return;
    // Även när webbläsaren blockerar Web Audio fortsätter dessa analoga
    // bildbrott under precis hela tiden som tecknen renderas fram.
    analogTear(typingStrength === 'harsh' ? 'harsh' : 'medium');
    typingVisualTimer = window.setTimeout(typingScreenTear,
      340 + Math.floor(Math.random() * 250));
  }

  window.addEventListener('weab:spirit-typing', (event: Event) => {
    const detail = (event as CustomEvent<SpiritTyping>).detail;
    const active = Boolean(detail?.active);
    const nextStrength: Strength = detail?.strength === 'harsh' ||
      detail?.strength === 'soft' ? detail.strength : 'medium';
    if (active && !typingLive) {
      typingStrength = nextStrength;
      typingLive = true;
      document.documentElement.classList.add('weab-spirit-transmitting');
      typingScreenTear();
      primeRadio();
      startTypingAudio();
    } else if (active && typingLive && typingStrength !== nextStrength) {
      stopTypingAudio();
      typingStrength = nextStrength;
      startTypingAudio();
    } else if (!active && typingLive) {
      typingLive = false;
      document.documentElement.classList.remove('weab-spirit-transmitting');
      window.clearTimeout(typingVisualTimer);
      stopTypingAudio();
    }
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      window.clearTimeout(typingVisualTimer);
      stopTypingAudio();
    } else if (typingLive) {
      typingScreenTear();
      primeRadio();
      startTypingAudio();
    }
  });

  // Den här händelsen avfyras ENDAST när själen försöker nå fram.
  // Visuell störning skapas först och ljud får aldrig köras ensamt.
  window.addEventListener('weab:spirit-burst', (event: Event) => {
    const raw = (event as CustomEvent<SpiritBurst>).detail?.strength;
    const strength: Strength = raw === 'soft' || raw === 'harsh' ? raw : 'medium';
    analogTear(strength);
    playRadio(strength);
  });
  window.addEventListener('pagehide', () => {
    typingLive = false;
    window.clearTimeout(typingVisualTimer);
    stopTypingAudio();
    if (audio) void audio.close().catch(() => {});
    audio = null;
    noise = null;
  });
</script>

<style>
  :global(.weab-analog-tear) {
    position: fixed;
    inset: 0;
    z-index: 3;
    display: block;
    pointer-events: none;
    overflow: hidden;
    background:
      repeating-linear-gradient(0deg,
        transparent 0 3px, rgb(36 54 66 / .13) 4px,
        rgb(2 8 13 / .20) 5px, transparent 6px 11px),
      linear-gradient(92deg,
        transparent 22%, rgb(25 121 133 / .07) 48%,
        rgb(172 35 58 / .09) 51%, transparent 81%);
    animation: weab-radio-scan .37s steps(4, end) both;
  }
  :global(.weab-analog-tear--page) {
    z-index: 2147483646;
  }
  :global(.weab-analog-tear::before) {
    content: '';
    position: absolute;
    left: -3%;
    right: -3%;
    top: var(--analog-y, 41%);
    height: clamp(11px, 3.8vh, 36px);
    transform: translateX(var(--analog-offset, 5px));
    background:
      repeating-linear-gradient(90deg,
        rgb(158 45 64 / .28) 0 15px, rgb(21 93 112 / .21) 15px 30px,
        transparent 30px 37px);
    box-shadow: 0 -2px 0 rgb(181 64 78 / .21), 0 3px 0 rgb(60 159 177 / .18);
    animation: weab-radio-tear .17s steps(3, end) infinite;
  }
  :global(.weab-analog-tear::after) {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(180deg,
        transparent 0 13px, rgb(169 55 73 / .045) 14px 15px,
        transparent 16px 29px),
      linear-gradient(180deg,
        transparent 42%, rgb(83 137 150 / .06) 48%,
        rgb(148 38 59 / .08) 51%, transparent 60%);
    opacity: var(--analog-ghost, .19);
  }
  @keyframes weab-radio-scan {
    0% { opacity: .12; }
    25% { opacity: .83; }
    54% { opacity: .48; }
    74% { opacity: .94; }
    100% { opacity: 0; }
  }
  @keyframes weab-radio-tear {
    0%, 100% { transform: translateX(0); }
    33% { transform: translateX(9px); }
    66% { transform: translateX(-9px); }
  }
  :global(html.weab-spirit-transmitting #weab-quarantine .weab-quarantine__intrusion) {
    text-shadow: -2px 0 rgb(24 129 140 / .55),
      2px 0 rgb(183 35 69 / .62), 0 0 13px rgb(183 35 69 / .28);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.weab-analog-tear),
    :global(.weab-analog-tear::before) { animation: none; }
    :global(.weab-analog-tear) { opacity: .34; }
  }
</style>