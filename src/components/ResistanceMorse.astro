---
/**
 * Samma fångade avsändare använder även en avkodningsbar Morse-signal.
 * Terminal ARG-effekt på ALLA sidor som startas av ResistanceInterference.
 * Scrolling och länkar ska fungera medan sidan gradvis korrumperas.
 */
---
<div class="resistance-morse-veil" data-morse-veil hidden aria-hidden="true"></div>

<script>
  import { morseTimeline, morseDurationMs, isMorseMarkActive } from '../data/resistanceMorse.ts';
  import { loadCorruptionLoop } from '../data/corruptionAudio.ts';
  import {
    resistanceLockdown, createLockdownCookie, readLockdownExpiry
  } from '../data/resistanceLockdown.ts';

  const veil = document.querySelector<HTMLElement>('[data-morse-veil]');
  const preview = import.meta.env.DEV &&
    new URLSearchParams(location.search).get('previewMorse') === '1';

  if (veil) {
    const marks = morseTimeline();

    const totalMs = morseDurationMs(marks);
    // Välj textstycken i innehåll, navigering och sidfot på alla WeAB-sidor,
    // även 404, inte bara klasser från den gamla 404-komponenten.
    const paragraphs = [...document.querySelectorAll<HTMLElement>(
      'main h1, main h2, main h3, main h4, main p, main li,' +
      ' main blockquote, main a, main button, main td, main th,' +
      ' header a, header span, footer p, footer a, footer span,' +
      ' footer small, footer h3, footer h4'
    )].filter(element => element.textContent?.trim());
    let corrupted = 0;

    function corrupt(element: HTMLElement, index: number): void {
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
      let next: Node | null;
      while ((next = walker.nextNode())) {
        const node = next as Text;
        if (!node.data.trim() || node.parentElement?.closest('.sr-only,[aria-hidden="true"]')) continue;
        node.data = [...node.data].map((c, i) => {
          if (/\s/u.test(c)) return c;
          const glyphs = ['█', '▒', '/', '0', '1', '░'];
          return glyphs[(i + index * 3) % glyphs.length];
        }).join('');
      }
      element.classList.add('resistance-morse-corrupted');
    }

    function progress(elapsed: number): void {
      if (!veil) return;
      const portion = Math.min(1, elapsed / totalMs);
      const expected = Math.min(paragraphs.length, Math.floor(portion * (paragraphs.length + 1)));
      while (corrupted < expected) corrupt(paragraphs[corrupted], corrupted++);
      veil.hidden = false;
      veil.style.opacity = String(Math.min(.9, Math.pow(portion, 1.6) * .95));
      document.body.classList.add('resistance-morse-active');
      // Varje inverterad puls är exakt samma morsestreck/prick som radiosignalen.
      // Inga separata slumpblixtar: paus i Morse = normala färger.
      document.body.classList.toggle('resistance-morse-inverted', isMorseMarkActive(marks, elapsed));
      if (portion > .22) document.title = 'S I G N A L   F Ö R L O R A D';
      if (portion > .65) document.title = '████████████';
    }

    function ensureQuarantineCookie(): void {
      const now = Date.now();
      // Den ordinarie kontrollern startar femminutersklockan VID Morse-start.
      // Bevara den sluttiden. För direkt förhandsvisning och ovanligt långa
      // bakgrundspauser skapas den endast om en giltig spärr saknas.
      if (readLockdownExpiry(document.cookie, now) !== null) return;
      document.cookie = createLockdownCookie(now, location.protocol === 'https:');
      try {
        localStorage.setItem(resistanceLockdown.noticeKey,
          String(now + resistanceLockdown.durationMs));
      } catch { /* Lokal lagring är valfri. */ }
    }

    function finishSignal(): void {
      // Samma flik går DIREKT till WeAB:s brottningsmatch mot själen.
      // Ingen flikstängning, omväg via blank sida eller svart tomt dokument.
      ensureQuarantineCookie();
      location.replace('/');
    }

    function animateByAudioClock(context: AudioContext, begins: number): void {
      function frame(): void {
        const elapsed = (context.currentTime - begins) * 1000;
        // Första inverterade pulsen ska börja med ljudet, inte under ljudets
        // inledande 80 ms schemaläggningsmarginal.
        if (elapsed >= 0) progress(elapsed);
        if (elapsed < totalMs + 260) {
          window.requestAnimationFrame(frame);
          return;
        }
        void context.close().catch(() => {});
        finishSignal();
      }
      window.requestAnimationFrame(frame);
    }

    function playCorruptedMorse(context: AudioContext): void {
      const begins = context.currentTime + .08;
      const ends = begins + totalMs / 1000;
      const master = context.createGain();
      master.gain.value = .13;
      master.connect(context.destination);

      const filter = context.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.value = 710;
      filter.Q.value = .62;
      filter.connect(master);

      // Hård överstyrning: distinkt gammal radiosignal, inte ren pipton.
      const distortion = context.createWaveShaper();
      const curve = new Float32Array(512);
      for (let i = 0; i < curve.length; i++) {
        const x = 2 * i / (curve.length - 1) - 1;
        curve[i] = Math.tanh(x * 6.5);
      }
      distortion.curve = curve;
      distortion.connect(filter);

      marks.forEach((mark, i) => {
        const at = begins + mark.atMs / 1000;
        const length = mark.durationMs / 1000;
        const oscillator = context.createOscillator();
        oscillator.type = i % 6 === 0 ? 'square' : 'sawtooth';
        const frequency = 530 + Math.sin(i * 13.7) * 42;
        oscillator.frequency.setValueAtTime(frequency, at);
        oscillator.frequency.linearRampToValueAtTime(frequency - 26, at + length);
        const volume = context.createGain();
        volume.gain.setValueAtTime(0.001, at);
        volume.gain.linearRampToValueAtTime(.60, at + Math.min(.008, length * .15));
        volume.gain.setValueAtTime(.60, at + Math.max(.01, length - .012));
        volume.gain.linearRampToValueAtTime(.001, at + length);
        oscillator.connect(volume);
        volume.connect(distortion);
        oscillator.start(at);
        oscillator.stop(at + length + .002);
        oscillator.onended = () => { oscillator.disconnect(); volume.disconnect(); };
      });

      // Låg, filtrerad radiostatik under meddelandet ger trasig inspelningskänsla.
      const sampleCount = context.sampleRate * 2;
      const noiseBuffer = context.createBuffer(1, sampleCount, context.sampleRate);
      const samples = noiseBuffer.getChannelData(0);
      for (let i = 0; i < samples.length; i++) {
        const raw = Math.random() * 2 - 1;
        samples[i] = raw * (i % 191 < 8 ? .95 : .22);
      }
      const noise = context.createBufferSource();
      noise.buffer = noiseBuffer;
      noise.loop = true;
      const noiseFilter = context.createBiquadFilter();
      noiseFilter.type = 'highpass';
      noiseFilter.frequency.value = 500;
      const noiseGain = context.createGain();
      noiseGain.gain.value = .028;
      noise.connect(noiseFilter);
      noiseFilter.connect(noiseGain);
      noiseGain.connect(master);
      noise.start(begins);
      noise.stop(ends + .08);
      noise.onended = () => { noise.disconnect(); noiseFilter.disconnect(); noiseGain.disconnect(); };

      // Samma förinspelade, korrumperade kortvågsbrus som vid ögon,
      // sidintrång och karantän. Den avkodningsbara oscillatorn och alla
      // prick-/streck-/pausgränser ovan förblir exakt oförändrade.
      void loadCorruptionLoop(context).then(buffer => {
        if (!buffer || context.state !== 'running' || context.currentTime >= ends) return;
        const texture = context.createBufferSource();
        texture.buffer = buffer;
        texture.loop = true;
        const bed = context.createGain();
        bed.gain.value = .65;
        marks.forEach(mark => {
          const at = begins + mark.atMs / 1000;
          const off = at + mark.durationMs / 1000;
          bed.gain.setValueAtTime(.65, at);
          bed.gain.linearRampToValueAtTime(1.15, at + Math.min(.012, (off - at) / 4));
          bed.gain.setValueAtTime(1.15, Math.max(at + .012, off - .014));
          bed.gain.linearRampToValueAtTime(.65, off);
        });
        texture.connect(bed);
        bed.connect(master);
        const offset = Math.max(0, context.currentTime - begins);
        texture.start(Math.max(context.currentTime, begins), offset % buffer.duration);
        texture.stop(ends + .08);
        texture.onended = () => { texture.disconnect(); bed.disconnect(); };
      }).catch(() => { /* Befintlig Morse fortsätter utan ljudfilen. */ });

      animateByAudioClock(context, begins);
    }

    function fallbackVisualOnly(): void {
      // Samma Morse-timing även när webbläsaren förbjuder ljud utan klick.
      // Inga knappar eller texter som förklarar att signalen inte kunde starta.
      const started = performance.now();
      function frame(now: number): void {
        progress(now - started);
        if (now - started < totalMs + 260) window.requestAnimationFrame(frame);
        else finishSignal();
      }
      window.requestAnimationFrame(frame);
    }

    let started = false;
    function startSignal(): void {
      if (started) return;
      started = true;
      ensureQuarantineCookie();
      // När den fångade rösten börjar sända syns även webbplattformens
      // simulerade diagnostikflöde, som redan har läckt till F12 tidigare.
      window.dispatchEvent(new CustomEvent('weab:builder-diagnostics-start', {
        detail: { durationMs: totalMs }
      }));
      prepareSignal();
    }
    // Morse är ett möjligt FÖRSTA steg. Efter signalens sista markering
    // går samma flik automatiskt till WeAB:s karantänvy.
    window.addEventListener('weab:resistance-morse-start', startSignal, { once: true });
    if (preview) window.setTimeout(startSignal, 1_000);

    function prepareSignal(): void {
      if (typeof AudioContext === 'undefined') {
        fallbackVisualOnly();
        return;
      }

      let context: AudioContext;
      try {
        context = new AudioContext();
      } catch {
        fallbackVisualOnly();
        return;
      }
      if (context.state === 'running') {
        playCorruptedMorse(context);
        return;
      }

      // Autoplay kan blockeras trots tidigare sidvisning. Ge Web Audio ett
      // kort försök utan användarkontroll, fortsätt annars visuellt i takt.
      let settled = false;
      function useVisualFallback(): void {
        if (settled) return;
        settled = true;
        void context.close().catch(() => {});
        fallbackVisualOnly();
      }
      const timeout = window.setTimeout(useVisualFallback, 350);
      void context.resume().then(() => {
        if (settled) return;
        settled = true;
        window.clearTimeout(timeout);
        if (context.state === 'running') {
          playCorruptedMorse(context);
        } else {
          void context.close().catch(() => {});
          fallbackVisualOnly();
        }
      }).catch(() => {
        window.clearTimeout(timeout);
        useVisualFallback();
      });
    }
  }
</script>

<style>
  .resistance-morse-veil {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    background: repeating-linear-gradient(0deg,
      transparent 0 3px, rgb(132 32 56 / .055) 4px 5px,
      rgb(41 145 158 / .045) 6px 7px, transparent 8px 13px),
      repeating-linear-gradient(
      176deg,
      transparent 0,
      rgb(0 0 0 / .55) 16px,
      rgb(0 0 0 / .94) 20px,
      transparent 27px
    ), #020304;
    opacity: 0;
    transition: none;
  }
  /* Inverterade Morse-pulser utan bländande helskärmsvita blixtar.
     Mörkhetsbegränsningen behåller färgväxlingen men minskar ljusstyrkan. */
  /* Påverka sidans innehåll, inte diagnostikpanelen ovanpå signalen.
     Därmed förblir de växande felmeddelandena läsbara även under Morse. */
  :global(body.resistance-morse-inverted > header),
  :global(body.resistance-morse-inverted > main),
  :global(body.resistance-morse-inverted > footer) {
    filter: invert(1) brightness(.23) contrast(.78);
  }
  :global(.resistance-morse-corrupted) {
    color: #d0b7b7 !important;
    text-shadow: -2px 0 #4e141d, 2px 0 #154d58;
    filter: contrast(160%);
    transform: translateX(2px) skew(-.8deg);
  }
  /* Korrumperingen får aldrig låsa sidans scroll, vare sig med mus,
     pekskärm, tangentbord eller medan Morse-pulserna visas. */
  :global(body.resistance-morse-active) {
    overflow-y: auto !important;
  }
  :global(body.resistance-morse-active .not-found-image) {
    filter: saturate(0) contrast(200%) brightness(.35);
  }
</style>
