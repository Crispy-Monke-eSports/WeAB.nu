---
interface Props {
  label?: string;
  variant?: 'text' | 'button';
}
const { label = 'Öppna BlueMap', variant = 'text' } = Astro.props;
---
<a class:list={['map-link', variant === 'button' ? 'btn btn-outline' : 'link-arrow']}
   href="https://karta.weab.nu/" target="_blank" rel="noopener noreferrer"
   aria-label={`${label} (öppnas i ny flik)`}>
  {label} <span aria-hidden="true">↗</span>
</a>
