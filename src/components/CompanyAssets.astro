---
import type { Project } from '../data/projects';
import { Image } from 'astro:assets';
import { imageAsset, responsiveWidths } from '../data/imageAssets';
import type { companyEditorial } from '../data/companyEditorial';

type Editorial = typeof companyEditorial[string];
interface Props {
  editorial: Editorial;
  projects: Project[];
  slug: string;
}
const { editorial, projects, slug } = Astro.props;
const projectById = new Map(projects.map(project => [project.id, project]));
---
<section id="anlaggningar" class:list={['section', 'company-projects', `company-projects--${slug}`]}>
  <div class="shell">
    <div class="company-projects__intro">
      <h2>{editorial.heading}</h2>
      <p class="lead">{editorial.introduction}</p>
    </div>
    {editorial.connections && <div class="company-connections">
      <div class="company-connections__intro"><h3>{editorial.connections.heading}</h3></div>
      <ol>{editorial.connections.steps.map(step => <li>
        <a href={step.href}><strong>{step.name} <span aria-hidden="true">↗</span></strong></a>
      </li>)}</ol>
    </div>}
    <div class="company-groups">
      {editorial.groups.map((group, groupIndex) => <div class="company-group">
        <div class="company-group__heading"><h3>{group.title}</h3></div>
        <div class="company-project-grid">
          {group.ids.map((id, projectIndex) => {
            const project = projectById.get(id);
            if (!project) return null;
            return <article class:list={['company-asset', { 'company-asset--featured': projects.length === 1 || (groupIndex === 0 && projectIndex === 0 && projects.length > 2) }]} id={`anlaggning-${project.id}`}>
              <figure class="company-asset__media">
                <Image class="company-asset__image" src={imageAsset(project.image)} alt={project.alt} layout="constrained" widths={responsiveWidths} sizes="(max-width: 760px) 100vw, 60vw" loading="lazy" />
                {project.gallery && <div class="company-asset__gallery" role="group" aria-label={`Fler bilder från ${project.name}`}>
                  {project.gallery.map(photo => <Image src={imageAsset(photo.image)} alt={photo.alt} layout="constrained" widths={responsiveWidths} sizes="(max-width: 760px) 50vw, 30vw" loading="lazy" />)}
                </div>}
              </figure>
              <div class="company-asset__copy">
                <h4>{project.name}</h4>
                <span class="company-asset__category">{project.category}{project.stage && ` · ${project.stage}`}</span>
                <p>{project.description}</p>
              </div>
            </article>;
          })}
        </div>
      </div>)}
    </div>
  </div>
</section>
<style>
  .company-projects { background: #111e27; border-block: 1px solid #263944; scroll-margin-top: 90px; }
  .company-projects__intro { max-width: 780px; margin-bottom: clamp(3rem,6vw,5rem); }
  .company-projects__intro h2 { margin-bottom: 1.1rem; }
  .company-projects__intro p { margin: 0; }
  .company-groups { display: grid; gap: clamp(3.5rem,6vw,6rem); }
  .company-group { min-width: 0; }
  .company-group__heading { border-top: 1px solid color-mix(in srgb,var(--company-accent) 60%,#52636b); padding-top: 1.3rem; margin-bottom: 1.5rem; }
  .company-group__heading h3 { font-size: clamp(1.4rem,2.6vw,2.2rem); margin: 0; }
  .company-project-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.25rem; }
  .company-asset { min-width: 0; background: #152530; border-bottom: 1px solid #324750; scroll-margin-top: 100px; }
  .company-asset--featured { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0,1.25fr) minmax(0,.75fr); }
  .company-asset__media { min-width: 0; overflow: hidden; margin: 0; }
  .company-asset__image { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .company-asset--featured .company-asset__image { height: 100%; max-height: 510px; min-height: 300px; }
  .company-asset__gallery { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1px; background: #354651; }
  .company-asset__gallery:has(img:only-child) { grid-template-columns: 1fr; }
  .company-asset__gallery img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .company-asset--featured .company-asset__gallery img { max-height: 160px; }
  .company-asset__copy { padding: clamp(1.5rem,3vw,2.5rem); align-self: end; }
  .company-asset__category { display: block; margin-bottom: .65rem; color: #a6d7df; font-size: .69rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .company-asset h4 { margin: 0 0 .8rem; font-size: clamp(1.45rem,2.4vw,2.2rem); letter-spacing: -.035em; line-height: 1.1; }
  .company-asset p { margin: 0; max-width: 60ch; font-size: .9rem; }
  .company-connections { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 2rem; padding: 2rem; margin-bottom: 4rem; background: color-mix(in srgb,var(--company-accent) 11%,#162630); }
  .company-connections__intro h3 { font-size: clamp(1.5rem,2.6vw,2.2rem); }
  .company-connections ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .company-connections li { border-top: 2px solid var(--company-accent); }
  .company-connections a { display: flex; flex-direction: column; gap: .7rem; padding-top: 1rem; text-decoration: none; font-size: .85rem; color: #c9d8de; }
  .company-connections a strong { color: #fff; font-size: 1.1rem; }
  .company-connections a:hover strong { text-decoration: underline; text-underline-offset: .2em; }
  .company-connections a strong span { color: var(--company-accent); }
  @media(max-width: 800px) { .company-connections { grid-template-columns: 1fr; } }
  @media(max-width: 700px) {
    .company-project-grid { grid-template-columns: 1fr; }
    .company-asset--featured { grid-column: auto; display: block; }
    .company-asset--featured .company-asset__image { height: auto; min-height: 0; }
    .company-connections { padding: 1.5rem; }
    .company-connections ol { grid-template-columns: 1fr; }
  }
</style>
