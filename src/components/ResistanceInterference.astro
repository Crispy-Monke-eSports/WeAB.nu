---
/**
 * Ett oförklarat ARG-intrång som spelarna kan missta för ett motståndsangrepp.
 * Samma fångade röst försöker nå fram på flera sätt, inklusive Morse.
 * Slumpordningen fortsätter på koordinat-404, men Morse kan starta på alla sidor.
 */
---
<div
  class="resistance-interference"
  data-resistance-interference
  role="dialog"
  aria-modal="true"
  aria-label="Ett främmande meddelande."
  tabindex="-1"
  hidden
>
  <p class="resistance-interference__message" data-resistance-message aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import {
    resistanceSignal,
    createSignalSchedule,
    advanceSignalSchedule,
    isSignalSchedule,
    type SignalSchedule,
    type SignalPhase
  } from '../data/resistanceSignal.ts';
  import { resistanceLockdown, createLockdownCookie } from '../data/resistanceLockdown.ts';

  const overlay = document.querySelector<HTMLElement>('[data-resistance-interference]');
  const messageElement = overlay?.querySelector<HTMLElement>('[data-resistance-message]');
  if (overlay && messageElement && !document.documentElement.classList.contains('weab-quarantined')) {
    const lockable = [...document.querySelectorAll<HTMLElement>('body > header, body > main, body > footer')];
    const initialInert = lockable.map(element => element.inert);

    function storageRead(storage: Storage, key: string): string | null {
      try { return storage.getItem(key); } catch { return null; }
    }
    function storageWrite(storage: Storage, key: string, value: string): void {
      try { storage.setItem(key, value); } catch { /* Lagring är valfri. */ }
    }

    const params = new URLSearchParams(location.search);
    const preview = import.meta.env.DEV && params.get('previewResistance') === '1';
    const morsePreview = import.meta.env.DEV && params.get('previewMorse') === '1';
    const previousRaw = storageRead(sessionStorage, resistanceSignal.sessionKey);
    let previous: unknown = null;
    try { previous = previousRaw ? JSON.parse(previousRaw) : null; } catch { /* Nollställ korrupt sessionsdata. */ }
    // Fristående 404-besök startar inte ett nytt intrång. På koordinat-404
    // fortsätter däremot schemat efter en tidigare omdirigering.
    const is404 = document.querySelector('.not-found') !== null;
    if ((!is404 || isSignalSchedule(previous) || preview) && !morsePreview) {
      let schedule: SignalSchedule = isSignalSchedule(previous) ? previous : createSignalSchedule();
      if (preview) schedule = { activeMs: 0, queue: createSignalSchedule().queue, nextAtMs: 1_000 };

      let running = false;
      let originalTexts: Array<{ node: Text; value: string }> = [];

      function saveSchedule(): void {
        storageWrite(sessionStorage, resistanceSignal.sessionKey, JSON.stringify(schedule));
      }

      function restoreText(): void {
        for (const { node, value } of originalTexts) node.data = value;
        originalTexts = [];
        document.body.classList.remove('resistance-corrupted');
      }

      function runTitleChange(): void {
        running = true;
        const heading = document.querySelector<HTMLElement>('main h1, main h2');
        // Ersätt HELA rubrikens läsbara text även om den innehåller flera
        // textnoder och <em>/<span>. Behåll övrig struktur och sidans länkar.
        if (heading) {
          const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
          let current: Node | null;
          let replaced = false;
          while ((current = walker.nextNode())) {
            const node = current as Text;
            if (!node.data.trim()) continue;
            if (!replaced) {
              node.data = 'DU SER DET OCKSÅ.';
              replaced = true;
            } else {
              node.data = '';
            }
          }
        }
        // Rubrik och fliktitel återställs först när nästa sida laddas.
        document.title = 'HÖR DU OSS?';
        window.setTimeout(() => { running = false; }, resistanceSignal.titleDurationMs);
      }

      function corruptPage(): void {
        const skip = 'script,style,noscript,svg,textarea,select,option,[aria-hidden="true"],.sr-only,.skip-link';
        for (const root of lockable) {
          const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
          let current: Node | null;
          while ((current = walker.nextNode())) {
            const node = current as Text;
            const value = node.data;
            if (!value.trim() || node.parentElement?.closest(skip)) continue;
            originalTexts.push({ node, value });
            node.data = value.replace(/\S[\s\S]*\S|\S/u, 'DISOBEY');
          }
        }
        document.body.classList.add('resistance-corrupted');
      }

      function runDisobey(): void {
        running = true;
        document.title = 'DISOBEY';
        corruptPage();
        window.setTimeout(() => {
          restoreText();
          // Titeländringen består på den här sidan fram till nästa navigation.
          running = false;
        }, resistanceSignal.corruptionMs);
      }

      function runFullscreen(): void {
        if (!overlay || !messageElement) return;
        running = true;
        const previousFocus = document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;

        overlay.hidden = false;
        document.body.classList.add('resistance-interfering');
        for (const root of lockable) root.inert = true;
        overlay.focus({ preventScroll: true });

        let index = 0;
        function nextMessage(): void {
          if (!messageElement || !overlay) return;
          if (index >= resistanceSignal.messages.length) {
            overlay.hidden = true;
            document.body.classList.remove('resistance-interfering');
            for (let i = 0; i < lockable.length; i++) lockable[i].inert = initialInert[i];
            // Låt det sista fragmentet leva kvar som fliktitel tills sidbyte.
            if (previousFocus?.isConnected) previousFocus.focus({ preventScroll: true });
            running = false;
            return;
          }
          const item = resistanceSignal.messages[index++];
          messageElement.textContent = item.text;
          document.title = item.text;
          window.setTimeout(nextMessage, item.durationMs);
        }
        nextMessage();
      }

      function runEyes(): void {
        running = true;
        window.dispatchEvent(new Event('weab:resistance-eyes-start'));
        // Inlineögonen, bildstörningarna och eventuellt tillåtet ljud
        // försvinner efter samma varaktighet utan att blockera scrolling.
        window.setTimeout(() => { running = false; }, resistanceSignal.eyesDurationMs);
      }

      function runPhase(phase: SignalPhase): void {
        if (phase === 'morse') {
          // Terminal händelse: avsluta schemat INNAN sidans Morse-komponent
          // startas. Ingen annan störning eller redirect får ske därefter.
          running = true;
          window.clearInterval(intervalId);
          document.documentElement.dataset.weabMorseRunning = '1';
          const now = Date.now();
          // Fem minuters KARANTÄN börjar när Morse startar – nästa sidbyte
          // under signalen eller ett nytt fönster får bara visa WeAB:s spärr.
          document.cookie = createLockdownCookie(now, location.protocol === 'https:');
          // Storage-event meddelar redan öppna flikar på samma domän.
          storageWrite(localStorage, resistanceLockdown.noticeKey,
            String(now + resistanceLockdown.durationMs));
          // När karantänen förfaller väljs en HELT NY händelseordning.
          try { sessionStorage.removeItem(resistanceSignal.sessionKey); } catch { /* Valfritt. */ }
          window.dispatchEvent(new Event('weab:resistance-morse-start'));
          return;
        }
        // Varje effekt har minst 22 s aktiv läsning efter FÖREGÅENDE effekts slut.
        schedule = advanceSignalSchedule(schedule);
        saveSchedule();
        if (phase === 'title') runTitleChange();
        else if (phase === 'disobey') runDisobey();
        else if (phase === 'fullscreen') runFullscreen();
        else if (phase === 'eyes') runEyes();
        else if (phase === 'redirect') {
          // Denna händelse finns endast en gång i slumpkön. Den sparade kön
          // återupptas på 404-sidan, där Morse också kan inträffa.
          window.location.assign(resistanceSignal.targetPath);
        }
      }

      saveSchedule();
      let previousTick = performance.now();
      const intervalId = window.setInterval(() => {
        const now = performance.now();
        const elapsed = Math.max(0, Math.min(now - previousTick, 1_200));
        previousTick = now;
        // Redan öppna flikar får inte fortsätta en egen ARG-sekvens
        // medan en annan flik är satt i karantän.
        if (document.documentElement.classList.contains('weab-quarantined')) {
          window.clearInterval(intervalId);
          return;
        }
        if (document.visibilityState !== 'visible') return;

        schedule.activeMs += elapsed;
        if (!running && schedule.activeMs >= schedule.nextAtMs) {
          runPhase(schedule.queue[0]);
        } else {
          saveSchedule();
        }
      }, 500);
    }
  }
</script>

<style>
  .resistance-interference[hidden] { display: none; }
  .resistance-interference {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    background: #020304;
    color: #e7e9e9;
    padding: clamp(1.3rem, 5vw, 4rem);
    text-align: center;
    cursor: default;
    isolation: isolate;
  }
  .resistance-interference::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgb(255 255 255 / .025) 4px,
      transparent 5px
    );
    pointer-events: none;
    z-index: -1;
  }
  .resistance-interference__message {
    margin: 0;
    max-width: 25ch;
    color: #e7e9e9;
    font-family: 'Press Start 2P', ui-monospace, monospace;
    font-size: clamp(1.15rem, 4.4vw, 3rem);
    font-weight: 400;
    letter-spacing: .035em;
    line-height: 1.65;
    overflow-wrap: anywhere;
    text-shadow: 2px 0 #633b45, -2px 0 #35545e;
    animation: resistance-distortion 1.15s steps(2, end) both;
  }
  :global(body.resistance-corrupted > header),
  :global(body.resistance-corrupted > main),
  :global(body.resistance-corrupted > footer) {
    pointer-events: none;
    animation: resistance-shudder .23s steps(2, end) 2;
  }
  @keyframes resistance-shudder {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(2px); }
  }
  @keyframes resistance-distortion {
    0%, 100% { transform: translateX(0); }
    45% { transform: translateX(-2px); }
    55% { transform: translateX(1px); }
  }
</style>
