---
/**
 * Ett ARG-intrång från motståndsrörelsen, inte ett officiellt WeAB-meddelande.
 * 404-sidan använder BaseLayout med enableInterference={false}.
 */
---
<div
  class="resistance-interference"
  data-resistance-interference
  role="dialog"
  aria-modal="true"
  aria-label="Ett främmande meddelande."
  tabindex="-1"
  hidden
>
  <p class="resistance-interference__message" data-resistance-message aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import {
    resistanceSignal,
    createSignalSchedule,
    advanceSignalSchedule,
    isSignalSchedule,
    isSignalOnCooldown,
    type SignalSchedule,
    type SignalPhase
  } from '../data/resistanceSignal.ts';
  import { resistanceMorse } from '../data/resistanceMorse.ts';

  const overlay = document.querySelector<HTMLElement>('[data-resistance-interference]');
  const messageElement = overlay?.querySelector<HTMLElement>('[data-resistance-message]');
  if (overlay && messageElement) {
    const originalTitle = document.title;
    const lockable = [...document.querySelectorAll<HTMLElement>('body > header, body > main, body > footer')];
    const initialInert = lockable.map(element => element.inert);

    function storageRead(storage: Storage, key: string): string | null {
      try { return storage.getItem(key); } catch { return null; }
    }
    function storageWrite(storage: Storage, key: string, value: string): void {
      try { storage.setItem(key, value); } catch { /* Lagring är valfri. */ }
    }

    const rawLastShown = storageRead(localStorage, resistanceSignal.lastShownKey);
    const lastShown = rawLastShown === null ? null : Number(rawLastShown);
    // Förhandsgranskning startar första steget tidigt men behåller ALLA pauser.
    const preview = import.meta.env.DEV &&
      new URLSearchParams(location.search).get('previewResistance') === '1';

    if (!isSignalOnCooldown(Date.now(), lastShown) || preview) {
      let schedule: SignalSchedule;
      try {
        const old = storageRead(sessionStorage, resistanceSignal.sessionKey);
        const parsed: unknown = old ? JSON.parse(old) : null;
        schedule = isSignalSchedule(parsed) ? parsed : createSignalSchedule();
      } catch {
        schedule = createSignalSchedule();
      }
      if (preview) {
        schedule = { activeMs: 0, nextPhase: 'title', nextAtMs: 1_000 };
      }

      let running = false;
      let originalTexts: Array<{ node: Text; value: string }> = [];

      function saveSchedule(): void {
        storageWrite(sessionStorage, resistanceSignal.sessionKey, JSON.stringify(schedule));
      }

      function restoreText(): void {
        for (const { node, value } of originalTexts) node.data = value;
        originalTexts = [];
        document.body.classList.remove('resistance-corrupted');
      }

      function runTitleChange(): void {
        running = true;
        const heading = document.querySelector<HTMLElement>('main h1, main h2');
        const node = heading
          ? (document.createTreeWalker(heading, NodeFilter.SHOW_TEXT).nextNode() as Text | null)
          : null;
        const oldText = node?.data;
        if (node && oldText?.trim()) node.data = 'DU SER DET OCKSÅ.';
        document.title = 'HÖR DU OSS?';
        window.setTimeout(() => {
          if (node && oldText !== undefined) node.data = oldText;
          document.title = originalTitle;
          running = false;
        }, resistanceSignal.titleDurationMs);
      }

      function corruptPage(): void {
        const skip = 'script,style,noscript,svg,textarea,select,option,[aria-hidden="true"],.sr-only,.skip-link';
        for (const root of lockable) {
          const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
          let current: Node | null;
          while ((current = walker.nextNode())) {
            const node = current as Text;
            const value = node.data;
            if (!value.trim() || node.parentElement?.closest(skip)) continue;
            originalTexts.push({ node, value });
            node.data = value.replace(/\S[\s\S]*\S|\S/u, 'DISOBEY');
          }
        }
        document.body.classList.add('resistance-corrupted');
      }

      function runDisobey(): void {
        running = true;
        document.title = 'DISOBEY';
        corruptPage();
        window.setTimeout(() => {
          restoreText();
          document.title = originalTitle;
          running = false;
        }, resistanceSignal.corruptionMs);
      }

      function runFullscreen(): void {
        if (!overlay || !messageElement) return;
        running = true;
        const previousFocus = document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;

        overlay.hidden = false;
        document.body.classList.add('resistance-interfering');
        for (const root of lockable) root.inert = true;
        overlay.focus({ preventScroll: true });

        let index = 0;
        function nextMessage(): void {
          if (!messageElement || !overlay) return;
          if (index >= resistanceSignal.messages.length) {
            overlay.hidden = true;
            document.body.classList.remove('resistance-interfering');
            for (let i = 0; i < lockable.length; i++) lockable[i].inert = initialInert[i];
            document.title = originalTitle;
            if (previousFocus?.isConnected) previousFocus.focus({ preventScroll: true });
            running = false;
            return;
          }
          const item = resistanceSignal.messages[index++];
          messageElement.textContent = item.text;
          document.title = item.text;
          window.setTimeout(nextMessage, item.durationMs);
        }
        nextMessage();
      }

      function redirectTo404(): void {
        // Adressen är avsiktligt obefintlig. GitHub Pages visar befintlig 404.
        // Armera en enda Morse-final på koordinatadressen, inte vanliga 404-besök.
        storageWrite(sessionStorage, resistanceMorse.triggerKey, String(Date.now()));
        storageWrite(localStorage, resistanceSignal.lastShownKey, String(Date.now()));
        schedule = createSignalSchedule();
        saveSchedule();
        window.location.assign(resistanceSignal.targetPath);
      }

      function runPhase(phase: SignalPhase): void {
        if (phase === 'redirect') {
          redirectTo404();
          return;
        }
        // Nästa tidpunkt ligger minst 22 sekunder EFTER denna effekts slut.
        schedule = advanceSignalSchedule(schedule);
        saveSchedule();
        if (phase === 'title') runTitleChange();
        else if (phase === 'disobey') runDisobey();
        else if (phase === 'fullscreen') runFullscreen();
      }

      saveSchedule();
      let previousTick = performance.now();
      window.setInterval(() => {
        const now = performance.now();
        const elapsed = Math.max(0, Math.min(now - previousTick, 1_200));
        previousTick = now;
        if (document.visibilityState !== 'visible') return;

        schedule.activeMs += elapsed;
        if (!running && schedule.activeMs >= schedule.nextAtMs) {
          runPhase(schedule.nextPhase);
        } else {
          saveSchedule();
        }
      }, 500);
    }
  }
</script>

<style>
  .resistance-interference {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    background: #020304;
    color: #e7e9e9;
    padding: clamp(1.3rem, 5vw, 4rem);
    text-align: center;
    cursor: default;
    isolation: isolate;
  }
  .resistance-interference::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgb(255 255 255 / .025) 4px,
      transparent 5px
    );
    pointer-events: none;
    z-index: -1;
  }
  .resistance-interference__message {
    margin: 0;
    max-width: 25ch;
    color: #e7e9e9;
    font-family: 'Press Start 2P', ui-monospace, monospace;
    font-size: clamp(1.15rem, 4.4vw, 3rem);
    font-weight: 400;
    letter-spacing: .035em;
    line-height: 1.65;
    overflow-wrap: anywhere;
    text-shadow: 2px 0 #633b45, -2px 0 #35545e;
    animation: resistance-distortion 1.15s steps(2, end) both;
  }
  :global(body.resistance-corrupted > header),
  :global(body.resistance-corrupted > main),
  :global(body.resistance-corrupted > footer) {
    pointer-events: none;
    animation: resistance-shudder .23s steps(2, end) 2;
  }
  @keyframes resistance-shudder {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(2px); }
  }
  @keyframes resistance-distortion {
    0%, 100% { transform: translateX(0); }
    45% { transform: translateX(-2px); }
    55% { transform: translateX(1px); }
  }
</style>
