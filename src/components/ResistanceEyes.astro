---
/** Ett ensamt öga öppnas mitt i den befintliga, avgränsade ARG-störningen. */
---
<div class="resistance-eye-noise" data-resistance-eye-noise hidden aria-hidden="true">
  <span class="resistance-eye__void"></span>
  <span class="resistance-eye" data-resistance-eye>
    <span class="resistance-eye__iris"></span>
  </span>
</div>

<script>
  import { resistanceSignal } from '../data/resistanceSignal.ts';
  import { cameraEncounter } from '../data/cameraEncounter.ts';

  const veil = document.querySelector<HTMLElement>('[data-resistance-eye-noise]');
  const eye = veil?.querySelector<HTMLElement>('[data-resistance-eye]');
  const preview = import.meta.env.DEV &&
    new URLSearchParams(location.search).get('previewEyes') === '1';

  if (veil && eye) {
    let active = false;
    let finishTimer = 0;
    let disruptionTimer = 0;
    let voidTimer = 0;
    const displaced: HTMLElement[] = [];
    const eyeBurstTimers: number[] = [];

    // Varje intrång får olika antal ojämna steg, form och förskjutningar.
    // Ögat framträder först när hålet nått full storlek.
    function growVoid(): void {
      if (!veil || !active) return;
      const steps = 4 + Math.floor(Math.random() * 4);
      let stage = 0;
      function advance(): void {
        if (!active) return;
        stage++;
        const progress = stage / steps;
        const scale = stage === steps ? 1 : Math.min(.94,
          progress * progress * (.85 + Math.random() * .5));
        veil?.style.setProperty('--void-scale-x', String(scale * (stage === steps ? 1 : .8 + Math.random() * .4)));
        veil?.style.setProperty('--void-scale-y', String(scale * (stage === steps ? 1 : .75 + Math.random() * .5)));
        veil?.style.setProperty('--void-offset-x', `${stage === steps ? 0 : Math.round(Math.random() * 28 - 14)}px`);
        veil?.style.setProperty('--void-offset-y', `${stage === steps ? 0 : Math.round(Math.random() * 20 - 10)}px`);
        veil?.style.setProperty('--void-opacity', '1');
        if (stage === steps) {
          voidTimer = window.setTimeout(() => {
            if (active) veil?.classList.add('resistance-eye-noise--eye-visible');
          }, 60 + Math.random() * 150);
        } else voidTimer = window.setTimeout(advance, 40 + Math.random() * 125);
      }
      advance();
    }

    function clearDisplaced(): void {
      for (const element of displaced) {
        element.classList.remove('resistance-displaced');
        element.style.removeProperty('--eye-jolt-x');
        element.style.removeProperty('--eye-jolt-y');
        element.style.removeProperty('--eye-tilt');
      }
      displaced.length = 0;
    }

    // Få, synliga objekt per ojämnt tidssteg. Ingen permanent layoutändring
    // och ingen helsidig per-frame-filterrendering på iOS eller Android.
    function disrupt(candidates: HTMLElement[], compact: boolean): void {
      if (!active || document.hidden) return;
      clearDisplaced();
      const count = Math.min(candidates.length, compact ? 2 : 4);
      const chosen = new Set<number>();
      while (chosen.size < count) chosen.add(Math.floor(Math.random() * candidates.length));
      for (const index of chosen) {
        const element = candidates[index];
        const spread = compact ? 22 : 64;
        element.style.setProperty('--eye-jolt-x', `${Math.round((Math.random() * 2 - 1) * spread)}px`);
        element.style.setProperty('--eye-jolt-y', `${Math.round((Math.random() * 2 - 1) * spread * .48)}px`);
        element.style.setProperty('--eye-tilt', `${((Math.random() * 2 - 1) * 1.2).toFixed(2)}deg`);
        element.classList.add('resistance-displaced');
        displaced.push(element);
      }
      veil?.style.setProperty('--tear-one-y', `${Math.round(8 + Math.random() * 72)}%`);
      veil?.style.setProperty('--tear-two-y', `${Math.round(12 + Math.random() * 74)}%`);
      veil?.style.setProperty('--tear-one-x', `${Math.round(Math.random() * 42 - 21)}px`);
      veil?.style.setProperty('--tear-two-x', `${Math.round(Math.random() * 46 - 23)}px`);
      disruptionTimer = window.setTimeout(() => disrupt(candidates, compact),
        (compact ? 140 : 85) + Math.random() * (compact ? 160 : 155));
    }

    function eyeTransmission(): void {
      window.dispatchEvent(new CustomEvent('weab:spirit-burst', {
        detail: { strength: 'harsh' }
      }));
    }

    function finish(): void {
      if (!active) return;
      active = false;
      window.clearTimeout(finishTimer);
      window.clearTimeout(disruptionTimer);
      window.clearTimeout(voidTimer);
      clearDisplaced();
      for (const id of eyeBurstTimers) window.clearTimeout(id);
      eyeBurstTimers.length = 0;
      document.body.classList.remove('resistance-watched');
      veil?.classList.remove('resistance-eye-noise--camera');
      veil?.classList.remove('resistance-eye-noise--active');
      veil?.classList.remove('resistance-eye-noise--eye-visible');
      document.body.style.removeProperty('--eye-instability');
      veil?.style.removeProperty('--eye-instability');
      for (const name of ['--void-scale-x', '--void-scale-y', '--void-offset-x',
        '--void-offset-y', '--void-opacity']) veil?.style.removeProperty(name);
      if (veil) veil.hidden = true;
    }

    function startEyes(): void {
      if (!veil || active || document.visibilityState !== 'visible' ||
        document.documentElement.classList.contains('weab-quarantined') ||
        document.documentElement.dataset.weabMorseRunning === '1') return;
      active = true;
      veil.hidden = false;
      veil.classList.add('resistance-eye-noise--active');
      document.body.classList.add('resistance-watched');
      veil.style.setProperty('--eye-instability', '1');
      document.body.style.setProperty('--eye-instability', '1');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        growVoid();
        const compact = window.matchMedia('(max-width: 760px), (pointer: coarse)').matches;
        const candidates = [...document.querySelectorAll<HTMLElement>(
          'body > header, body > main > *, body > main h1, body > main h2, body > main img, body > footer'
        )].filter(element => {
          const box = element.getBoundingClientRect();
          return box.width > 0 && box.height > 0 && box.bottom > 0 &&
            box.top < window.innerHeight;
        }).slice(0, 24);
        disrupt(candidates, compact);
      }
      // Ljudfilen börjar med ögat, inte först vid nästa öppningspuls.
      window.dispatchEvent(new CustomEvent('weab:spirit-sustain', {
        detail: { strength: 'harsh', durationMs: resistanceSignal.eyesDurationMs + 1_700 }
      }));
      // Tre ljud-/bildbrott medan ögat förblir vidöppet, inga nya öppningsfaser.
      for (const phase of [.15, .43, .75]) {
        eyeBurstTimers.push(window.setTimeout(() => {
          if (active && document.visibilityState === 'visible') eyeTransmission();
        }, resistanceSignal.eyesDurationMs * phase));
      }
      finishTimer = window.setTimeout(finish, resistanceSignal.eyesDurationMs);
    }

    function startCameraEye(): void {
      if (!veil || active || document.visibilityState !== 'visible' ||
        !document.documentElement.classList.contains('weab-quarantined')) return;
      active = true;
      veil.classList.add('resistance-eye-noise--camera');
      veil.hidden = false;
      eyeTransmission();
      finishTimer = window.setTimeout(finish, cameraEncounter.responseMs);
    }

    window.addEventListener('weab:resistance-eyes-start', startEyes);
    window.addEventListener('weab:camera-eye-start', startCameraEye);
    window.addEventListener('weab:spirit-presence', (event: Event) => {
      if ((event as CustomEvent<{active: boolean}>).detail?.active === false) finish();
    });
    if (preview) window.setTimeout(startEyes, 1_000);
    window.addEventListener('pagehide', finish);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) finish();
    });
  }
</script>

<style>
  .resistance-eye-noise[hidden] { display: none; }
  .resistance-eye-noise {
    position: fixed;
    inset: 0;
    z-index: 2147483645;
    pointer-events: none;
    isolation: isolate;
    background: repeating-linear-gradient(0deg,
      rgb(3 4 7 / .14) 0 5px, rgb(140 25 42 / .19) 6px 8px, transparent 9px 15px);
  }
  .resistance-eye-noise::before,
  .resistance-eye-noise::after {
    content: '';
    position: absolute;
    left: -5%;
    width: 110%;
    pointer-events: none;
    opacity: calc(.26 + var(--eye-instability, 0) * .74);
  }
  .resistance-eye-noise::before {
    top: var(--tear-one-y, 24%);
    height: clamp(28px, 7vh, 82px);
    background: repeating-linear-gradient(90deg,
      rgb(120 15 39 / .56) 0 19px, rgb(21 140 156 / .42) 20px 29px,
      transparent 30px 43px);
    box-shadow: 0 1px 0 rgb(160 20 36 / .22), 0 -2px 0 rgb(40 180 196 / .19);
    transform: translateX(var(--tear-one-x, 0px));
  }
  .resistance-eye-noise::after {
    top: var(--tear-two-y, 65%);
    height: clamp(16px, 4vh, 56px);
    background: repeating-linear-gradient(90deg,
      rgb(25 120 135 / .52) 0 6px, transparent 6px 13px,
      rgb(142 18 42 / .46) 13px 19px);
    transform: translateX(var(--tear-two-x, 0px));
  }
  .resistance-eye__void {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: 50%;
    width: clamp(300px, 52vw, 700px);
    height: clamp(200px, 33vw, 440px);
    border-radius: 50% 48% 52% 49% / 53% 47% 53% 47%;
    background: #020204;
    box-shadow: 0 0 0 12px rgb(5 4 9 / .6), 0 0 72px 26px #020204;
    transform: translate(-50%, -50%) scale(.02);
    opacity: 0;
  }
  .resistance-eye-noise--active .resistance-eye__void {
    opacity: var(--void-opacity, 0);
    transform: translate(calc(-50% + var(--void-offset-x, 0px)),
      calc(-50% + var(--void-offset-y, 0px)))
      scale(var(--void-scale-x, .02), var(--void-scale-y, .02));
  }
  .resistance-eye-noise--camera .resistance-eye__void { display: none; }
  .resistance-eye {
    position: absolute;
    z-index: 5;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(144px, 27vw, 232px);
    height: clamp(84px, 16vw, 142px);
    overflow: hidden;
    border: 1px solid #251014;
    border-radius: 51% 49% 52% 48% / 65% 59% 41% 35%;
    background: radial-gradient(ellipse at 49% 48%,
      #b0a5a7 0 26%, #85777c 48%, #56323b 76%, #160c11 100%);
    box-shadow: inset 0 20px 20px #110a0cdb, inset 0 -15px 17px #1d0a0fda,
      0 0 11px rgb(123 25 43 / .24), 0 0 42px rgb(94 9 30 / .18);
    transform: translate(-50%, -50%) scaleY(1);
    opacity: 1;
  }
  .resistance-eye-noise--active .resistance-eye {
    opacity: 0;
  }
  .resistance-eye-noise--eye-visible .resistance-eye {
    opacity: 1;
  }
  .resistance-eye::before,
  .resistance-eye::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }
  .resistance-eye::before {
    box-shadow: inset 0 15px 11px rgb(18 8 11 / .85),
      inset 0 -10px 9px rgb(19 7 11 / .85);
    z-index: 2;
  }
  .resistance-eye::after {
    background: url('/images/arg-eye-grain.png') repeat,
      radial-gradient(circle at 45% 37%, rgb(236 226 219 / .35) 0 2px, transparent 4px);
    background-size: 128px 128px, auto;
    opacity: .7;
    mix-blend-mode: soft-light;
    z-index: 3;
  }
  .resistance-eye__iris {
    width: 59%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 48% 48%,
      #020204 0 38%, #10060a 41%, #350b16 46%,
      #83303b 52%, #311018 64%, #151014 76%);
    box-shadow: 0 0 8px 3px rgb(10 4 7 / .78),
      0 0 18px rgb(112 20 38 / .34);
  }
  .resistance-eye-noise--camera .resistance-eye {
    width: clamp(220px, 42vw, 400px);
    height: clamp(126px, 26vw, 240px);
    transform: translate(-50%, -50%) scaleY(1);
    opacity: 1;
  }
  :global(body.resistance-watched > header),
  :global(body.resistance-watched > main),
  :global(body.resistance-watched > footer) {
    text-shadow: 7px 0 rgb(205 19 48 / .82), -7px 0 rgb(20 169 186 / .78);
  }
  :global(body.resistance-watched .resistance-displaced) {
    translate: var(--eye-jolt-x, 0px) var(--eye-jolt-y, 0px);
    rotate: var(--eye-tilt, 0deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .resistance-eye-noise--active .resistance-eye__void {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    .resistance-eye-noise--active .resistance-eye {
      transform: translate(-50%, -50%) scaleY(1);
      opacity: 1;
    }
  }
</style>
