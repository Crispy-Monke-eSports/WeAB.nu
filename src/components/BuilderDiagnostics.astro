---
/**
 * ARG: fiktiva webbbyggar-/runtime-diagnoser för F12 och Morse-skärmen.
 * Ändrar inga verkliga byggsteg och fångar inte riktiga JavaScript-fel.
 * Flödet är kontinuerligt men begränsar antalet synliga DOM-noder.
 */
---
<aside class="builder-diagnostics" data-builder-diagnostics hidden aria-hidden="true">
  <div class="builder-diagnostics__heading">
    <span class="builder-diagnostics__source">WEAB / site-builder</span>
    <span class="builder-diagnostics__status">runtime diagnostics</span>
  </div>
  <div class="builder-diagnostics__lines" data-builder-diagnostics-lines></div>
</aside>

<script>
  import {
    builderDiagnosticConfig,
    nextBuilderDiagnostic,
    stageAtProgress,
    formatBuilderDiagnostic,
    type DiagnosticSeverity
  } from '../data/builderDiagnostics.ts';

  const panel = document.querySelector<HTMLElement>('[data-builder-diagnostics]');
  const lines = panel?.querySelector<HTMLElement>('[data-builder-diagnostics-lines]');

  if (panel && lines) {
    let sequence = 0;
    let ticker = 0;
    let active = false;
    let phaseStarted = 0;
    let morseLength = 95_000;
    const history: Array<{ line: string; severity: DiagnosticSeverity }> = [];

    function delay(min: number, max: number): number {
      return Math.floor(min + Math.random() * (max - min));
    }

    function appendLine(line: string, severity: DiagnosticSeverity): void {
      if (!lines) return;
      const item = document.createElement('div');
      item.className = 'builder-diagnostics__entry builder-diagnostics__entry--' + severity;
      item.textContent = line;
      lines.append(item);
      // Långt växande flöde under Morse. Håll minnesanvändningen begränsad
      // under långa besök och låt de nyaste problemen ständigt synas.
      while (lines.childElementCount > builderDiagnosticConfig.maxVisibleLines) {
        lines.firstElementChild?.remove();
      }
      lines.scrollTop = lines.scrollHeight;
    }

    function emit(): void {
      if (document.visibilityState !== 'visible') {
        scheduleNext();
        return;
      }

      const elapsed = active ? performance.now() - phaseStarted : 0;
      const stage = active ? stageAtProgress(elapsed / morseLength) : 'background';
      const item = nextBuilderDiagnostic(stage, sequence++);
      const line = formatBuilderDiagnostic(item, sequence, new Date());

      // F12 visar samma text som den fiktiva byggkonsolen på sidan.
      // console.error/warn är avsiktligt och kastar inga riktiga exceptions.
      if (item.severity === 'error' || item.severity === 'critical') {
        console.error(line);
      } else if (item.severity === 'warn') {
        console.warn(line);
      } else {
        console.info(line);
      }

      if (active) {
        appendLine(line, item.severity);
      } else {
        history.push({ line, severity: item.severity });
        if (history.length > builderDiagnosticConfig.backgroundHistory) history.shift();
      }
      scheduleNext();
    }

    function scheduleNext(): void {
      window.clearTimeout(ticker);
      ticker = window.setTimeout(emit, active
        ? delay(builderDiagnosticConfig.signalMinMs, builderDiagnosticConfig.signalMaxMs)
        : delay(builderDiagnosticConfig.backgroundMinMs, builderDiagnosticConfig.backgroundMaxMs));
    }

    function startMorseDiagnostics(event: Event): void {
      if (active || !panel || !lines) return;
      active = true;
      phaseStarted = performance.now();
      const durationMs = (event as CustomEvent<{ durationMs?: number }>).detail?.durationMs;
      if (typeof durationMs === 'number' && Number.isFinite(durationMs) && durationMs > 1_000) {
        morseLength = durationMs;
      }

      panel.hidden = false;
      for (const entry of history) appendLine(entry.line, entry.severity);
      history.length = 0;

      window.clearTimeout(ticker);
      emit();
    }

    window.addEventListener('weab:builder-diagnostics-start', startMorseDiagnostics);
    scheduleNext(); // Konstant men lågmält F12-flöde även före Morse.
    window.addEventListener('pagehide', () => window.clearTimeout(ticker));
  }
</script>

<style>
  .builder-diagnostics[hidden] { display: none; }
  .builder-diagnostics {
    position: fixed;
    right: clamp(8px, 2.4vw, 28px);
    bottom: clamp(8px, 2.4vh, 24px);
    z-index: 10012;
    width: min(690px, calc(100vw - 16px));
    max-height: min(57vh, 530px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    pointer-events: none;
    color: #c7d5d6;
    font-family: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace;
    font-size: clamp(10px, 1.2vw, 12px);
    line-height: 1.42;
    background: rgb(3 10 15 / .87);
    border: 1px solid rgb(100 145 154 / .37);
    border-left: 2px solid rgb(126 179 183 / .7);
    box-shadow: 0 8px 40px rgb(0 0 0 / .68),
      inset 0 0 30px rgb(13 35 44 / .3);
    text-align: left;
    contain: layout style;
  }
  .builder-diagnostics::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom,
      transparent 0 3px, rgb(111 171 180 / .025) 4px,
      transparent 5px 8px);
  }
  .builder-diagnostics__heading {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 12px;
    background: rgb(30 50 59 / .82);
    border-bottom: 1px solid rgb(104 157 167 / .22);
    font-size: 10px;
    letter-spacing: .045em;
  }
  .builder-diagnostics__source {
    color: #d0e1e3;
    font-weight: 700;
  }
  .builder-diagnostics__status { color: #ddad96; }
  .builder-diagnostics__lines {
    overflow: hidden auto;
    min-height: 18px;
    max-height: min(51vh, 470px);
    scrollbar-width: none;
    padding: 7px 11px 12px;
    overflow-wrap: anywhere;
  }
  .builder-diagnostics__entry {
    padding: 2px 0;
    white-space: pre-wrap;
    border-bottom: 1px solid rgb(111 151 158 / .07);
  }
  .builder-diagnostics__entry--info { color: #83a8ae; }
  .builder-diagnostics__entry--warn { color: #c9bd8e; }
  .builder-diagnostics__entry--error { color: #e89e92; }
  .builder-diagnostics__entry--critical {
    color: #ff9aab;
    background: rgb(113 21 36 / .19);
  }
  @media (max-width: 650px) {
    .builder-diagnostics {
      max-height: 43vh;
      font-size: 10px;
    }
    .builder-diagnostics__lines { max-height: 37vh; }
    .builder-diagnostics__heading { padding: 7px 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .builder-diagnostics,
    .builder-diagnostics__entry { animation: none; transition: none; }
  }
</style>