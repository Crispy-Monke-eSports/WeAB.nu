{
  "name": "weab-group-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "validate:content": "node --experimental-strip-types scripts/validate-content.mjs && npm run test:resistance && npm run logos:check",
    "test:resistance": "node --experimental-strip-types --test tests/resistance-signal.test.mjs tests/resistance-morse.test.mjs",
    "check": "npm run validate:content && astro check && npm run build && node scripts/validate-site.mjs",
    "logos:generate": "node --experimental-strip-types scripts/generate-logos.mjs",
    "logos:check": "node --experimental-strip-types scripts/generate-logos.mjs --check"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
